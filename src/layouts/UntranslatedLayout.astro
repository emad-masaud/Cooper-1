---
import Layout from '~/layouts/Layout.astro';

interface Props {
	title?: string;
	description?: string;
    image?: string;
    article?: boolean;
    noindex?: boolean;
    nofollow?: boolean;
    availableLangs?: string[];
}

const { availableLangs = [], ...props } = Astro.props;
---

<Layout {...props} availableLangs={availableLangs}>
    <slot name="head" slot="head" />
    <slot />
</Layout>
