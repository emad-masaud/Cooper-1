---
import UntranslatedLayout from "./UntranslatedLayout.astro";
import { getCollection } from "astro:content";
import { clsx } from "clsx";
import TableOfContents from "~/components/blog/TableOfContents.astro";
import type { MarkdownHeading } from "astro";
import { defaultLang } from "~/i18n/ui";
import ScrollProgress from "~/components/layout/ScrollProgress.astro";
import MobileDocsMenu from "~/components/islands/MobileDocsMenu";
import Schema from "~/components/layout/Schema.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  nofollow?: boolean;
  headings?: MarkdownHeading[];
  body?: string;
}

const {
  title,
  description,
  noindex,
  nofollow,
  headings = [],
  body = "",
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedCurrentPath =
  currentPath.endsWith("/") && currentPath.length > 1
    ? currentPath.slice(0, -1)
    : currentPath;
const [, maybeLang] = normalizedCurrentPath.split("/");
const lang = maybeLang === "ar" || maybeLang === "en" ? maybeLang : defaultLang;
const docsBasePath = `/${lang}/docs`;

const allDocs = await getCollection("docs");
const docs = allDocs
  .filter((doc) => doc.id.startsWith(`${lang}/`))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

// Helper to get clean slug from ID
const getSlug = (id: string) => {
  return id
    .split("/")
    .slice(1)
    .join("/")
    .replace(/\.[^/.]+$/, "");
};

// Group docs by folder
const groupedDocs = docs.reduce(
  (acc, doc) => {
    const slug = getSlug(doc.id);
    const parts = slug.split("/");
    const section = parts.length > 1 ? parts[0] : "root";
    const key = section as string;
    if (!acc[key]) acc[key] = [];
    acc[key].push(doc);
    return acc;
  },
  {} as Record<string, typeof docs>,
);

// Sort sections: root first, then by defined order, then alphabetical
const SECTION_ORDER = [
  "getting-started",
  "selling",
  "buying",
  "trust-safety",
  "root",
];
const sections = Object.keys(groupedDocs).sort((a, b) => {
  const indexA = SECTION_ORDER.indexOf(a);
  const indexB = SECTION_ORDER.indexOf(b);

  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return a.localeCompare(b);
});

// Flatten docs for next/prev navigation
const flattenedDocs = sections.flatMap((section) => groupedDocs[section]);

const currentIndex = flattenedDocs.findIndex((doc) => {
  const docPath = `${docsBasePath}/${getSlug(doc.id)}`;
  return normalizedCurrentPath === docPath;
});

const prevDoc = currentIndex > 0 ? flattenedDocs[currentIndex - 1] : null;
const nextDoc =
  currentIndex < flattenedDocs.length - 1
    ? flattenedDocs[currentIndex + 1]
    : null;

const isAr = lang === "ar";

// Custom styles for specific sections with localized labels
const SECTION_CUSTOMIZATION: Record<
  string,
  { icon: string; color: string; label?: string; labelAr?: string }
> = {
  "getting-started": {
    icon: "🚀",
    color: "text-primary",
    label: "Getting Started",
    labelAr: "البداية السريعة",
  },
  selling: {
    icon: "🏪",
    color: "text-green-500",
    label: "Selling Guide",
    labelAr: "دليل البائع",
  },
  buying: {
    icon: "🛍️",
    color: "text-blue-500",
    label: "Buying Guide",
    labelAr: "دليل المشتري",
  },
  "trust-safety": {
    icon: "🛡️",
    color: "text-purple-500",
    label: "Trust & Safety",
    labelAr: "الثقة والأمان",
  },
};
---

<UntranslatedLayout
  title={title}
  description={description}
  noindex={noindex}
  nofollow={nofollow}
  availableLangs={["ar", "en"]}
>
  <Schema
    item={{
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: title,
      description: description,
      inLanguage: lang,
      publisher: {
        "@type": "Organization",
        name: "MeaMart",
        url: Astro.site ? Astro.site.toString() : "https://meamart.com",
      },
    }}
  />
  <ScrollProgress />
  <div class="max-w-360 mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="flex w-full lg:grid lg:grid-cols-[280px_1fr_240px] gap-10 pt-32 pb-24"
    >
      {/* Sidebar Navigation */}
      <aside
        class="hidden lg:block fixed inset-y-0 start-0 z-20 w-72 overflow-y-auto border-e border-foreground/5 bg-background px-6 pb-4 pt-32 lg:static lg:w-auto lg:border-e-0 lg:bg-transparent lg:px-0 lg:pb-0 lg:pt-0"
      >
        <div class="sticky top-24 space-y-8">
          <nav class="space-y-1" aria-label="Documentation Sidebar">
            {
              sections.map((section) => {
                const sectionDocs = groupedDocs[section];

                if (section === "root") {
                  return (
                    <ul class="space-y-1 mb-8 list-none p-0">
                      {sectionDocs.map((doc) => {
                        const docPath = `${docsBasePath}/${getSlug(doc.id)}`;
                        const isExact = normalizedCurrentPath === docPath;
                        return (
                          <li>
                            <a
                              href={docPath}
                              class={clsx(
                                "group flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-all",
                                isExact
                                  ? "bg-primary/10 text-primary shadow-sm ring-1 ring-primary/20"
                                  : "text-foreground/70 hover:text-foreground hover:bg-foreground/5",
                              )}
                            >
                              <span
                                class={clsx(
                                  "w-1.5 h-1.5 rounded-full transition-all",
                                  isExact
                                    ? "bg-primary scale-110"
                                    : "bg-foreground/20 group-hover:bg-foreground/40",
                                )}
                              />
                              {doc.data.title}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  );
                }

                const customization = SECTION_CUSTOMIZATION[section] || {};
                const rawTitle =
                  section.charAt(0).toUpperCase() +
                  section.slice(1).replace(/-/g, " ");
                const sectionTitle = isAr
                  ? customization.labelAr || rawTitle
                  : customization.label || rawTitle;
                const sectionColor =
                  customization.color || "text-foreground/70";
                const isOpen = sectionDocs.some(
                  (doc) =>
                    normalizedCurrentPath ===
                    `${docsBasePath}/${getSlug(doc.id)}`,
                );

                return (
                  <details class="group/section" open={isOpen}>
                    <summary class="list-none cursor-pointer outline-none">
                      <div
                        class={clsx(
                          "flex items-center justify-between px-3 py-2 text-sm font-semibold rounded-lg hover:bg-foreground/5 transition-colors group",
                          sectionColor,
                        )}
                      >
                        <div class="flex items-center gap-2">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity"
                          >
                            <path d="m6 9 6 6 6-6" />
                          </svg>
                          {customization.icon && (
                            <span class="text-base leading-none shrink-0">
                              {customization.icon}
                            </span>
                          )}
                          <span class="tracking-wide">{sectionTitle}</span>
                        </div>
                        <span class="text-[10px] bg-foreground/5 px-1.5 py-0.5 rounded-full opacity-50 group-hover:opacity-100">
                          {sectionDocs.length}
                        </span>
                      </div>
                    </summary>
                    <div class="mt-1 ms-4 ps-4 border-s border-foreground/10 space-y-1 relative">
                      {/* Vertical guide line that looks like a tree branch */}
                      <div class="absolute start-0 top-0 bottom-4 w-px bg-foreground/10" />

                      <ul class="list-none p-0 m-0 space-y-1">
                        {sectionDocs.map((doc, idx) => {
                          const docPath = `${docsBasePath}/${getSlug(doc.id)}`;
                          const isExact = normalizedCurrentPath === docPath;
                          return (
                            <li class="relative">
                              {/* Horizontal branch marker */}
                              <div class="absolute -start-4 top-1/2 -translate-y-1/2 w-3 h-px bg-foreground/10" />

                              <a
                                href={docPath}
                                class={clsx(
                                  "group flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-all",
                                  isExact
                                    ? "bg-primary/5 text-primary font-semibold translate-x-1"
                                    : "text-foreground/60 hover:text-foreground hover:bg-foreground/5",
                                )}
                              >
                                {isExact && (
                                  <div class="w-1 h-1 rounded-full bg-primary" />
                                )}
                                <span class="truncate">{doc.data.title}</span>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </details>
                );
              })
            }
          </nav>
        </div>
      </aside>

      {/* Main Content */}
      <main class="min-w-0 flex-1" data-pagefind-ignore>
        {/* Breadcrumbs & Mobile Menu */}
        <div class="mb-6 flex items-center justify-between gap-4">
          <div class="flex items-center gap-2 text-sm text-muted-foreground">
            <a
              href={docsBasePath}
              class="hover:text-foreground transition-colors"
              >{isAr ? "المستندات" : "Docs"}</a
            >
            <span class="text-foreground/20">/</span>
            <span class="text-foreground">{title}</span>
          </div>

          <MobileDocsMenu
            client:load
            sections={sections}
            groupedDocs={groupedDocs}
            currentPath={Astro.url.pathname}
            lang={lang}
          />
        </div>

        {/* Stripe-style Action Bar */}
        <div
          class="flex flex-wrap items-center gap-2 mb-8 pb-4 border-b border-foreground/10"
          id="docs-action-bar"
        >
          <button
            id="btn-copy-llm"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold bg-primary/10 text-primary hover:bg-primary/20 border border-primary/20 transition-all cursor-pointer shadow-xs focus:outline-hidden"
            data-title={title}
            data-description={description}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-sparkles"
              ><path
                d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"
              ></path><path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5Z"
              ></path><path
                d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1Z"
              ></path></svg
            >
            <span
              >{
                lang === "ar" ? "نسخ للذكاء الاصطناعي (LLM)" : "Copy for LLM"
              }</span
            >
          </button>

          <button
            id="btn-copy-md"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium bg-foreground/5 text-foreground/80 hover:text-foreground hover:bg-foreground/10 border border-foreground/10 transition-all cursor-pointer focus:outline-hidden"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-file-text"
              ><path
                d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"
              ></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"
              ></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg
            >
            <span>{lang === "ar" ? "نسخ كـ Markdown" : "Copy as Markdown"}</span
            >
          </button>

          <a
            href="/llms.txt"
            target="_blank"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium bg-foreground/5 text-foreground/80 hover:text-foreground hover:bg-foreground/10 border border-foreground/10 transition-all focus:outline-hidden"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-code-2"
              ><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"
              ></path><path d="m14.5 4-5 16"></path></svg
            >
            <span>llms.txt</span>
          </a>
        </div>

        <textarea
          id="raw-markdown-content"
          class="hidden"
          aria-hidden="true"
          readonly>{body}</textarea
        >

        <div
          class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:scroll-mt-24 prose-a:text-primary hover:prose-a:text-primary/80 dark:prose-invert text-foreground prose-headings:text-foreground prose-p:text-foreground/80 prose-strong:text-foreground prose-code:text-primary prose-pre:border prose-pre:border-white/10 prose-pre:bg-black/80"
        >
          <slot />
        </div>
        {/* Next/Prev Navigation */}
        <hr class="my-10 border-foreground/10" />
        <div class="flex flex-col sm:flex-row gap-4 justify-between">
          {
            prevDoc ? (
              <a
                href={`${docsBasePath}/${getSlug(prevDoc.id)}`}
                class="group flex flex-col gap-1 p-4 rounded-xl border border-foreground/10 hover:border-primary/30 hover:bg-primary/5 transition-all text-start"
              >
                <span class="text-xs text-muted-foreground font-medium group-hover:text-primary/70">
                  {lang === 'ar' ? 'السابق' : 'Previous'}
                </span>
                <span class="text-foreground font-bold group-hover:text-primary">
                  {prevDoc.data.title}
                </span>
              </a>
            ) : (
              <div />
            )
          }

          {
            nextDoc && (
              <a
                href={`${docsBasePath}/${getSlug(nextDoc.id)}`}
                class="group flex flex-col gap-1 p-4 rounded-xl border border-foreground/10 hover:border-primary/30 hover:bg-primary/5 transition-all text-end items-end"
              >
                <span class="text-xs text-muted-foreground font-medium group-hover:text-primary/70">
                  {lang === 'ar' ? 'التالي' : 'Next'}
                </span>
                <span class="text-foreground font-bold group-hover:text-primary">
                  {nextDoc.data.title}
                </span>
              </a>
            )
          }
        </div>
      </main>

      {/* Right Sidebar: Table of Contents */}
      <aside class="hidden xl:block min-w-[240px]">
        {headings.length > 0 && <TableOfContents headings={headings} />}
      </aside>
    </div>
  </div>
</UntranslatedLayout>

<style is:global>
  /* Chevron rotation for tree folders */
  details summary svg {
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
    transform: rotate(-90deg);
  }
  :global([dir="rtl"]) details summary svg {
    transform: rotate(90deg);
  }
  details[open] summary svg,
  :global([dir="rtl"]) details[open] summary svg {
    transform: rotate(0deg);
    opacity: 1;
  }

  /* Hover effect for branch guides */
  details summary:hover ~ div {
    border-inline-start-color: var(--color-primary-alpha-20);
  }

  /* Custom Alert Boxes */
  .custom-alert-box {
    border: 1px solid !important;
    border-inline-start-width: 1px !important;
    border-left-width: 1px !important;
    border-right-width: 1px !important;
    padding: 1rem 1.25rem !important;
    margin: 1.5rem 0 !important;
    border-radius: 0.75rem !important;
    font-style: normal !important;
    font-weight: 500 !important;
    quotes: none !important;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }
  .custom-alert-box::before,
  .custom-alert-box::after {
    content: none !important;
    display: none !important;
  }
  .custom-alert-box p {
    margin: 0 !important;
    font-size: 0.875rem !important;
    line-height: 1.5 !important;
    color: var(--color-zinc-700) !important;
    font-style: normal !important;
  }
  :global(.dark) .custom-alert-box p {
    color: var(--color-zinc-300) !important;
  }

  /* Tip box */
  .alert-tip {
    border-color: rgba(16, 185, 129, 0.25) !important;
    background-color: rgba(16, 185, 129, 0.05) !important;
  }
  .alert-tip .alert-header {
    color: #047857 !important;
  }
  :global(.dark) .alert-tip .alert-header {
    color: #34d399 !important;
  }

  /* Important box */
  .alert-important {
    border-color: rgba(59, 130, 246, 0.3) !important;
    background-color: rgba(59, 130, 246, 0.08) !important;
  }
  .alert-important .alert-header {
    color: #1d4ed8 !important;
  }
  :global(.dark) .alert-important .alert-header {
    color: #60a5fa !important;
  }

  /* Warning box */
  .alert-warning {
    border-color: rgba(245, 158, 11, 0.3) !important;
    background-color: rgba(245, 158, 11, 0.08) !important;
  }
  .alert-warning .alert-header {
    color: #b45309 !important;
  }
  :global(.dark) .alert-warning .alert-header {
    color: #fbbf24 !important;
  }

  /* Caution box */
  .alert-caution {
    border-color: rgba(244, 63, 94, 0.3) !important;
    background-color: rgba(244, 63, 94, 0.08) !important;
  }
  .alert-caution .alert-header {
    color: #be123c !important;
  }
  :global(.dark) .alert-caution .alert-header {
    color: #fb7185 !important;
  }

  /* Note box */
  .alert-note {
    border-color: rgba(113, 113, 122, 0.3) !important;
    background-color: rgba(113, 113, 122, 0.08) !important;
  }
  .alert-note .alert-header {
    color: #3f3f46 !important;
  }
  :global(.dark) .alert-note .alert-header {
    color: #a1a1aa !important;
  }

  /* Style pre blocks inside docs prose to look like the ad description */
  .prose pre {
    background-color: rgba(255, 255, 255, 0.4) !important;
    border: 1px solid rgba(228, 228, 240, 0.5) !important;
    border-radius: 1.5rem !important; /* 24px */
    padding: 1.5rem !important;
    font-family: system-ui, -apple-system, sans-serif !important; /* normal font! */
    font-size: 0.95rem !important;
    line-height: 1.625 !important;
    color: #4b5563 !important; /* zinc-600 */
    white-space: pre-wrap !important;
    word-break: break-word !important;
    backdrop-filter: blur(12px);
  }
  
  :global(.dark) .prose pre {
    background-color: rgba(24, 24, 37, 0.4) !important;
    border-color: rgba(63, 63, 70, 0.5) !important;
    color: #d1d5db !important; /* zinc-300 */
  }

  .prose pre code {
    font-family: system-ui, -apple-system, sans-serif !important;
    color: inherit !important;
    font-size: inherit !important;
    background: transparent !important;
    padding: 0 !important;
    border-radius: 0 !important;
    font-weight: normal !important;
  }
  
  .prose pre code span {
    color: inherit !important;
    background: transparent !important;
    font-family: system-ui, -apple-system, sans-serif !important;
    font-weight: normal !important;
    font-style: normal !important;
  }
</style>

<script is:inline>
  function setupDocsLayout() {
    // 1. Setup Action Bar Copy Buttons
    const copyLlmBtn = document.getElementById("btn-copy-llm");
    const copyMdBtn = document.getElementById("btn-copy-md");
    const textarea = document.getElementById("raw-markdown-content");

    function showToast(message) {
      const existingToast = document.querySelector(".custom-micro-toast");
      if (existingToast) existingToast.remove();

      const toast = document.createElement("div");
      toast.className =
        "custom-micro-toast fixed bottom-6 left-1/2 -translate-x-1/2 px-4 py-2 bg-zinc-950/90 text-white text-xs font-semibold rounded-xl shadow-lg border border-white/10 flex items-center gap-2 z-50 backdrop-blur-md transition-all duration-300 transform translate-y-4 opacity-0";
      toast.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span>${message}</span>
            `;
      document.body.appendChild(toast);

      toast.offsetHeight;
      toast.classList.remove("translate-y-4", "opacity-0");

      setTimeout(() => {
        toast.classList.add("translate-y-4", "opacity-0");
        setTimeout(() => toast.remove(), 300);
      }, 2500);
    }

    if (copyLlmBtn && copyMdBtn && textarea) {
      copyLlmBtn.onclick = function () {
        const rawContent = textarea.value;
        const pageTitle = copyLlmBtn.getAttribute("data-title");
        const pageDesc = copyLlmBtn.getAttribute("data-description");
        const isAr = document.documentElement.dir === "rtl";

        const prompt = `You are an AI Assistant / LLM agent helping a MeaMart (ميمارت) user.
Below is the official documentation for the current page:

---
Title: ${pageTitle}
Description: ${pageDesc}
---

${rawContent}

---
Please read the documentation above carefully. Act as the AI assistant/agent to guide the user based on these instructions.`;

        navigator.clipboard
          .writeText(prompt)
          .then(() => {
            showToast(
              isAr
                ? "تم نسخ التوجيه والتعليمات للذكاء الاصطناعي!"
                : "Copied prompt and instructions for LLM!",
            );
          })
          .catch((err) => {
            console.error("Failed to copy text: ", err);
          });
      };

      copyMdBtn.onclick = function () {
        const rawContent = textarea.value;
        const isAr = document.documentElement.dir === "rtl";

        navigator.clipboard
          .writeText(rawContent)
          .then(() => {
            showToast(
              isAr
                ? "تم نسخ كود المارك داون للمستند!"
                : "Copied raw Markdown to clipboard!",
            );
          })
          .catch((err) => {
            console.error("Failed to copy Markdown: ", err);
          });
      };
    }

    // 2. Format GitHub style markdown alerts (e.g. > [!TIP])
    const blockquotes = document.querySelectorAll(".prose blockquote");
    blockquotes.forEach((quote) => {
      const firstParagraph = quote.querySelector("p");
      if (!firstParagraph) return;

      const text = firstParagraph.innerHTML;
      const alertRegex = /^\[!(TIP|IMPORTANT|WARNING|CAUTION|NOTE)\]/i;
      const match = text.trim().match(alertRegex);

      if (match) {
        const type = match[1].toUpperCase();
        firstParagraph.innerHTML = text
          .replace(alertRegex, "")
          .trim()
          .replace(/^<br\s*\/?>/i, "")
          .trim();

        quote.className = `custom-alert-box alert-${type.toLowerCase()}`;

        let icon = "";
        let title = "";
        const isAr = document.documentElement.dir === "rtl";

        if (type === "TIP") {
          icon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-emerald-600 dark:text-emerald-400"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"/><path d="m5 3 1 2.5L8.5 6 6 7 5 9.5 4 7 1.5 6 4 5Z"/><path d="m19 17 1 2.5 2.5.5-2.5 1-1 2.5-1-2.5-2.5-1 2.5-1Z"/></svg>`;
          title = isAr ? "فكرة / نصيحة" : "Tip";
        } else if (type === "IMPORTANT") {
          icon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-blue-600 dark:text-blue-400"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`;
          title = isAr ? "هام جداً" : "Important";
        } else if (type === "WARNING") {
          icon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-amber-600 dark:text-amber-400"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
          title = isAr ? "تحذير" : "Warning";
        } else if (type === "CAUTION") {
          icon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-rose-600 dark:text-rose-400"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
          title = isAr ? "تنبيه هام" : "Caution";
        } else {
          icon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-zinc-600 dark:text-zinc-400"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`;
          title = isAr ? "ملاحظة" : "Note";
        }

        const header = document.createElement("div");
        header.className =
          "alert-header flex items-center gap-2 mb-2 font-bold text-xs uppercase tracking-wider not-italic";
        header.innerHTML = `${icon} <span>${title}</span>`;
        quote.insertBefore(header, firstParagraph);
      }
    });
  }

  setupDocsLayout();
  document.addEventListener("astro:page-load", setupDocsLayout);
</script>
