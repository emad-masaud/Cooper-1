---
export const prerender = false;
import Layout from '~/layouts/Layout.astro';
import { defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { erpnext } from '~/lib/erpnext/client';
import Section from '~/components/layout/Section.astro';
import { MapPin, Phone, Tag, Calendar, User, Eye, Share2 } from 'lucide-react';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';

const { lang = defaultLang, slug } = Astro.params;
const t = useTranslations(lang);

if (!slug) {
  return Astro.redirect(`/${lang}/listings`);
}

let listing = null;
let error = null;

try {
  listing = await erpnext.getListingDetail(slug);
} catch (e) {
  error = "Listing not found or unavailable.";
  console.error(e);
}

const erpnextUrl = import.meta.env.ERPNEXT_URL || 'http://139.59.111.91:8080';
const fallbackImage = 'https://placehold.co/1200x800?text=No+Image';

const imageUrl = listing?.cover_image 
  ? (listing.cover_image.startsWith('http') ? listing.cover_image : `${erpnextUrl}${listing.cover_image}`) 
  : fallbackImage;

const contactNumber = listing?.whatsapp_number || listing?.advertiser_summary?.whatsapp_number;
---

<Layout title={listing ? `${listing.title} | MeaMart` : 'Not Found | MeaMart'} description={listing?.summary || 'Listing not found'}>
  <div class="pt-32 pb-20">
    <Section>
      {error || !listing ? (
        <div class="text-center py-32">
          <h1 class="text-4xl font-bold mb-4">Not Found</h1>
          <p class="text-muted-foreground mb-8">{error}</p>
          <Button href={`/${lang}/listings`}>Back to Listings</Button>
        </div>
      ) : (
        <div class="max-w-5xl mx-auto">
          {/* Header */}
          <div class="mb-8">
            <div class="flex items-center gap-3 mb-4">
              {listing.category && (
                <Badge variant="outline" class="bg-primary/10 text-primary border-primary/20">
                  {listing.category}
                </Badge>
              )}
              {listing.listing_type && (
                <Badge variant="outline" class="bg-muted text-muted-foreground border-border">
                  {listing.listing_type}
                </Badge>
              )}
              {listing.is_featured === 1 && (
                <Badge variant="default" class="bg-amber-500 text-white">
                  {t['nav.featured']}
                </Badge>
              )}
            </div>
            <h1 class="text-3xl md:text-5xl font-bold mb-4">{listing.title}</h1>
            
            <div class="flex flex-wrap items-center gap-6 text-sm text-muted-foreground">
              <div class="flex items-center">
                <MapPin className="w-4 h-4 me-2" />
                {listing.city || 'Unknown Location'}
              </div>
              <div class="flex items-center">
                <Calendar className="w-4 h-4 me-2" />
                {new Date(listing.creation).toLocaleDateString()}
              </div>
              <div class="flex items-center">
                <User className="w-4 h-4 me-2" />
                {listing.advertiser_summary?.advertiser_name || listing.advertiser}
              </div>
            </div>
          </div>

          {/* Image Gallery (Placeholder for single image for now) */}
          <div class="relative w-full aspect-video rounded-3xl overflow-hidden mb-12 bg-muted border border-border">
            <img src={imageUrl} alt={listing.title} class="w-full h-full object-cover" />
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            {/* Main Content */}
            <div class="lg:col-span-2 space-y-12">
              <div class="prose prose-lg dark:prose-invert max-w-none">
                <h2 class="text-2xl font-bold mb-4">Description</h2>
                {listing.description ? (
                  <div set:html={listing.description} />
                ) : (
                  <p>{listing.summary}</p>
                )}
              </div>
            </div>

            {/* Sidebar */}
            <div class="space-y-6">
              <div class="bg-muted/50 rounded-2xl p-6 border border-border">
                <h3 class="text-xl font-bold mb-6">Contact Advertiser</h3>
                
                <div class="flex items-center gap-4 mb-6 pb-6 border-b border-border">
                  <div class="w-12 h-12 bg-primary/20 rounded-full flex items-center justify-center text-primary font-bold text-xl">
                    {(listing.advertiser_summary?.advertiser_name || listing.advertiser || '?')[0].toUpperCase()}
                  </div>
                  <div>
                    <div class="font-medium">{listing.advertiser_summary?.advertiser_name || listing.advertiser}</div>
                    <div class="text-sm text-muted-foreground">Member since {listing.advertiser_summary?.creation ? new Date(listing.advertiser_summary.creation).getFullYear() : 'Unknown'}</div>
                  </div>
                </div>

                {contactNumber ? (
                  <a 
                    href={`https://wa.me/${contactNumber.replace(/[^0-9]/g, '')}`} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-full gap-2 bg-green-600 hover:bg-green-700 text-white py-3 px-4 rounded-xl font-medium transition-colors mb-3"
                  >
                    <Phone className="w-5 h-5" />
                    WhatsApp
                  </a>
                ) : (
                  <div class="text-center text-sm text-muted-foreground mb-3 py-3 bg-background rounded-xl border border-border">
                    No contact number provided
                  </div>
                )}
                
                <Button variant="outline" class="w-full justify-center">
                  <Share2 className="w-4 h-4 me-2" />
                  Share Listing
                </Button>
              </div>
            </div>
          </div>
        </div>
      )}
    </Section>
  </div>
</Layout>
