---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import SellerSubNav from "~/components/seller/SellerSubNav.astro";
import SellerApiClient from "~/components/seller/SellerApiClient";
import { getMeamartSession } from "~/utils/session";
import { defaultLang } from "~/i18n/ui";
import { isRtl } from "~/i18n/utils";

export const prerender = false;

const { lang = defaultLang } = Astro.params;
const rtl = isRtl(lang);

const rawSession = await getMeamartSession(Astro);
const session = rawSession || {
  id: "seller-default-user",
  name: "المعلن",
};
---

<Layout
  title="الربط البرمجي API و Webhooks | ميمارت"
  description="إدارة المفاتيح البرمجية وإعدادات الويبهوك ومزامنة الكتالوج مع ميشات"
>
  <Container>
    <div class="py-8">
      <PageHeader
        title={lang === "ar"
          ? "الربط البرمجي API و Webhooks"
          : "API & Webhooks Integration"}
        description={lang === "ar"
          ? "أدوات الربط المتقدمة لإدارة الباركود والإعلانات ومزامنة الكتالوج التلقائية مع ميشات"
          : "Manage API keys, webhook notifications, and automated MeaChat catalog sync"}
      />

      <SellerSubNav lang={lang} activeTab="api" />

      <div class="mt-8 max-w-7xl mx-auto">
        <SellerApiClient client:load lang={lang} />
      </div>
    </div>
  </Container>
</Layout>
