---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import Button from "~/components/ui/Button.astro";
import {
  ShoppingBag as ShoppingBagIcon,
  Edit as EditIcon,
  Trash2 as TrashIcon,
  CheckCircle as CheckCircleIcon,
  Package as PackageIcon,
  PlusCircle as PlusCircleIcon,
  ArrowLeft,
  ArrowRight,
  Layers,
  Tag as TagIcon,
  Barcode as BarcodeIcon,
} from "lucide-react";
import { getMeamartSession } from "~/utils/session";
import { defaultLang } from "~/i18n/ui";
import { isRtl, useTranslations } from "~/i18n/utils";
import { kvGet } from "~/utils/kv";
import SellerSubNav from "~/components/seller/SellerSubNav.astro";

export const prerender = false;

const { lang = defaultLang } = Astro.params;
const rtl = isRtl(lang);
const t = useTranslations(lang);

let session = Astro.locals.userSession || (await getMeamartSession(Astro));

if (!session) {
  return Astro.redirect(`/${lang}/login`);
}

const sellerName = session.name || "";
let sellerProducts: any[] = [];
let errorMsg = "";
let adsCount = 0;
let addressesCount = 0;

try {
  const allPosts = [];
  const sellerPhone = session.phone || "";
  const cleanSellerPhone = sellerPhone.replace(/[^0-9]/g, "");
  const ads = allPosts.filter((p) => {
    if (!p.isAd) return false;
    if (session.wp_user_id && p.author === Number(session.wp_user_id))
      return true;
    if (cleanSellerPhone && p.adData?.contact_phone) {
      const cleanAdPhone = p.adData.contact_phone.replace(/[^0-9]/g, "");
      if (
        cleanAdPhone === cleanSellerPhone ||
        cleanAdPhone.endsWith(cleanSellerPhone)
      )
        return true;
    }
    return false;
  });
  adsCount = ads.length;
} catch (e) {
  console.error("[Seller Products] Error fetching ads count:", e);
}

try {
  const userId = session.wp_user_id || session.email;
  const kvKey = `seller_addresses_${userId}`;
  const dataStr = await kvGet(Astro, kvKey);
  if (dataStr) {
    addressesCount = JSON.parse(dataStr).length;
  }
} catch (e) {
  console.error("[Seller Products] Error fetching addresses count:", e);
}

try {
  const allProducts = [];
  if (Array.isArray(allProducts)) {
    sellerProducts = allProducts.filter((p: any) => {
      const sellerIdMeta = p.meta_data?.find(
        (m: any) => m.key === "_meamart_seller_id",
      );
      const sellerEmailMeta = p.meta_data?.find(
        (m: any) => m.key === "_meamart_seller_email",
      );

      if (
        session.wp_user_id &&
        sellerIdMeta &&
        Number(sellerIdMeta.value) === Number(session.wp_user_id)
      ) {
        return true;
      }
      if (
        session.email &&
        sellerEmailMeta &&
        sellerEmailMeta.value === session.email
      ) {
        return true;
      }
      return false;
    });
  }
} catch (e) {
  console.error("[Seller Products] Error fetching WooCommerce products:", e);
  errorMsg = t["gen.isar.index.1"];
}

const formatPrice = (price: number | string, currency: string = "SAR") => {
  const amount = Number(price) || 0;
  const locale = lang === "ar" ? "ar-SA" : "en-US";
  const formatted = new Intl.NumberFormat(locale, {
    maximumFractionDigits: 2,
  }).format(amount);
  return t["ads.card.price.format"]
    .replace("{price}", formatted)
    .replace("{symbol}", t["ads.create.currency.SAR"].split(" ")[0]);
};
---

<Layout title={t["gen.isar.index.4"]} description={t["gen.isar.index.5"]}>
  <PageHeader
    title={t["gen.isar.index.6"]}
    description={t["gen.isar.index.7"]}
  />

  <Container class="pb-24">
    <SellerSubNav
      lang={lang}
      activeTab="products"
      adsCount={adsCount}
      productsCount={sellerProducts.length}
      addressesCount={addressesCount}
    />

    <!-- Status Alert -->
    {
      errorMsg && (
        <div class="mb-6 rounded-full border border-red-200 bg-red-50 p-4 text-sm text-red-800 dark:border-red-900/30 dark:bg-red-900/10">
          {errorMsg}
        </div>
      )
    }

    <!-- Product Summary Card -->
    <div
      class="mb-8 flex flex-col items-center justify-between gap-6 rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40 md:flex-row"
    >
      <div class="flex items-center gap-4">
        <div
          class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary"
        >
          <ShoppingBagIcon className="h-6 w-6" />
        </div>
        <div>
          <h3 class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
            {t["gen.isar.index.8"]}
          </h3>
          <h4
            class="mt-1 text-2xl font-extrabold text-zinc-900 dark:text-zinc-50"
          >
            {sellerProducts.length}
          </h4>
        </div>
      </div>

      <div>
        <Button
          href={`/${lang}/seller/products/create`}
          class="w-full sm:w-auto rounded-full px-6 py-3 text-xs font-bold shadow-md shadow-primary/10"
        >
          <PlusCircleIcon
            className="h-4 w-4 inline-block me-1.5 align-middle"
          />
          <span class="align-middle">{t["gen.isar.index.9"]}</span>
        </Button>
      </div>
    </div>

    <!-- Products Grid -->
    {
      sellerProducts.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-zinc-200 bg-zinc-50 py-20 text-center dark:border-zinc-800 dark:bg-zinc-900/20 mb-8">
          <div class="flex justify-center mb-4">
            <PackageIcon className="h-12 w-12 text-zinc-400" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">
            {t["gen.isar.index.10"]}
          </h3>
          <p class="mt-2 text-sm text-zinc-500 max-w-md mx-auto">
            {t["gen.isar.index.11"]}
          </p>
          <Button
            href={`/${lang}/seller/products/create`}
            class="mt-6 rounded-full px-6 py-2.5 text-xs font-bold"
          >
            {t["gen.isar.index.12"]}
          </Button>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {sellerProducts.map((p) => {
            const brand =
              p.meta_data?.find((m: any) => m.key === "_brand")?.value || "";
            const gtin =
              p.meta_data?.find((m: any) => m.key === "_gtin")?.value || "";

            return (
              <div
                class="product-card relative flex flex-col gap-4 overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/40 p-5 shadow-xs backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40 sm:flex-row hover:shadow-md transition-all duration-300"
                id={`product-card-${p.id}`}
              >
                <div class="h-28 w-full shrink-0 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800 sm:w-32 border border-zinc-200/30">
                  {p.images?.[0]?.src ? (
                    <img
                      src={p.images[0].src}
                      alt={p.name}
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-zinc-250 dark:bg-zinc-700">
                      <PackageIcon className="h-8 w-8 text-zinc-400" />
                    </div>
                  )}
                </div>

                <div class="flex flex-1 flex-col justify-between space-y-3 py-1">
                  <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <span class="inline-flex items-center gap-1 rounded-md bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 text-[10px] font-bold text-zinc-500 dark:text-zinc-400">
                        SKU: {p.sku}
                      </span>

                      {gtin && (
                        <span class="inline-flex items-center gap-1 rounded-md bg-primary/10 px-2 py-0.5 text-[10px] font-bold text-primary">
                          <BarcodeIcon className="h-3 w-3" />
                          GTIN: {gtin}
                        </span>
                      )}

                      {p.stock_status === "instock" ? (
                        <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                          <CheckCircleIcon className="h-3 w-3" />
                          {t["gen.isar.index.13"]}
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1 rounded-md bg-red-50 px-2 py-0.5 text-[10px] font-bold text-red-600 dark:bg-red-900/30 dark:text-red-400">
                          {t["gen.isar.index.14"]}
                        </span>
                      )}
                    </div>

                    <h3 class="line-clamp-1 text-base font-bold text-zinc-900 dark:text-zinc-50">
                      <a
                        href={`/${lang}/catalog/${p.id}`}
                        class="transition hover:text-primary"
                      >
                        {p.name}
                      </a>
                    </h3>

                    <div class="flex items-center gap-2">
                      <span class="text-sm font-extrabold text-primary">
                        {formatPrice(p.price)}
                      </span>
                      {p.sale_price && (
                        <span class="text-xs text-zinc-400 line-through">
                          {formatPrice(p.regular_price)}
                        </span>
                      )}
                    </div>

                    {brand && (
                      <p class="text-xs text-zinc-500 dark:text-zinc-400 font-semibold flex items-center gap-1">
                        <TagIcon className="h-3 w-3" />
                        <span>
                          {t["gen.isar.index.15"]} {brand}
                        </span>
                      </p>
                    )}
                  </div>

                  <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-zinc-100 dark:border-zinc-800/50">
                    <Button
                      href={`/${lang}/seller/products/edit/${p.id}`}
                      variant="outline"
                      class="flex items-center gap-1 rounded-xl border-zinc-200 px-3.5 py-1.5 text-xs font-semibold dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-850"
                    >
                      <EditIcon className="h-3.5 w-3.5" />
                      <span>{t["gen.isar.index.16"]}</span>
                    </Button>

                    <button
                      type="button"
                      class="delete-product-btn flex items-center gap-1 rounded-xl border border-red-100 px-3.5 py-1.5 text-xs font-semibold text-red-600 transition hover:bg-red-50 dark:border-red-950/20 dark:hover:bg-red-950/30"
                      data-id={p.id}
                      data-name={p.name}
                    >
                      <TrashIcon className="h-3.5 w-3.5" />
                      <span>{t["gen.isar.index.17"]}</span>
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </Container>
</Layout>

<script
  define:vars={{
    confirmMsg: t["gen.isar.index.18"],
    loadingMsg: t["gen.isar.index.19"],
    errorMsgDefault: t["gen.isar.index.20"],
  }}
>
  // Delete product action handler
  document.querySelectorAll(".delete-product-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      /** @type {HTMLButtonElement} */
      const button = e.currentTarget;
      const id = button.getAttribute("data-id");
      const name = button.getAttribute("data-name") || "";

      if (!confirm(confirmMsg)) return;

      button.disabled = true;
      const originalText = button.innerHTML;
      button.innerText = loadingMsg;

      try {
        const res = await fetch("/api/products/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ productId: id }),
        });
        const result = await res.json();

        if (result.success) {
          window.location.reload();
        } else {
          throw new Error(result.error);
        }
      } catch (err) {
        button.disabled = false;
        button.innerHTML = originalText;
        const message = err instanceof Error ? err.message : "";
        alert(message || errorMsgDefault);
      }
    });
  });
</script>
