---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import Button from "~/components/ui/Button.astro";
import { getMeamartSession } from "~/utils/session";
import { defaultLang } from "~/i18n/ui";
import { isRtl, useTranslations } from "~/i18n/utils";
import { createSupabaseAdminServerClient } from "~/utils/supabase";
import {
  Building2,
  CheckCircle,
  HelpCircle,
  AlertCircle,
  Plus,
  ShoppingBag,
  Sparkles,
  Smartphone,
  Save,
  Trash2,
  ExternalLink,
} from "lucide-react";
import SellerSubNav from "~/components/seller/SellerSubNav.astro";

export const prerender = false;

const { lang = defaultLang } = Astro.params;
const rtl = isRtl(lang);
const t = useTranslations(lang);
const isAr = lang === "ar";

const session = await getMeamartSession(Astro);
if (!session) {
  return Astro.redirect(`/${lang}/login`);
}

const supabase = createSupabaseAdminServerClient(Astro);
const { data: profile } = await supabase
  .from("profiles")
  .select("*")
  .eq("id", session.id)
  .single();

const userType = profile?.user_type || "individual";
const isMechatVerified = profile?.is_mechat_verified || false;
const companyName = profile?.company_name || "";
const phoneVal = profile?.phone || session.phone || "";

// Fetch products in catalog
let sellerProducts: any[] = [];
let adsCount = 0;
let addressesCount = 0;

try {
  const { data: prods } = await supabase
    .from("products")
    .select("*")
    .eq("seller_id", session.id)
    .order("created_at", { ascending: false });
  sellerProducts = prods || [];
} catch (e) {
  console.error("Failed to load products:", e);
}

// Fetch counts for tabs
try {
  const { count } = await supabase
    .from("ads")
    .select("*", { count: "exact", head: true })
    .eq("user_id", session.id);
  adsCount = count || 0;
} catch {}

const pageTitle = isAr ? "الشركات والموردين والمنيو" : "Companies, Suppliers & Menu";
const pageDesc = isAr
  ? "إدارة الكاتالوج والمنيو الخاص بك مع التوثيق من خلال ميشات"
  : "Manage your catalogs & menus with Mechat validation";
---

<Layout title={pageTitle} description={pageDesc}>
  <PageHeader title={pageTitle} description={pageDesc} />

  <Container class="pb-24 max-w-7xl">
    <SellerSubNav
      lang={lang}
      activeTab="companies"
      adsCount={adsCount}
      productsCount={sellerProducts.length}
      addressesCount={addressesCount}
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Sidebar / Config -->
      <div class="space-y-6 lg:col-span-1">
        <!-- Section 1: Account Type -->
        <div class="rounded-3xl border border-zinc-200/50 bg-white/60 p-6 shadow-lg backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60 space-y-4">
          <h3 class="text-sm font-bold text-zinc-800 dark:text-zinc-100 flex items-center gap-2">
            <Building2 class="w-4.5 h-4.5 text-primary" />
            <span>{isAr ? "نوع الحساب" : "Account Type"}</span>
          </h3>

          <div class="space-y-3">
            <label class="flex items-center gap-3 p-3 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/20 cursor-pointer select-none">
              <input type="radio" name="acc_type" value="individual" checked={userType === "individual"} class="text-primary focus:ring-primary" />
              <div>
                <span class="block text-xs font-bold text-zinc-800 dark:text-zinc-200">{isAr ? "حساب فردي" : "Individual Account"}</span>
                <span class="block text-[10px] text-zinc-500">{isAr ? "إعلانات شخصية مباشرة" : "Personal direct ads"}</span>
              </div>
            </label>

            <label class="flex items-center gap-3 p-3 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/20 cursor-pointer select-none">
              <input type="radio" name="acc_type" value="company" checked={userType === "company"} class="text-primary focus:ring-primary" />
              <div>
                <span class="block text-xs font-bold text-zinc-800 dark:text-zinc-200">{isAr ? "حساب شركة / مورد" : "Company / Supplier Account"}</span>
                <span class="block text-[10px] text-zinc-500">{isAr ? "ربط الكاتالوج والمنيو بميشات" : "Link catalogs & menus to Mechat"}</span>
              </div>
            </label>
          </div>

          <div id="company-name-wrap" class={userType === "company" ? "" : "hidden"}>
            <label class="block text-xs font-bold text-zinc-500 mb-1">{isAr ? "اسم الشركة / المطعم" : "Company / Restaurant Name"}</label>
            <input type="text" id="company-name-input" value={companyName} class="w-full rounded-full border border-zinc-200 bg-white/85 py-2 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50" placeholder={isAr ? "مثال: مطعم شاورما هوس" : "e.g. Shawarma House"} />
          </div>

          <button id="save-type-btn" class="w-full py-2.5 px-5 bg-primary hover:bg-primary/95 text-white text-xs font-bold rounded-full transition-all flex items-center justify-center gap-2">
            <Save class="w-3.5 h-3.5" />
            <span>{isAr ? "حفظ التغييرات" : "Save Changes"}</span>
          </button>
        </div>

        <!-- Section 2: WhatsApp & Mechat Verification -->
        <div class="rounded-3xl border border-zinc-200/50 bg-white/60 p-6 shadow-lg backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60 space-y-4">
          <h3 class="text-sm font-bold text-zinc-800 dark:text-zinc-100 flex items-center gap-2">
            <Smartphone class="w-4.5 h-4.5 text-primary" />
            <span>{isAr ? "توثيق واتساب ميشات" : "Verify WhatsApp Mechat"}</span>
          </h3>

          <div class="flex items-center gap-2">
            {isMechatVerified ? (
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300">
                <CheckCircle class="w-3 h-3" />
                <span>{isAr ? "مشترك وموثق في ميشات" : "Subscribed & Verified"}</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/40 dark:text-amber-300">
                <AlertCircle class="w-3 h-3" />
                <span>{isAr ? "غير موثق بميشات" : "Not Verified with Mechat"}</span>
              </span>
            )}
          </div>

          <p class="text-[10px] text-zinc-500 leading-relaxed">
            {isAr
              ? "لربط الكاتالوج والمنيو بالواتساب وتفعيل المبيعات التلقائية، يجب أن يكون رقمك مشتركاً في خدمة ميشات."
              : "To link your catalog to WhatsApp, your number must be subscribed to Mechat."}
          </p>

          <div class="space-y-2">
            <label class="block text-xs font-bold text-zinc-500 mb-1">{isAr ? "رقم الواتساب للربط" : "WhatsApp Number"}</label>
            <input type="text" id="wa-number-input" value={phoneVal} class="w-full rounded-full border border-zinc-200 bg-white/85 py-2 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50" placeholder="+966500000000" />
          </div>

          <button id="verify-mechat-btn" class="w-full py-2.5 px-5 bg-zinc-800 hover:bg-zinc-900 text-white text-xs font-bold rounded-full transition-all flex items-center justify-center gap-2 dark:bg-zinc-700 dark:hover:bg-zinc-650">
            <Sparkles class="w-3.5 h-3.5 text-primary" />
            <span>{isAr ? "التحقق والربط بميشات" : "Verify & Link Mechat"}</span>
          </button>
        </div>
      </div>

      <!-- Catalog Manager -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Section 3: Catalog List -->
        <div class="rounded-3xl border border-zinc-200/50 bg-white/60 p-6 sm:p-8 shadow-lg backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60 space-y-6">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-4 dark:border-zinc-800">
            <h3 class="text-base font-bold text-zinc-800 dark:text-zinc-100 flex items-center gap-2">
              <ShoppingBag class="w-5 h-5 text-primary" />
              <span>{isAr ? "المنيو والكاتالوج النشط" : "Active Menu & Catalog"}</span>
            </h3>

            {userType === "company" && isMechatVerified && (
              <button id="add-product-modal-btn" class="py-1.5 px-4 bg-primary hover:bg-primary/95 text-white text-xs font-bold rounded-full transition-all flex items-center gap-1.5 shadow-md shadow-primary/20">
                <Plus class="w-3.5 h-3.5" />
                <span>{isAr ? "منتج جديد" : "New Product"}</span>
              </button>
            )}
          </div>

          {userType !== "company" || !isMechatVerified ? (
            <div class="p-8 text-center space-y-3">
              <AlertCircle class="w-12 h-12 text-zinc-400 mx-auto" />
              <h4 class="text-sm font-bold text-zinc-700 dark:text-zinc-300">
                {isAr ? "الكاتالوج معطل حالياً" : "Catalog Currently Locked"}
              </h4>
              <p class="text-xs text-zinc-500 max-w-md mx-auto leading-relaxed">
                {isAr
                  ? "يتطلب عرض وإدارة الكاتالوج تحويل حسابك لنوع (شركة / مورد) وتوثيق اشتراك الواتساب الخاص بك بنجاح في نظام ميشات."
                  : "Requires converting your account to Company/Supplier and verifying your WhatsApp Mechat subscription."}
              </p>
            </div>
          ) : sellerProducts.length === 0 ? (
            <div class="p-12 text-center space-y-3">
              <ShoppingBag class="w-12 h-12 text-zinc-300 mx-auto" />
              <h4 class="text-sm font-bold text-zinc-700 dark:text-zinc-300">
                {isAr ? "الكاتالوج فارغ" : "Catalog is Empty"}
              </h4>
              <p class="text-xs text-zinc-500">
                {isAr ? "ابدأ بإضافة أول منتج للكاتالوج الخاص بك الآن." : "Add your first product to link it with your ads."}
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {sellerProducts.map((p) => {
                const priceText = p.regular_price ? `${p.regular_price} SAR` : "";
                const img = Array.isArray(p.images) && p.images.length > 0 ? p.images[0] : null;

                return (
                  <div class="p-4 rounded-2xl border border-zinc-200/60 bg-zinc-50/50 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950/20 flex gap-4 transition-all group relative">
                    <div class="w-16 h-16 rounded-xl border border-zinc-200/80 bg-white dark:border-zinc-800 dark:bg-zinc-900 shrink-0 flex items-center justify-center overflow-hidden">
                      {img ? (
                        <img src={img} alt={p.name} class="w-full h-full object-cover" />
                      ) : (
                        <ShoppingBag class="w-6 h-6 text-zinc-400" />
                      )}
                    </div>

                    <div class="flex-1 space-y-1">
                      <span class="block text-xs font-bold text-zinc-800 dark:text-zinc-200 line-clamp-1">
                        {p.name}
                      </span>
                      <span class="block text-[10px] text-zinc-400 font-mono">
                        SKU: {p.sku}
                      </span>
                      <div class="flex items-center justify-between">
                        <span class="text-xs font-black text-primary">
                          {priceText}
                        </span>
                        <span class="text-[10px] bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded-full dark:bg-emerald-950/30 dark:text-emerald-400 font-semibold">
                          {isAr ? "نشط" : "Active"}
                        </span>
                      </div>
                    </div>

                    <button
                      class="delete-prod-btn absolute top-2 end-2 opacity-0 group-hover:opacity-100 p-1.5 hover:bg-red-50 text-red-500 rounded-full transition-all dark:hover:bg-red-950/20"
                      data-id={p.id}
                      aria-label="Delete Product"
                    >
                      <Trash2 class="w-3.5 h-3.5" />
                    </button>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Quick Modal Add Product -->
    <div id="add-product-modal" class="fixed inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden">
      <div class="bg-white dark:bg-zinc-900 rounded-3xl max-w-lg w-full p-6 shadow-2xl space-y-4 border border-zinc-200 dark:border-zinc-800 animate-in fade-in zoom-in-95 duration-200">
        <h4 class="text-base font-bold text-zinc-900 dark:text-zinc-50 border-b border-zinc-100 pb-2 dark:border-zinc-800">
          {isAr ? "إضافة منتج جديد للكاتالوج" : "Add New Product"}
        </h4>

        <form id="modal-product-form" class="space-y-4">
          <div class="grid grid-cols-2 gap-4">
            <div class="col-span-2">
              <label class="block text-xs font-bold text-zinc-500 mb-1">{isAr ? "اسم المنتج *" : "Product Name *"}</label>
              <input type="text" name="name" required class="w-full rounded-full border border-zinc-200 bg-white/80 py-2 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50" />
            </div>

            <div>
              <label class="block text-xs font-bold text-zinc-500 mb-1">{isAr ? "رمز السلعة (SKU) *" : "Product SKU *"}</label>
              <input type="text" name="sku" required class="w-full rounded-full border border-zinc-200 bg-white/80 py-2 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50" />
            </div>

            <div>
              <label class="block text-xs font-bold text-zinc-500 mb-1">{isAr ? "السعر *" : "Price *"}</label>
              <input type="number" name="regular_price" required class="w-full rounded-full border border-zinc-200 bg-white/80 py-2 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50" />
            </div>

            <div>
              <label class="block text-xs font-bold text-zinc-500 mb-1">{isAr ? "العلامة التجارية" : "Brand"}</label>
              <input type="text" name="brand" class="w-full rounded-full border border-zinc-200 bg-white/80 py-2 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50" />
            </div>

            <div class="col-span-2">
              <label class="block text-xs font-bold text-zinc-500 mb-1">{isAr ? "الوصف" : "Description"}</label>
              <textarea name="description" rows="3" class="w-full rounded-2xl border border-zinc-200 bg-white/80 py-2 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50"></textarea>
            </div>
          </div>

          <div class="flex items-center justify-end gap-2 border-t border-zinc-100 pt-3 dark:border-zinc-800">
            <button type="button" id="close-modal-btn" class="py-2 px-5 bg-zinc-100 hover:bg-zinc-200 text-zinc-700 text-xs font-bold rounded-full transition-all dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700">
              {isAr ? "إلغاء" : "Cancel"}
            </button>
            <button type="submit" class="py-2 px-5 bg-primary hover:bg-primary/95 text-white text-xs font-bold rounded-full transition-all shadow-md shadow-primary/20">
              {isAr ? "إضافة" : "Add Product"}
            </button>
          </div>
        </form>
      </div>
    </div>
  </Container>
</Layout>

<script>
  const isAr = window.location.pathname.includes("/ar");

  // 1. Account type switching card highlights
  const radios = document.querySelectorAll('input[name="acc_type"]') as NodeListOf<HTMLInputElement>;
  const companyNameWrap = document.getElementById("company-name-wrap");
  const saveTypeBtn = document.getElementById("save-type-btn");
  const companyNameInput = document.getElementById("company-name-input") as HTMLInputElement;

  radios.forEach((rad) => {
    rad.addEventListener("change", () => {
      if (rad.checked && rad.value === "company") {
        companyNameWrap?.classList.remove("hidden");
      } else {
        companyNameWrap?.classList.add("hidden");
      }
    });
  });

  saveTypeBtn?.addEventListener("click", async () => {
    const selectedRadio = document.querySelector('input[name="acc_type"]:checked') as HTMLInputElement;
    if (!selectedRadio) return;

    saveTypeBtn.disabled = true;
    saveTypeBtn.textContent = "...";

    try {
      const res = await fetch("/api/seller/update-type", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          user_type: selectedRadio.value,
          company_name: companyNameInput?.value || ""
        })
      });
      const data = await res.json();
      if (data.success) {
        alert(isAr ? "تم حفظ نوع الحساب بنجاح!" : "Account type saved successfully!");
        window.location.reload();
      } else {
        throw new Error(data.error);
      }
    } catch (err: any) {
      alert(isAr ? `فشل الحفظ: ${err.message}` : `Save failed: ${err.message}`);
      saveTypeBtn.disabled = false;
      saveTypeBtn.textContent = isAr ? "حفظ التغييرات" : "Save Changes";
    }
  });

  // 2. WhatsApp Mechat Verification
  const verifyMechatBtn = document.getElementById("verify-mechat-btn");
  const waNumberInput = document.getElementById("wa-number-input") as HTMLInputElement;

  verifyMechatBtn?.addEventListener("click", async () => {
    const phone = waNumberInput?.value.trim();
    if (!phone) {
      alert(isAr ? "يرجى إدخال رقم الواتساب" : "Please enter WhatsApp number");
      return;
    }

    verifyMechatBtn.disabled = true;
    verifyMechatBtn.textContent = "...";

    try {
      const res = await fetch("/api/seller/verify-mechat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ phone })
      });
      const data = await res.json();
      if (data.success && data.verified) {
        alert(isAr ? "تم التحقق وتوثيق الرقم بميشات بنجاح!" : "WhatsApp verified with Mechat successfully!");
        window.location.reload();
      } else {
        alert(isAr ? "الرقم غير مشترك في باقة ميشات حالياً" : "Number is not subscribed to Mechat");
        window.location.reload();
      }
    } catch (err: any) {
      alert(isAr ? `فشل التحقق: ${err.message}` : `Verification failed: ${err.message}`);
      verifyMechatBtn.disabled = false;
      verifyMechatBtn.textContent = isAr ? "التحقق والربط بميشات" : "Verify & Link Mechat";
    }
  });

  // 3. Modal Product Creation
  const addModal = document.getElementById("add-product-modal");
  const addModalBtn = document.getElementById("add-product-modal-btn");
  const closeModalBtn = document.getElementById("close-modal-btn");
  const modalForm = document.getElementById("modal-product-form") as HTMLFormElement;

  addModalBtn?.addEventListener("click", () => {
    addModal?.classList.remove("hidden");
  });

  closeModalBtn?.addEventListener("click", () => {
    addModal?.classList.add("hidden");
  });

  modalForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(modalForm);
    const payload: any = {};
    formData.forEach((val, key) => {
      payload[key] = val;
    });
    payload.regular_price = Number(payload.regular_price);

    try {
      const res = await fetch("/api/products/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        alert(isAr ? "تمت إضافة المنتج للكاتالوج بنجاح!" : "Product added to catalog successfully!");
        window.location.reload();
      } else {
        throw new Error(data.error);
      }
    } catch (err: any) {
      alert(isAr ? `فشل إضافة المنتج: ${err.message}` : `Failed to add product: ${err.message}`);
    }
  });

  // 4. Product Deletion
  const deleteBtns = document.querySelectorAll(".delete-prod-btn");
  deleteBtns.forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.getAttribute("data-id");
      if (!id) return;
      if (!confirm(isAr ? "هل أنت متأكد من حذف هذا المنتج من الكاتالوج؟" : "Are you sure you want to delete this product?")) return;

      try {
        const res = await fetch("/api/products/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ productId: id })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          throw new Error(data.error);
        }
      } catch (err: any) {
        alert(isAr ? `فشل الحذف: ${err.message}` : `Delete failed: ${err.message}`);
      }
    });
  });
</script>
