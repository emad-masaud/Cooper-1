---
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import AdminNavTabs from "~/components/admin/AdminNavTabs.astro";
import { parseAdminSession } from '~/utils/session';
import { createSupabaseAdminServerClient } from '~/utils/supabase';
import { defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { User as UserIcon } from 'lucide-react';

export const prerender = false;

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);

const session = await parseAdminSession(Astro.cookies, Astro.locals);
if (!session || !session.is_admin) {
  return Astro.redirect(`/${lang}/admin-login`);
}

let allUsers: any[] = [];
try {
  const supabase = createSupabaseAdminServerClient({ locals: Astro.locals });
  const { data: sbUsers } = await supabase.from('profiles').select('*');
  if (sbUsers) {
    allUsers = sbUsers;
  }
} catch (e) {
  console.error('Failed to fetch admin users:', e);
}
---

<Layout title="Admin Users | MeaMart" description="Manage all users">
  <PageHeader title={t['admin.users.title']} description={t['admin.users.desc']} />

  <Container class="pb-24 max-w-full">
    <AdminNavTabs lang={lang} activeTab="users" />

    <!-- Users List -->
    <div class="bg-white/60 dark:bg-zinc-900/60 rounded-3xl border border-zinc-200/50 dark:border-zinc-800/50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-xs text-zinc-500 uppercase bg-zinc-50/50 dark:bg-zinc-800/50 dark:text-zinc-400">
            <tr>
              <th scope="col" class="px-6 py-4">{t['admin.users.col.user']}</th>
              <th scope="col" class="px-6 py-4">{t['admin.users.col.email']}</th>
              <th scope="col" class="px-6 py-4 text-center">{t['admin.users.col.role']}</th>
            </tr>
          </thead>
          <tbody>
            {allUsers.map((user) => (
              <tr class="border-b border-zinc-100 dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    {user.avatar_urls && user.avatar_urls['48'] ? (
                      <img src={user.avatar_urls['48']} alt={user.name} class="w-10 h-10 rounded-xl object-cover" />
                    ) : (
                      <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                        <UserIcon className="w-5 h-5" />
                      </div>
                    )}
                    <div class="font-bold text-zinc-900 dark:text-white">{user.name}</div>
                  </div>
                </td>
                <td class="px-6 py-4 text-zinc-600 dark:text-zinc-400">
                  {user.email || user.username || '—'}
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="px-2.5 py-1 text-[10px] font-bold rounded-full bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 uppercase">
                    {(user.roles && user.roles.length > 0) ? user.roles[0] : 'User'}
                  </span>
                </td>
              </tr>
            ))}
            {allUsers.length === 0 && (
              <tr>
                <td colspan="3" class="px-6 py-12 text-center text-zinc-500">
                  {t['admin.users.empty']}
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </Container>
</Layout>
