---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import AdminNavTabs from "~/components/admin/AdminNavTabs.astro";
import { parseAdminSession } from "~/utils/session";
import { defaultLang } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import { kvGet, kvPut } from "~/utils/kv";
import { getEnv } from "~/utils/env";
import { createSupabaseAdminServerClient } from "~/utils/supabase";
import { Webhook, Network, KeySquare, Server, AlertCircle } from "lucide-react";

export const prerender = false;

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);
const isAr = lang === 'ar';

const session = await parseAdminSession(Astro.cookies, Astro.locals);
if (!session || !session.is_admin) {
  return Astro.redirect(`/${lang}/admin-login`);
}

const supabase = createSupabaseAdminServerClient(Astro);
let adminChatbotToken = getEnv(Astro.locals, 'MEACHAT_WEBHOOK_TOKEN', 'MeaMart@Admin#2026!Webhook');

const webhookUrl = `https://meamart.com/api/ai/sanad-chat?token=${adminChatbotToken}`;
---

<Layout title="Integration & APIs | MeaMart" description="MeaMart Admin Integration">
  <PageHeader
    title={t["admin.datatools.title"]}
    description={t["admin.datatools.desc"]}
  />

  <Container class="pb-24 max-w-full">
    <AdminNavTabs lang={lang} activeTab="database" />

    <!-- Main Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      {/* Admin Webhook Section */}
      <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 h-fit">
        <div class="flex items-center gap-3 border-b border-zinc-200 pb-4 dark:border-zinc-800">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <Webhook class="h-5 w-5" />
          </div>
          <div>
            <h2 class="text-lg font-bold text-zinc-900 dark:text-white">
              {t["admin.webhook.title"]}
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
              {t["admin.webhook.desc"]}
            </p>
          </div>
        </div>
        
        <div class="mt-5 space-y-4">
          <div class="bg-zinc-50 dark:bg-zinc-800/50 p-4 rounded-xl border border-zinc-200 dark:border-zinc-700">
             <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300 mb-2">{t["admin.webhook.ready"]}</p>
             <code class="text-xs text-blue-600 dark:text-blue-400 break-all select-all">{webhookUrl}</code>
          </div>
          <div class="flex items-start gap-2 p-3 bg-amber-50 dark:bg-amber-900/10 text-amber-800 dark:text-amber-500 rounded-xl text-xs">
            <AlertCircle class="h-4 w-4 shrink-0 mt-0.5" />
            <p>{t["admin.webhook.notice"]}</p>
          </div>
        </div>
      </div>

      {/* Global API Endpoints */}
      <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
        <div class="flex items-center gap-3 border-b border-zinc-200 pb-4 dark:border-zinc-800">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400">
            <Network class="h-5 w-5" />
          </div>
          <div>
            <h2 class="text-lg font-bold text-zinc-900 dark:text-white">
              {t["admin.endpoints.title"]}
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
              {t["admin.endpoints.desc"]}
            </p>
          </div>
        </div>

        <div class="mt-5 space-y-3">
          <div class="p-3 bg-zinc-50 dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700">
            <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300">{t["admin.endpoints.all_ads"]}</p>
            <code class="text-[10px] text-blue-600 dark:text-blue-400 mt-1 block">GET /api/v1/admin/ads</code>
          </div>
          <div class="p-3 bg-zinc-50 dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700">
            <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300">{t["admin.endpoints.all_users"]}</p>
            <code class="text-[10px] text-blue-600 dark:text-blue-400 mt-1 block">GET /api/v1/admin/users</code>
          </div>
          <div class="p-3 bg-zinc-50 dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700">
            <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300">{t["admin.endpoints.all_products"]}</p>
            <code class="text-[10px] text-blue-600 dark:text-blue-400 mt-1 block">GET /api/v1/admin/products</code>
          </div>
          <div class="p-3 bg-zinc-50 dark:bg-zinc-800/50 rounded-xl border border-zinc-200 dark:border-zinc-700">
            <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300">{t["admin.endpoints.all_barcodes"]}</p>
            <code class="text-[10px] text-blue-600 dark:text-blue-400 mt-1 block">GET /api/v1/admin/barcodes</code>
          </div>
        </div>
      </div>

      {/* Admin Permissions (OAuth / Security) */}
      <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900 lg:col-span-2">
        <div class="flex items-center gap-3 border-b border-zinc-200 pb-4 dark:border-zinc-800">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-500/10 text-violet-600 dark:text-violet-400">
            <KeySquare class="h-5 w-5" />
          </div>
          <div>
            <h2 class="text-lg font-bold text-zinc-900 dark:text-white">
              {t["admin.permissions.title"]}
            </h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
              {t["admin.permissions.desc"]}
            </p>
          </div>
        </div>
        
        <div class="mt-5">
           <div class="bg-zinc-50 dark:bg-zinc-800/50 p-4 rounded-xl border border-zinc-200 dark:border-zinc-700">
             <label class="block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-2">
                {t["admin.permissions.token_label"]}
             </label>
             <input
               type="text"
               readonly
               value={adminChatbotToken}
               class="w-full rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm text-zinc-500 focus:outline-none dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-400 select-all"
             />
             <p class="text-[11px] text-zinc-500 mt-2">
               {t["admin.permissions.token_help"]}
             </p>
           </div>
        </div>
      </div>

    </div>
  </Container>
</Layout>
