---
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import AdminNavTabs from "~/components/admin/AdminNavTabs.astro";
import { parseAdminSession } from '~/utils/session';
import { createSupabaseAdminServerClient } from '~/utils/supabase';
import { defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { Trash2 as TrashIcon, ExternalLink as ExternalLinkIcon, Copy as CopyIcon, Link as LinkIcon } from 'lucide-react';

export const prerender = false;

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);

const session = await parseAdminSession(Astro.cookies, Astro.locals);
if (!session || !session.is_admin) {
  return Astro.redirect(`/${lang}/admin-login`);
}

let allAds: any[] = [];
try {
  const supabase = createSupabaseAdminServerClient({ locals: Astro.locals });
  const { data: sbAds } = await supabase.from('ads').select('*').order('created_at', { ascending: false });
  if (sbAds) {
    allAds = sbAds.map(ad => ({
      id: ad.id,
      adId: ad.id,
      title: ad.title || '',
      price: ad.price || 0,
      currency: ad.currency || 'SAR',
      image: Array.isArray(ad.images) && ad.images.length > 0 ? ad.images[0] : '',
      status: ad.status || 'active',
      seller: ad.contact_name || ad.user_id || 'Unknown',
      phone: ad.contact_phone || '',
      date: ad.created_at ? new Date(ad.created_at).toLocaleDateString(t['gen.isar.ads.1']) : '-'
    }));
  }
} catch (e) {
  console.error('Failed to fetch Supabase admin ads:', e);
}
---

<Layout title="Admin Ads | MeaMart" description="Manage all ads">
  <PageHeader title={t['admin.ads.title']} description={t['admin.ads.desc']} />

  <Container class="pb-24 max-w-full">
    <AdminNavTabs lang={lang} activeTab="ads" />

    <!-- Ads List -->
    <div class="bg-white/60 dark:bg-zinc-900/60 rounded-3xl border border-zinc-200/50 dark:border-zinc-800/50 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead class="text-xs text-zinc-500 uppercase bg-zinc-50/50 dark:bg-zinc-800/50 dark:text-zinc-400">
            <tr>
              <th scope="col" class="px-6 py-4">{t['admin.ads.col.ad']}</th>
              <th scope="col" class="px-4 py-4 text-center">ID / API</th>
              <th scope="col" class="px-6 py-4">{t['admin.ads.col.seller']}</th>
              <th scope="col" class="px-6 py-4">{t['admin.ads.col.price']}</th>
              <th scope="col" class="px-6 py-4">{t['admin.ads.col.status']}</th>
              <th scope="col" class="px-6 py-4">{t['admin.ads.col.date']}</th>
              <th scope="col" class="px-6 py-4 text-center">{t['admin.ads.col.actions']}</th>
            </tr>
          </thead>
          <tbody>
            {allAds.map((ad) => (
              <tr class="border-b border-zinc-100 dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors" id={`ad-row-${ad.id}`}>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <img src={ad.image || '/logo.svg'} alt={ad.title} class="w-10 h-10 rounded-xl object-cover" />
                    <a href={`/${lang}/ads/${ad.id}`} target="_blank" class="font-bold text-zinc-900 dark:text-white hover:text-primary transition-colors line-clamp-1 max-w-50">
                      {ad.title}
                    </a>
                  </div>
                </td>
                <td class="px-4 py-4">
                  <div class="flex flex-col gap-1">
                    <button class="copy-id-btn inline-flex items-center gap-1 px-2 py-1 text-xs font-mono font-bold bg-primary/10 text-primary rounded-lg hover:bg-primary/20 transition-colors cursor-pointer" data-copy={`MM-${ad.id}`} title={t['admin.ads.copy_id']}>
                      <CopyIcon className="w-3 h-3" />
                      MM-{ad.id}
                    </button>
                    <a href={`/api/ads/bot-info?adId=${ad.id}`} target="_blank" class="inline-flex items-center gap-1 px-2 py-1 text-[10px] font-mono text-zinc-500 hover:text-primary bg-zinc-100 dark:bg-zinc-800 rounded-lg hover:bg-primary/10 transition-colors">
                      <LinkIcon className="w-3 h-3" />
                      {t['admin.ads.api_link']}
                    </a>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="font-medium text-zinc-900 dark:text-zinc-100">{ad.seller}</div>
                  <div class="text-xs text-zinc-500" dir="ltr">{ad.phone}</div>
                </td>
                <td class="px-6 py-4 font-bold text-zinc-900 dark:text-zinc-100">
                  {ad.price} {ad.currency}
                </td>
                <td class="px-6 py-4">
                  <span class={`px-2.5 py-1 text-[10px] font-bold rounded-full ${ad.status === 'active' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' : 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-400'}`}>
                    {ad.status === 'active' ? t['admin.ads.status.active'] : t['admin.ads.status.inactive']}
                  </span>
                </td>
                <td class="px-6 py-4 text-zinc-500 whitespace-nowrap">
                  {ad.date}
                </td>
                <td class="px-6 py-4 text-center">
                  <div class="flex items-center justify-center gap-2">
                    <a href={`/${lang}/ads/${ad.id}`} target="_blank" class="p-2 text-zinc-500 hover:text-primary hover:bg-primary/10 rounded-xl transition-colors">
                      <ExternalLinkIcon className="w-4 h-4" />
                    </a>
                    <button class="delete-ad-btn p-2 text-red-500 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl transition-colors" data-id={ad.id}>
                      <TrashIcon className="w-4 h-4" />
                    </button>
                  </div>
                </td>
              </tr>
            ))}
            {allAds.length === 0 && (
              <tr>
                <td colspan="7" class="px-6 py-12 text-center text-zinc-500">
                  {t['admin.ads.empty']}
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </Container>
</Layout>

<script
  data-confirm={t['admin.ads.delete.confirm']}
  data-error={t['admin.ads.delete.error']}
  data-unexpected={t['admin.ads.delete.unexpected']}
>
  /** @type {NodeListOf<HTMLButtonElement>} */
  const deleteBtns = document.querySelectorAll('.delete-ad-btn');
  const scriptEl = document.currentScript;
  const confirmMsg = scriptEl?.dataset.confirm ?? 'Are you sure?';
  const errorMsg = scriptEl?.dataset.error ?? 'Error:';
  const unexpectedMsg = scriptEl?.dataset.unexpected ?? 'An unexpected error occurred.';

  deleteBtns.forEach(btn => {
    /** @type {HTMLButtonElement} */
    const button = btn;

    btn.addEventListener('click', async () => {
      const adId = button.getAttribute('data-id');

      if (confirm(confirmMsg)) {
        button.setAttribute('disabled', 'disabled');
        button.innerHTML = '<span class="w-4 h-4 block border-2 border-red-500 border-t-transparent rounded-full animate-spin"></span>';

        try {
          const res = await fetch('/api/delete-ad', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ postId: adId })
          });

          if (res.ok) {
            document.getElementById(`ad-row-${adId}`)?.remove();
          } else {
            const data = await res.json();
            alert(errorMsg + ' ' + data.error);
            button.removeAttribute('disabled');
          }
        } catch (err) {
          alert(unexpectedMsg);
          button.removeAttribute('disabled');
        }
      }
    });
  });
</script>

<script data-copied={t['admin.ads.copied']}>
  const scriptEl = document.currentScript;
  const copiedMsg = scriptEl?.dataset.copied || 'Copied';

  document.querySelectorAll('.copy-id-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text).then(() => {
          const original = btn.innerHTML;
          btn.innerHTML = `<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> ${copiedMsg}`;
          setTimeout(() => { btn.innerHTML = original; }, 1200);
        });
      }
    });
  });
</script>
