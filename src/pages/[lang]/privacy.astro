---
import Layout from "~/layouts/Layout.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import { languages, defaultLang } from "~/i18n/ui";

export const prerender = false;

const { lang = defaultLang } = Astro.params;
const isAr = lang === "ar";

let pageTitle = "Privacy Policy | MeaMart";
let pageDescription = "Privacy policy and data protection for MeaMart platform";
let headerTitle = "Privacy Policy";
let headerDescription =
  "We commit to protecting your personal data and privacy";

if (isAr) {
  pageTitle = "سياسة الخصوصية وحماية البيانات | ميمارت";
  pageDescription = "سياسة خصوصية البيانات وحمايتها لمنصة ميمارت";
  headerTitle = "سياسة الخصوصية وحماية البيانات";
  headerDescription = "نتعهد بحماية بياناتك الشخصية وحفظ خصوصيتك";
}
---

<Layout title={pageTitle} description={pageDescription}>
  <PageHeader title={headerTitle} description={headerDescription} />

  <Container class="pb-24 max-w-7xl">
    <div
      class="prose prose-zinc dark:prose-invert max-w-none text-zinc-600 dark:text-zinc-300"
    >
      {
        isAr && (
          // Arabic Content in Saudi dialect tone
          <div class="space-y-8">
            <p class="text-lg font-medium">آخر تحديث: 30 مايو 2026</p>

            <div>
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
                1. مقدمة
              </h2>
              <p>
                مرحباً بك في ميمارت. نحن نقدر ثقتك ونهتم بخصوصيتك للغاية. توضح
                لك هذه السياسة طريقة جمعنا لبياناتك واستخدامها وحمايتها عند
                زيارتك واستخدامك لمنصتنا.
              </p>
            </div>

            <div>
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
                2. البيانات التي نجمعها
              </h2>
              <p class="mb-4">
                نجمع بعض البيانات الضرورية لتقديم خدمات الإعلانات المبوبة وتسهيل
                التواصل بين المستخدمين وهي:
              </p>
              <ul class="list-disc ps-6 space-y-2">
                <li>
                  بيانات التواصل مثل الاسم، رقم الهاتف، ورقم الواتساب لعرضها في
                  تفاصيل الإعلان.
                </li>
                <li>
                  بيانات الموقع الجغرافي الاختيارية لتسهيل عرض الإعلانات القريبة
                  منك.
                </li>
                <li>
                  البيانات الفنية التلقائية مثل عنوان البروتوكول (IP) ونوع
                  المتصفح لتحسين جودة وأمان المنصة.
                </li>
              </ul>
            </div>

            <div>
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
                3. كيف نستخدم بياناتك
              </h2>
              <p class="mb-4">
                نستخدم البيانات التي نجمعها للأغراض التالية فقط:
              </p>
              <ul class="list-disc ps-6 space-y-2">
                <li>
                  عرض معلومات الاتصال الخاصة بك للمشترين المهتمين بإعلانك.
                </li>
                <li>تخصيص وتحسين تجربة التصفح والبحث في موقعنا.</li>
                <li>منع الاحتيال وضمان التزام المستخدمين بشروط الخدمة.</li>
              </ul>
            </div>

            <div>
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
                4. حماية البيانات ومشاركتها
              </h2>
              <p>
                نحن نلتزم بحماية بياناتك الشخصية ولا نقوم ببيعها أو مشاركتها مع
                أي أطراف ثالثة لأغراض تجارية. يتم مشاركة معلومات الاتصال التي
                تدخلها في الإعلان فقط مع زوار المنصة لتمكينهم من التواصل معك
                لشراء سلعك.
              </p>
            </div>
          </div>
        )
      }
      {
        !isAr && (
          // English Content
          <div class="space-y-8">
            <p class="text-lg font-medium">Last updated: May 30, 2026</p>

            <div>
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
                1. Introduction
              </h2>
              <p>
                Welcome to MeaMart. We value your trust and take your privacy
                seriously. This privacy policy explains how we collect, use, and
                safeguard your personal data when you visit and use our
                classified ads platform.
              </p>
            </div>

            <div>
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
                2. Data We Collect
              </h2>
              <p class="mb-4">
                We collect necessary information to provide our listing services
                and enable communication between users:
              </p>
              <ul class="list-disc ps-6 space-y-2">
                <li>
                  Contact data such as name, phone number, and WhatsApp number
                  to display on your listing.
                </li>
                <li>
                  Optional location data to help display listings close to your
                  current location.
                </li>
                <li>
                  Technical data like IP address and browser type to improve
                  platform security and performance.
                </li>
              </ul>
            </div>

            <div>
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
                3. How We Use Your Data
              </h2>
              <p class="mb-4">
                We only use the collected data for the following purposes:
              </p>
              <ul class="list-disc ps-6 space-y-2">
                <li>
                  Displaying your contact info to buyers interested in your ad.
                </li>
                <li>
                  Customizing and improving your experience on the platform.
                </li>
                <li>
                  Preventing fraud and ensuring compliance with our Terms of
                  Service.
                </li>
              </ul>
            </div>

            <div>
              <h2 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
                4. Data Security and Sharing
              </h2>
              <p>
                We commit to protecting your data and never sell or share it
                with third parties for marketing purposes. Only the contact info
                you explicitly write in your ad form will be shown to platform
                visitors to facilitate buying and selling.
              </p>
            </div>
          </div>
        )
      }
    </div>
  </Container>
</Layout>
