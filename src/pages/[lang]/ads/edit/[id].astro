      generated += `\n💡 Description:\n`;
      generated += `This ${title} is currently available${city ? ` in ${city}` : ""} with premium specifications. An excellent opportunity for those interested in ${category || "featured deals"}.\n\n`;
      generated += `📞 Contact & Next Steps:\n`;
