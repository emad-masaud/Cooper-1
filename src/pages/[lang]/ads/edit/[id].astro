---
import Layout from "~/layouts/Layout.astro";
import Card from "~/components/ui/Card.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import { languages, ui } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import { categoriesStructure } from "~/utils/categories";
import { customFieldsByCategory } from "~/utils/customFields";
import { getMeamartSession, parseAdminSession } from "~/utils/session";
import { createSupabaseAdminServerClient } from "~/utils/supabase";
import { orderedCountries } from "~/utils/countries";
import PhoneInput from "~/components/ui/PhoneInput.astro";
export const prerender = false;

const { lang, id } = Astro.params;
const isAr = lang === "ar";
const t = useTranslations(lang as keyof typeof languages);

// Check session: regular user OR admin
let session = await getMeamartSession(Astro);
if (!session) {
  session = await parseAdminSession(Astro.cookies, Astro.locals);
}
if (!session) {
  return Astro.redirect(
    `/${lang}/login?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
  );
}

const supabase = createSupabaseAdminServerClient(Astro);

let ad: any = null;

const { data: adData, error: adError } = await supabase
  .from("ads")
  .select("*, categories(slug), profiles(*)")
  .eq("id", id)
  .single();

if (!adData) {
  return Astro.redirect(`/${lang}/ads`);
}

const rawImages: string[] = Array.isArray(adData.images) ? adData.images : [];

// Convert Supabase ad format to the format expected by the template
ad = {
  id: adData.id,
  data: {
    listing_title: adData.title,
    listing_description: adData.description,
    listing_price: adData.price,
    listing_currency: adData.currency,
    contact_method: adData.contact_method,
    contact_whatsapp: adData.contact_whatsapp,
    contact_phone: adData.profiles?.contact_phone || adData.contact_phone || "",
    contact_name: adData.contact_name,
    listing_city: adData.city,
    listing_district: adData.district,
    listing_condition: adData.condition,
    categoryKey:
      adData.custom_fields?._category_slug ||
      adData.categories?.slug ||
      "used-items",
    custom_fields: adData.custom_fields || {},
    images: rawImages,
    imageFiles: rawImages.map((url: string) => ({ url })),
    ...adData.custom_fields,
  },
};

// Session already checked above

const contactName = session?.name || "";
const defaultPhone = session?.phone || "";
const isOwner =
  (session.id && session.id === adData.user_id) || session.is_admin;

if (!isOwner) {
  return Astro.redirect(`/${lang}/seller/dashboard`);
}

let sellerAddresses: any[] = [];
if (session) {
  try {
    const userId = session.wp_user_id || session.email;
    const kvKey = `seller_addresses_${userId}`;
    const { kvGet } = await import("~/utils/kv");
    const dataStr = await kvGet(Astro, kvKey);
    if (dataStr) {
      const parsed = JSON.parse(dataStr);
      if (Array.isArray(parsed)) sellerAddresses = parsed;
    }
  } catch (e) {
    console.error("Failed to fetch seller products or addresses:", e);
  }
}
---

<Layout
  title={t["gen.isar._id_.1"]}
  description="تعديل تفاصيل وبيانات إعلانك المنشور"
>
  <PageHeader title={t["gen.isar._id_.2"]} description={t["gen.isar._id_.3"]} />

  <Container class="pb-24 max-w-5xl">
    <div
      class="rounded-3xl border border-zinc-200/50 bg-white/60 p-6 sm:p-10 shadow-xl backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60"
    >
      <!-- Status Messages -->
      <div
        id="form-status"
        class="hidden p-4 mb-6 rounded-2xl text-sm font-semibold"
      >
      </div>

      <form id="edit-ad-form" class="space-y-10">
        <input type="hidden" name="id" value={ad.id} />

        <!-- SECTION 1: Category Selection -->
        <div id="section-category" class="space-y-6">
          <h2
            class="text-xl font-bold text-zinc-800 dark:text-zinc-100 flex items-center gap-2"
          >
            <span
              >{
                t["gen.isar._id_.8"] || (isAr ? "الفئة والتصنيف" : "Category")
              }</span
            >
          </h2>
          <div>
            <label class="form-label">{t["gen.isar._id_.8"]} *</label>
            <select
              name="categoryKey"
              required
              class="form-select font-semibold"
            >
              {
                categoriesStructure.map((group) => (
                  <optgroup label={isAr ? group.labelAr : group.labelEn}>
                    {group.children.map((c) => (
                      <option
                        value={c.key}
                        selected={c.key === ad.data.categoryKey}
                      >
                        {isAr ? c.ar : c.en}
                      </option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
          </div>
        </div>

        <!-- SECTION 2: Custom Fields -->
        <div
          id="section-custom-fields"
          class="rounded-3xl border border-zinc-200/60 bg-zinc-50/50 p-6 sm:p-8 dark:border-zinc-800/60 dark:bg-zinc-950/30 space-y-6"
        >
          <h2
            id="custom-fields-heading"
            class="text-xl font-bold text-zinc-800 dark:text-zinc-100"
          >
            {
              t["ads.create.section.customFields"] ||
                (isAr ? "مواصفات إضافية للقسم" : "Category Specifications")
            }
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
              <div
                id="custom-fields-container"
                class="grid grid-cols-1 md:grid-cols-2 gap-6"
              >
                <!-- Dynamically populated via JS -->
              </div>
            </div>
            <div
              id="custom-fields-metadata"
              data-fields={JSON.stringify(customFieldsByCategory)}
              class="hidden"
            >
            </div>
            <div
              id="ad-custom-fields-values"
              data-values={JSON.stringify(ad.data.custom_fields || {})}
              class="hidden"
            >
            </div>
            <div
              id="ad-existing-images-values"
              data-images={JSON.stringify(ad.data.images || [])}
              class="hidden"
            >
            </div>
          </div>
        </div>

        <!-- SECTION 3: Price & Condition -->
        <div
          id="section-price-catalog"
          class="rounded-3xl border border-zinc-200/60 bg-zinc-50/50 p-6 sm:p-8 dark:border-zinc-800/60 dark:bg-zinc-950/30 space-y-6"
        >
          <h2 class="text-xl font-bold text-zinc-800 dark:text-zinc-100">
            {
              t["ads.create.dynamic.12"] ||
                (isAr ? "السعر والحالة" : "Price & Condition")
            }
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div id="price-container">
              <label id="price-label" class="form-label"
                >{t["gen.isar._id_.14"] || (isAr ? "السعر" : "Price")} *</label
              >
              <input
                type="number"
                name="listing_price"
                id="price-input"
                required
                min="0"
                value={ad.data.listing_price}
                class="form-input"
              />
            </div>

            <div id="currency-container">
              <label id="currency-label" class="form-label"
                >{t["gen.isar._id_.16"] || (isAr ? "العملة" : "Currency")} *</label
              >
              <select
                name="listing_currency"
                id="currency-input"
                required
                class="form-select"
              >
                <option
                  value="SAR"
                  selected={ad.data.listing_currency === "SAR"}>﷼ (SAR)</option
                >
                <option
                  value="USD"
                  selected={ad.data.listing_currency === "USD"}>$ (USD)</option
                >
                <option
                  value="EUR"
                  selected={ad.data.listing_currency === "EUR"}>€ (EUR)</option
                >
              </select>
            </div>
          </div>
        </div>

        <!-- SECTION 4: Media & Images -->
        <div
          id="section-media"
          class="rounded-3xl border border-zinc-200/60 bg-zinc-50/50 p-6 sm:p-8 dark:border-zinc-800/60 dark:bg-zinc-950/30 space-y-6"
        >
          <h2 class="text-xl font-bold text-zinc-800 dark:text-zinc-100">
            {
              t["ads.create.section.media"] ||
                (isAr ? "الصور والفيديو" : "Media & Photos")
            }
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
              <label
                class="block text-xs font-bold text-zinc-600 dark:text-zinc-400 mb-3"
              >
                {
                  t["gen.isar._id_.41"] ||
                    (isAr
                      ? "إضافة أو تحديث صور الإعلان"
                      : "Add / Update Photos")
                }
              </label>
              <div
                id="image-drop-zone"
                class="relative w-full max-w-[220px] aspect-square mx-auto rounded-3xl border-2 border-dashed border-zinc-300 bg-white/60 dark:border-zinc-700 dark:bg-zinc-900/60 transition-all duration-200 cursor-pointer hover:border-primary hover:bg-primary/5 flex flex-col items-center justify-center overflow-hidden"
              >
                <input
                  type="file"
                  id="ad-image-input"
                  accept="image/*,.pdf,.md,.mdx"
                  multiple
                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                />
                <div
                  id="drop-placeholder"
                  class="flex flex-col items-center justify-center gap-2 py-6 px-4 text-center pointer-events-none"
                >
                  <div
                    class="w-12 h-12 rounded-2xl bg-primary/10 dark:bg-primary/20 flex items-center justify-center text-primary"
                  >
                    <svg
                      class="w-6 h-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4.5v15m7.5-7.5h-15"></path></svg
                    >
                  </div>
                  <p class="text-xs font-bold text-zinc-700 dark:text-zinc-200">
                    {
                      t["ads.create.media.dropzone.title"] ||
                        (isAr ? "اختر صور جديدة" : "Select new photos")
                    }
                  </p>
                </div>
                <div
                  id="image-previews"
                  class="hidden p-3 grid grid-cols-5 gap-2 w-full h-full overflow-y-auto"
                >
                </div>
              </div>
              <button
                type="button"
                id="add-more-photos-btn"
                class="hidden mt-3 mx-auto flex items-center justify-center gap-1.5 text-xs font-bold text-primary bg-primary/10 hover:bg-primary/20 px-4 py-2 rounded-xl transition-colors"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 4.5v15m7.5-7.5h-15"></path></svg
                >
                {isAr ? "إضافة صور أخرى" : "Add more photos"}
              </button>
            </div>

            <div class="md:col-span-2">
              <label class="form-label"
                >{
                  t["ads.create.field.video.label"] ||
                    (isAr ? "رابط فيديو (يوتيوب)" : "Video URL")
                }</label
              >
              <input
                type="text"
                name="video_url"
                id="video-url-input"
                value={ad.data.video_url || ""}
                placeholder="https://youtube.com/watch?v=..."
                class="form-input"
              />
            </div>
          </div>
        </div>

        <!-- SECTION 5: Location -->
        <div
          id="section-location"
          class="rounded-3xl border border-zinc-200/60 bg-zinc-50/50 p-6 sm:p-8 dark:border-zinc-800/60 dark:bg-zinc-950/30 space-y-6"
        >
          <h2 class="text-xl font-bold text-zinc-800 dark:text-zinc-100">
            {
              t["ads.create.section.location"] ||
                (isAr ? "الموقع الجغرافي" : "Location")
            }
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
              Array.isArray(sellerAddresses) && sellerAddresses.length > 0 && (
                <div class="md:col-span-2">
                  <label class="block text-xs font-bold text-primary mb-2">
                    {t["ads.create.addresses.label"] ||
                      (isAr
                        ? "اختر من عناويني المحفوظة"
                        : "Select saved address")}
                  </label>
                  <select
                    id="saved-address-select"
                    class="w-full rounded-full border border-primary/20 bg-primary/5 py-3 px-4 text-sm font-semibold text-primary outline-hidden focus:border-primary"
                  >
                    <option value="">
                      {t["ads.create.addresses.placeholder"] ||
                        (isAr ? "-- اختر عنوان --" : "-- Select address --")}
                    </option>
                    {sellerAddresses.map((addr: any) => (
                      <option
                        value={addr.id}
                        data-address={addr.address}
                        data-city={addr.city}
                        data-district={addr.district}
                        data-lat={addr.lat}
                        data-lng={addr.lng}
                      >
                        {addr.name} ({addr.city} - {addr.district})
                      </option>
                    ))}
                  </select>
                </div>
              )
            }

            <div class="md:col-span-2">
              <label class="form-label"
                >{
                  t["ads.create.field.address.label"] ||
                    (isAr ? "العنوان بالتفصيل" : "Detailed Address")
                }</label
              >
              <input
                type="text"
                name="listing_address"
                value={ad.data.listing_address || ""}
                id="address-input"
                placeholder={t["ads.create.field.address.placeholder"] || ""}
                class="form-input"
              />
            </div>

            <div class="md:col-span-2" id="map-container-wrapper">
              <div
                id="map-container"
                class="h-64 w-full rounded-2xl border border-zinc-200 dark:border-zinc-800 overflow-hidden shadow-inner bg-zinc-100 dark:bg-zinc-950"
              >
              </div>
              <!-- Hidden Coordinate Fields -->
              <input
                type="hidden"
                name="listing_latitude"
                id="lat-input"
                value={ad.data.listing_latitude || ""}
              />
              <input
                type="hidden"
                name="listing_longitude"
                id="lng-input"
                value={ad.data.listing_longitude || ""}
              />
              <input
                type="hidden"
                name="listing_place_id"
                id="place-id-input"
                value={ad.data.listing_place_id || ""}
              />
              <input
                type="hidden"
                name="listing_gmaps_url"
                id="gmaps-url-input"
                value={ad.data.listing_gmaps_url || ""}
              />
              <div
                id="gmaps-key"
                data-key={import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
                  process.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
                  "AIzaSyCDwx8Lxi8TTwvzxnGwkCHc6D_jzFaJyLU"}
                data-lang={isAr ? "ar" : "en"}
                class="hidden"
              >
              </div>
            </div>

            <div>
              <label class="form-label"
                >{
                  t["ads.create.field.country.label"] ||
                    (isAr ? "الدولة" : "Country")
                }</label
              >
              <select
                name="listing_country"
                id="country-input"
                class="form-select"
              >
                {
                  orderedCountries.map((c) => (
                    <option
                      value={c.en}
                      data-code={c.code}
                      selected={
                        c.code === "SA" || c.en === ad.data.listing_country
                      }
                    >
                      {isAr ? c.ar : c.en}
                    </option>
                  ))
                }
              </select>
            </div>

            <div>
              <label class="form-label"
                >{
                  t["ads.create.field.city.label"] ||
                    (isAr ? "المدينة" : "City")
                }</label
              >
              <input
                type="text"
                name="listing_city"
                value={ad.data.listing_city || ""}
                id="city-input"
                placeholder={t["ads.create.field.city.placeholder"] || ""}
                class="form-input"
              />
            </div>

            <div>
              <label class="form-label"
                >{
                  t["ads.create.field.district.label"] ||
                    (isAr ? "الحي" : "District")
                }</label
              >
              <input
                type="text"
                name="listing_district"
                value={ad.data.listing_district || ""}
                id="district-input"
                placeholder={t["ads.create.field.district.placeholder"] || ""}
                class="form-input"
              />
            </div>

            <div>
              <label class="form-label"
                >{
                  t["ads.create.field.street.label"] ||
                    (isAr ? "الشارع" : "Street")
                }</label
              >
              <input
                type="text"
                name="listing_street"
                value={ad.data.listing_street || ""}
                id="street-input"
                placeholder={t["ads.create.field.street.placeholder"] || ""}
                class="form-input"
              />
            </div>
          </div>
        </div>

        <!-- SECTION 6: Title & Description -->
        <div
          id="section-description"
          class="rounded-3xl border border-primary/20 bg-primary/5 p-6 sm:p-8 space-y-6"
        >
          <div
            class="flex items-center justify-between pb-3 border-b border-primary/15"
          >
            <h2 class="text-xl font-bold text-primary flex items-center gap-2">
              <span
                >{
                  t["ads.create.field.description.label"] ||
                    (isAr ? "العنوان والوصف" : "Title & Description")
                }</span
              >
            </h2>
          </div>
          <div class="space-y-4">
            <div>
              <label
                class="form-label text-xs font-semibold text-zinc-600 dark:text-zinc-400 mb-1 block"
              >
                {
                  t["ads.create.field.title.label"] ||
                    (isAr ? "عنوان الإعلان" : "Ad Title")
                } *
              </label>
              <input
                type="text"
                name="listing_title"
                id="ad-title"
                value={ad.data.listing_title || ""}
                class="form-input text-lg font-bold"
                required
              />
            </div>
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label
                  class="form-label text-xs font-semibold text-zinc-600 dark:text-zinc-400 block mb-0"
                >
                  {
                    t["ads.create.field.description.label"] ||
                      (isAr ? "وصف الإعلان" : "Ad Description")
                  } *
                </label>
                <button
                  type="button"
                  id="refresh-description-btn"
                  class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full bg-primary/10 text-primary hover:bg-primary hover:text-white transition-all shadow-sm active:scale-95 cursor-pointer"
                  title={isAr
                    ? "تحديث الوصف حسب البيانات والمواصفات المضافة حديثاً"
                    : "Refresh description with newly added details"}
                >
                  <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    ></path>
                  </svg>
                  <span
                    >{
                      isAr ? "تحديث الوصف بالذكاء" : "Refresh AI Description"
                    }</span
                  >
                </button>
              </div>
              <textarea
                name="listing_description"
                id="listing-description-textarea"
                class="form-textarea min-h-[140px] text-sm leading-relaxed"
                required>{ad.data.listing_description || ""}</textarea
              >
            </div>
          </div>
        </div>

        <!-- SECTION 7: Contact Information -->
        <div
          id="section-main-fields"
          class="rounded-3xl border border-zinc-200/60 bg-zinc-50/50 p-6 sm:p-8 dark:border-zinc-800/60 dark:bg-zinc-950/30 space-y-6"
        >
          <h2 class="text-xl font-bold text-zinc-800 dark:text-zinc-100">
            {
              t["ads.edit.contactInfo"] ||
                (isAr ? "معلومات التواصل" : "Contact Information")
            }
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="form-label"
                >{
                  t["ads.create.field.contactName.label"] ||
                    (isAr ? "اسم المعلن" : "Contact Name")
                } *</label
              >
              <input
                type="text"
                name="contact_name"
                required
                value={ad.data.contact_name || contactName}
                placeholder={t["ads.create.field.contactName.placeholder"] ||
                  ""}
                class="form-input"
              />
            </div>

            <PhoneInput
              name="contact_whatsapp"
              label={t["ads.edit.whatsappNumber"] ||
                (isAr ? "رقم الواتساب" : "WhatsApp Number")}
              value={ad.data.contact_whatsapp || defaultPhone}
              required={true}
            />
          </div>
        </div>

        <!-- Submit Button -->
        <div
          class="pt-6 border-t border-zinc-200 dark:border-zinc-800 flex justify-center"
        >
          <button
            type="submit"
            id="submit-btn"
            class="w-full sm:w-1/2 rounded-full bg-primary py-4 text-base font-bold text-white shadow-lg transition-all hover:bg-primary/90 hover:scale-[1.01] active:scale-[0.99]"
          >
            {t["gen.isar._id_.42"] || (isAr ? "حفظ التعديلات" : "Save Changes")}
          </button>
        </div>
      </form>
    </div>
  </Container>
</Layout>

<script is:inline define:vars={{ translations: ui[lang as string] || ui["en"] }}
>
  window.__meamartTranslations = translations;
</script>
<script>
  const t = (window as any).__meamartTranslations || {};
  const form = document.getElementById("edit-ad-form") as HTMLFormElement;
  const statusDiv = document.getElementById("form-status") as HTMLDivElement;

  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  const descTextArea = document.getElementById(
    "listing-description-textarea",
  ) as HTMLTextAreaElement;

  if (descTextArea) {
    if (descTextArea.value.trim() !== "") {
      descTextArea.dataset.userEdited = "true";
    }
    descTextArea.addEventListener("input", () => {
      if (descTextArea.value.trim() !== "") {
        descTextArea.dataset.userEdited = "true";
      } else {
        descTextArea.removeAttribute("data-user-edited");
      }
    });
  }

  const refreshDescBtn = document.getElementById("refresh-description-btn");
  if (refreshDescBtn) {
    refreshDescBtn.addEventListener("click", () => {
      if (descTextArea) descTextArea.removeAttribute("data-user-edited");
      autoGenerateMetaDescription(true);
      autoGenerateTitle();
      if (descTextArea) {
        descTextArea.classList.add("ring-2", "ring-primary", "bg-primary/5");
        setTimeout(
          () =>
            descTextArea?.classList.remove(
              "ring-2",
              "ring-primary",
              "bg-primary/5",
            ),
          1000,
        );
      }
    });
  }

  function autoGenerateMetaDescription(force = false) {
    if (!descTextArea || (!force && descTextArea.dataset.userEdited === "true"))
      return;

    const titleInput = form.querySelector(
      '[name="listing_title"]',
    ) as HTMLInputElement;
    const priceInput = document.getElementById(
      "price-input",
    ) as HTMLInputElement;
    const cityInput = document.getElementById("city-input") as HTMLInputElement;
    const districtInput = document.getElementById(
      "district-input",
