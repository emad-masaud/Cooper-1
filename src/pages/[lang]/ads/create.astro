<script is:inline>
  // URL Pre-fill: Read query params and auto-fill form fields
  document.addEventListener("DOMContentLoaded", function () {
    var params = new URLSearchParams(window.location.search);
    if (params.toString() === "") return;

    var fieldMap = {
      title: ['input[name="listing_title"]', "#ad-title"],
      listing_title: ['input[name="listing_title"]', "#ad-title"],
      desc: [
        'textarea[name="listing_description"]',
        "#listing-description-textarea",
      ],
      description: [
        'textarea[name="listing_description"]',
        "#listing-description-textarea",
      ],
      price: ['input[name="listing_price"]', "#price-input", "#ad-price"],
      listing_price: [
        'input[name="listing_price"]',
        "#price-input",
        "#ad-price",
      ],
      currency: ['select[name="listing_currency"]'],
      listing_currency: ['select[name="listing_currency"]'],
      condition: ['select[name="listing_condition"]', "#condition-input"],
      listing_condition: [
        'select[name="listing_condition"]',
        "#condition-input",
      ],
      city: [
        'select[name="listing_city"]',
        'input[name="listing_city"]',
        "#city-input",
        "#ad-city",
      ],
      listing_city: [
        'select[name="listing_city"]',
        'input[name="listing_city"]',
        "#city-input",
        "#ad-city",
      ],
      district: ['input[name="listing_district"]'],
      listing_district: ['input[name="listing_district"]'],
      categoryKey: ['select[name="categoryKey"]', "#real-category-select"],
      category: ['select[name="categoryKey"]', "#real-category-select"],
      name: ['input[name="contact_name"]'],
      contact_name: ['input[name="contact_name"]'],
      whatsapp: ['input[name="contact_whatsapp"]'],
      contact_whatsapp: ['input[name="contact_whatsapp"]'],
      phone: ['input[name="contact_phone"]'],
      contact_phone: ['input[name="contact_phone"]'],
      contact_method: ['select[name="contact_method"]'],
    };

    function tryFill(selectors, value) {
      if (!value) return false;
      for (var i = 0; i < selectors.length; i++) {
        var el = document.querySelector(selectors[i]);
        if (el) {
          el.value = decodeURIComponent(value);
          el.dispatchEvent(new Event("input", { bubbles: true }));
          el.dispatchEvent(new Event("change", { bubbles: true }));
          if (el.hasAttribute("readonly")) el.removeAttribute("readonly");
          if (el.classList.contains("cursor-not-allowed"))
            el.classList.remove("cursor-not-allowed");
          if (el.classList.contains("opacity-80"))
            el.classList.remove("opacity-80");
          return true;
        }
      }
      return false;
    }

    var filled = false;
    var retryCount = 0;
    function attemptFill() {
      var anyFilled = false;
      params.forEach(function (value, key) {
        var selectors = fieldMap[key];
        if (selectors) {
          if (tryFill(selectors, value)) anyFilled = true;
        }
        // Support custom fields: custom_field_xxx=value
        if (key.startsWith("custom_field_")) {
          tryFill(
            [
              'input[name="' + key + '"]',
              'select[name="' + key + '"]',
              'textarea[name="' + key + '"]',
            ],
            value,
          );
        }
      });
      if (anyFilled) {
        filled = true;
        // Dispatch prefill event for IntentWorkflow
        window.dispatchEvent(
          new CustomEvent("meamart:url_prefilled", {
            detail: Object.fromEntries(params),
          }),
        );
      } else if (retryCount < 5) {
        retryCount++;
        setTimeout(attemptFill, 500);
      }
    }

    // Wait a tick for dynamic fields to render
    setTimeout(attemptFill, 300);
  });
</script>
