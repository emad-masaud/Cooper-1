---
import Layout from "~/layouts/Layout.astro";
import Card from "~/components/ui/Card.astro";
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import Button from "~/components/ui/Button.astro";
import PhoneInput from "~/components/ui/PhoneInput.astro";
import { getMeamartSession } from "~/utils/session";
import { createSupabaseAdminServerClient } from "~/utils/supabase";
import { languages, ui } from "~/i18n/ui";
import { useTranslations } from "~/i18n/utils";
import { categoriesStructure, categoryStyles } from "~/utils/categories";
import {
  Car,
  Home,
  Briefcase,
  Wrench,
  Smartphone,
  Sofa,
  ShoppingBag,
  Baby,
  PawPrint,
  Dumbbell,
  Building2,
  UtensilsCrossed,
  Plane,
  Package,
  MapPin,
  Tag,
  User,
} from "lucide-react";
import { customFieldsByCategory } from "~/utils/customFields";
import { orderedCountries } from "~/utils/countries";

export const prerender = false;

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof languages);
const isAr = lang === "ar";

const session = await getMeamartSession(Astro);
if (!session) {
  return Astro.redirect(
    `/${lang}/login?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
  );
}

const iconComponents: Record<string, any> = {
  Car,
  Home,
  Briefcase,
  Wrench,
  Smartphone,
  Sofa,
  ShoppingBag,
  Baby,
  PawPrint,
  Dumbbell,
  Building2,
  UtensilsCrossed,
  Plane,
  Package,
  MapPin,
};

const adminClient = createSupabaseAdminServerClient(Astro);
const [addressesResult, productsResult, profileResult] = await Promise.all([
  adminClient
    .from("seller_addresses")
    .select("*")
    .eq("seller_id", session.id)
    .order("created_at", { ascending: false }),
  adminClient
    .from("products")
    .select("id, name, sku")
    .eq("seller_id", session.id)
    .eq("status", "active")
    .order("created_at", { ascending: false }),
  adminClient
    .from("profiles")
    .select("first_name, last_name, phone_number")
    .eq("id", session.id)
    .single(),
]);
const sellerAddresses = addressesResult.data || [];
const sellerProducts = productsResult.data || [];
const profile = profileResult.data || {};
const contactName =
  [profile.first_name, profile.last_name].filter(Boolean).join(" ") ||
  session.username ||
  "";
const defaultPhone = profile.phone_number || session.phone_number || "";
---

<Layout
  title={t["ads.create.page.title"]}
  description={t["ads.create.page.description"]}
  hideMobileBottomNav={true}
>
  <PageHeader
    title={t["ads.create.header.title"]}
    description={t["ads.create.header.description"]}
  />

  <Container class="pb-32 sm:pb-24 max-w-3xl">
    <!-- Status Messages -->
    <div
      id="form-status"
      dir={t["gen.isar.create.1"]}
      class={t["gen.isar.create.2"]}
    >
    </div>

    <!-- Stepper Navigation -->
    <div
      class="mb-8 bg-white/40 dark:bg-zinc-900/40 p-4 rounded-3xl border border-zinc-200/50 dark:border-zinc-800/50 backdrop-blur-md"
      id="create-ad-stepper"
    >
      <!-- Progress Bar -->
      <div
        class="relative w-full h-2 bg-zinc-200 dark:bg-zinc-800 rounded-full mb-4 overflow-hidden"
      >
        <div
          id="step-progress-bar"
          class="absolute top-0 bottom-0 start-0 bg-primary rounded-full transition-all duration-300"
          style="width: 16.6%;"
        >
        </div>
      </div>
      <!-- Steps Labels -->
      <div
        class="flex justify-between items-center text-xs font-bold text-zinc-500"
      >
        <div
          class="step-indicator active flex items-center gap-1.5 text-primary cursor-pointer"
          data-step="1"
        >
          <span
            class="w-6 h-6 rounded-full bg-primary text-white flex items-center justify-center text-[10px]"
            >1</span
          >
          <span class="hidden sm:inline">{t["ads.create.dynamic.1"]}</span>
        </div>
        <div
          class="step-indicator flex items-center gap-1.5 cursor-pointer"
          data-step="2"
        >
          <span
            class="w-6 h-6 rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-650 dark:text-zinc-400 flex items-center justify-center text-[10px]"
            >2</span
          >
          <span class="hidden sm:inline">{t["ads.create.dynamic.2"]}</span>
        </div>
        <div
          class="step-indicator flex items-center gap-1.5 cursor-pointer"
          data-step="3"
        >
          <span
            class="w-6 h-6 rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-650 dark:text-zinc-400 flex items-center justify-center text-[10px]"
            >3</span
          >
          <span class="hidden sm:inline">{t["ads.create.dynamic.3"]}</span>
        </div>
        <div
          class="step-indicator flex items-center gap-1.5 cursor-pointer"
          data-step="4"
        >
          <span
            class="w-6 h-6 rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-650 dark:text-zinc-400 flex items-center justify-center text-[10px]"
            >4</span
          >
          <span class="hidden sm:inline">{t["ads.create.dynamic.4"]}</span>
        </div>
        <div
          class="step-indicator flex items-center gap-1.5 cursor-pointer"
          data-step="5"
        >
          <span
            class="w-6 h-6 rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-650 dark:text-zinc-400 flex items-center justify-center text-[10px]"
            >5</span
          >
          <span class="hidden sm:inline">{t["ads.create.dynamic.5"]}</span>
        </div>
        <div
          class="step-indicator flex items-center gap-1.5 cursor-pointer"
          data-step="6"
        >
          <span
            class="w-6 h-6 rounded-full bg-zinc-200 dark:bg-zinc-800 text-zinc-650 dark:text-zinc-400 flex items-center justify-center text-[10px]"
            >6</span
          >
          <span class="hidden sm:inline">{t["ads.create.dynamic.6"]}</span>
        </div>
      </div>
      <!-- Mobile Only Step Text -->
      <div
        class="sm:hidden text-center text-xs font-bold text-primary mt-2"
        id="step-mobile-label"
      >
        {t["ads.create.step.mobile.1"]}
      </div>
    </div>

    <form id="create-ad-form" class="space-y-6 sm:space-y-8">
      <!-- Manual Ad Creation -->

      <!-- SECTION 2: Category Selection -->
      <div
        id="section-additional"
        class="rounded-3xl border border-zinc-200/50 bg-white/60 p-5 sm:p-8 shadow-lg backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60"
      >
        <h2
          class="text-xl font-bold text-zinc-800 dark:text-zinc-100 mb-6 flex items-center gap-2"
        >
          <Tag className="h-5 w-5 text-primary" />
          <span>{t["ads.create.dynamic.45"]}</span>
        </h2>

        {/* Parent Categories Grid */}
        <div
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 mb-6"
        >
          {
            categoriesStructure.map((group) => {
              const IconComponent = iconComponents[group.icon] || Tag;
              const style = categoryStyles[group.key] || {
                bg: "bg-zinc-50 dark:bg-zinc-800/30",
                text: "text-zinc-650 dark:text-zinc-300",
                border: "border-zinc-150 dark:border-zinc-800/30",
                hoverBg: "group-hover:bg-zinc-600 dark:group-hover:bg-zinc-500",
                hoverText: "group-hover:text-white",
              };

              return (
                <button
                  type="button"
                  data-category={group.key}
                  class="parent-category-card group flex flex-col items-center justify-center rounded-2xl border border-zinc-200/50 bg-white dark:border-zinc-800/50 dark:bg-zinc-950/40 p-4 text-center transition-all duration-300 hover:border-primary/20 hover:shadow-md cursor-pointer hover:scale-[1.02]"
                >
                  <div
                    class={`mb-3 flex h-12 w-12 items-center justify-center rounded-full border ${style.bg} ${style.text} ${style.border} transition-all duration-300 ${style.hoverBg} ${style.hoverText} shadow-xs icon-container`}
                  >
                    <IconComponent className="h-5 w-5 transition-transform duration-300 group-hover:scale-110" />
                  </div>
                  <span class="text-xs font-bold text-zinc-700 dark:text-zinc-300 truncate max-w-full">
                    {isAr ? group.labelAr : group.labelEn}
                  </span>
                </button>
              );
            })
          }
        </div>

        {/* Subcategories Container */}
        <div
          id="subcategories-container"
          class="hidden border-t border-zinc-200/50 dark:border-zinc-800/50 pt-6"
        >
          <label
            class="block text-xs font-extrabold text-zinc-500 dark:text-zinc-400 mb-3 uppercase tracking-wider"
          >
            {t["ads.create.dynamic.46"]} *
          </label>
          <div
            id="subcategories-grid"
            class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3"
          >
            {/* Populated dynamically via JavaScript */}
          </div>
        </div>

        {
          /* Hidden original select to maintain compatibility with all JS listeners */
        }
        <select
          name="categoryKey"
          id="real-category-select"
          required
          class="hidden"
        >
          <option value="" disabled selected>اختر القسم</option>
          {
            categoriesStructure.map((group) => (
              <optgroup
                label={isAr ? group.labelAr : group.labelEn}
                data-parent={group.key}
              >
                {group.children.map((c) => (
                  <option value={c.key} data-parent={group.key}>
                    {isAr ? c.ar : c.en}
                  </option>
                ))}
              </optgroup>
            ))
          }
        </select>
        <input type="hidden" name="listing_status" value="active" />
      </div>

      <!-- SECTION 2: Custom Fields -->
      <div
        id="section-custom-fields"
        class="rounded-3xl border border-zinc-200/50 bg-white/60 p-5 sm:p-8 shadow-lg backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60"
      >
        <h2 class="text-xl font-bold text-zinc-800 dark:text-zinc-100 mb-6">
          {t["ads.create.section.customFields"]}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Category Specific Fields Container -->
          <div class="md:col-span-2">
            <h3
              class="text-sm font-bold text-zinc-800 dark:text-zinc-200 mb-4 hidden"
              id="custom-fields-heading"
            >
              {t["ads.create.field.additionalSpecs"]}
            </h3>
            <div
              id="custom-fields-container"
              class="grid grid-cols-1 md:grid-cols-2 gap-6"
            >
              <!-- Dynamically populated via JS -->
            </div>
          </div>

          <div id="custom-fields-metadata" class="hidden"></div>

          <!-- Custom Key-Value Fields -->
          <div class="md:col-span-2 border-t border-zinc-200/30 pt-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-bold text-zinc-800 dark:text-zinc-200">
                {t["ads.create.field.customFields.label"]}
              </h3>
              <button
                type="button"
                id="add-custom-field-btn"
                class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary hover:bg-primary/20 transition-colors dark:bg-primary/20 dark:hover:bg-primary/30"
              >
                {t["ads.create.field.customFields.addButton"]}
              </button>
            </div>
            <div id="custom-key-value-container" class="space-y-3">
              <!-- Dynamically added key-value pairs -->
            </div>
            <p class="text-xs text-zinc-550 dark:text-zinc-400 mt-2">
              {t["ads.create.field.customFields.hint"]}
            </p>
          </div>

          <!-- Hidden Coordinate Fields -->
          <input type="hidden" name="listing_latitude" id="lat-input" />
          <input type="hidden" name="listing_longitude" id="lng-input" />
          <input type="hidden" name="listing_place_id" id="place-id-input" />
          <input type="hidden" name="listing_gmaps_url" id="gmaps-url-input" />
          <div
            id="gmaps-key"
            data-key={import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
              process.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
              process.env.GOOGLE_MAPS_API_KEY ||
              "AIzaSyCDwx8Lxi8TTwvzxnGwkCHc6D_jzFaJyLU"}
            data-lang={t["gen.isar.create.8"]}
            class="hidden"
          >
          </div>
        </div>

        <!-- Checkboxes -->
        <div
          class="flex items-center gap-6 mt-6 pt-4 border-t border-zinc-200/30 dark:border-zinc-800/50"
        >
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="checkbox"
              name="listing_negotiable"
              class="rounded border-zinc-300 text-primary focus:ring-primary dark:border-zinc-700"
            />
            <span class="text-xs font-bold text-zinc-600 dark:text-zinc-400">
              {t["ads.create.checkbox.negotiable"]}
            </span>
          </label>
        </div>
      </div>

      <!-- SECTION 3: Price & Catalog -->
      <div
        id="section-price-catalog"
        class="hidden rounded-3xl border border-zinc-200/50 bg-white/60 p-5 sm:p-8 shadow-lg backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60"
      >
        <h2 class="text-xl font-bold text-zinc-800 dark:text-zinc-100 mb-6">
          {t["ads.create.dynamic.12"]}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div id="catalog-products-metadata" class="hidden"></div>

          <!-- Alert when price is not needed (e.g., jobs) -->
          <div
            id="price-not-needed-alert"
            class="md:col-span-2 p-6 rounded-full border border-primary/20 bg-primary/5 text-primary text-center font-bold hidden text-xs sm:text-sm"
          >
            {
              t["ads.create.priceNotNeeded"] ||
                (isAr
                  ? "هذا القسم لا يتطلب تحديد السعر."
                  : "This category does not require a price.")
            }
          </div>

          <!-- Catalog Product Search Dropdown -->
          <div
            class="md:col-span-2 rounded-full border border-primary/20 bg-primary/5 p-4 hidden"
            id="catalog-product-selector-container"
          >
            <label
              class="block text-xs font-bold text-primary mb-2 flex items-center gap-1.5"
            >
              <svg
                class="w-4 h-4 text-primary animate-pulse"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <span>{t["ads.create.catalog.search.label"]}</span>
            </label>

            <div class="relative">
              <input
                type="text"
                id="catalog-search-input"
                placeholder={t["ads.create.catalog.search.placeholder"]}
                class="w-full rounded-xl border border-zinc-200 bg-white/80 py-2.5 px-4 text-sm outline-hidden focus:border-primary focus:ring-1 focus:ring-primary dark:border-zinc-800 dark:bg-zinc-900/80 dark:text-zinc-50"
                autocomplete="off"
              />
              <div
                id="catalog-search-results"
                class="absolute z-50 left-0 right-0 mt-1 max-h-60 overflow-y-auto rounded-xl border border-zinc-200 bg-white shadow-lg dark:border-zinc-800 dark:bg-zinc-950 hidden"
              >
                <!-- Options will be populated here -->
              </div>
            </div>

            <div
              id="selected-product-badge"
              class="hidden mt-2 items-center justify-between bg-primary/10 text-primary rounded-xl px-3 py-2.5 text-xs font-bold"
            >
              <div class="flex items-center gap-2">
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span id="selected-product-name"></span>
              </div>
              <button
                type="button"
                id="clear-selected-product"
                class="text-red-500 hover:text-red-755 font-bold text-xs select-none cursor-pointer border border-red-200 bg-red-50 dark:border-red-900/30 dark:bg-red-500/10 px-2.5 py-1 rounded-lg hover:bg-red-100 dark:hover:bg-red-500/20 transition-all"
              >
                {t["ads.create.catalog.manualEdit"]}
              </button>
            </div>
          </div>

          <!-- Price -->
          <div
            id="price-container"
            class="w-full"
            data-default-label={t["ads.create.field.price.label"]}
            data-salary-label={t["ads.create.field.salary.label"]}
            data-optional-text={t["ads.create.optional"]}
          >
            <label id="price-label" class="form-label">
              {t["ads.create.field.price.label"]} *
            </label>
            <input
              type="number"
              id="price-input"
              name="listing_price"
              required
              min="0"
              placeholder="4300"
              class="form-input"
            />
          </div>

          <!-- Currency -->
          <div
            id="currency-container"
            class="w-full"
            data-default-label={t["ads.create.field.currency.label"]}
          >
            <label id="currency-label" class="form-label">
              {t["ads.create.field.currency.label"]} *
            </label>
            <select
              name="listing_currency"
              id="currency-input"
              required
              class="form-select"
            >
              <option value="SAR">﷼ (SAR)</option>
              <option value="USD">$ (USD)</option>
              <option value="EUR">€ (EUR)</option>
            </select>
          </div>

          <!-- Delivery Service Options Section -->
          <div
            class="md:col-span-2 border-t border-zinc-200/50 dark:border-zinc-800/50 pt-6 mt-4 space-y-4"
          >
            <h3
              class="text-sm font-bold text-zinc-850 dark:text-zinc-150 flex items-center gap-1.5"
            >
              <svg
                class="w-4 h-4 text-primary"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124l-.318-5.085a2.25 2.25 0 0 0-2.23-2.112h-3.375V9.75m0 9H18.75m-6 0v-6h-3.75V15m0-6h1.125c.621 0 1.129.504 1.09 1.124l-.318 5.085a2.25 2.25 0 0 0-2.23 2.112h-3.375v-1.125m-3 0h3.375a1.125 1.125 0 0 0 1.125-1.125V9.75M9 9.75H3.375c-.621 0-1.129.504-1.09 1.124l.318 5.085a2.25 2.25 0 0 0 2.23 2.112h3.375v-1.125"
                ></path></svg
              >
              <span>{t["ads.create.dynamic.13"]}</span>
            </h3>

            <label class="flex items-center gap-2 cursor-pointer select-none">
              <input
                type="checkbox"
                id="offers-delivery-checkbox"
                name="offers_delivery"
                class="rounded-sm border-zinc-300 dark:border-zinc-700 text-primary focus:ring-primary focus:ring-offset-0 w-4.5 h-4.5"
              />
              <span class="text-xs font-bold text-zinc-700 dark:text-zinc-300"
                >{t["ads.create.dynamic.14"]}</span
              >
            </label>

            <!-- Expanded Delivery Fields -->
            <div
              id="delivery-config-fields"
              class="hidden grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 rounded-2xl border border-zinc-150 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 animate-in fade-in duration-300"
            >
              <div>
                <label
                  class="block text-xs font-bold text-zinc-650 dark:text-zinc-400 mb-1"
                  >{t["ads.create.dynamic.15"]}</label
                >
                <select
                  name="delivery_scope"
                  id="delivery-scope-select"
                  class="w-full rounded-full border border-zinc-200 bg-white/80 py-2.5 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50"
                >
                  <option value="ad" selected
                    >{t["ads.create.dynamic.16"]}</option
                  >
                  <option value="seller_all"
                    >{t["ads.create.dynamic.17"]}</option
                  >
                  <option value="public_all"
                    >{t["ads.create.dynamic.18"]}</option
                  >
                </select>
              </div>

              <div>
                <label
                  class="block text-xs font-bold text-zinc-650 dark:text-zinc-400 mb-1"
                  >{t["ads.create.dynamic.19"]}</label
                >
                <input
                  type="text"
                  name="delivery_vehicle_type"
                  id="delivery-vehicle-input"
                  class="w-full rounded-full border border-zinc-200 bg-white/80 py-2.5 px-4 text-xs dark:border-zinc-700 dark:bg-zinc-950/80 dark:text-zinc-50"
                  placeholder={t["ads.create.dynamic.20"]}
                />
              </div>

              <div>
                <label
                  class="block text-xs font-bold text-zinc-650 dark:text-zinc-400 mb-1"
                  >{t["ads.create.dynamic.21"]}</label
                >
                <div class="grid grid-cols-2 gap-2 mt-1">
                  <label
                    class="flex items-center gap-1.5 text-xs text-zinc-600 dark:text-zinc-350 cursor-pointer select-none"
                  >
                    <input
                      type="checkbox"
                      name="delivery_type"
                      value="products"
                      checked
                      class="rounded-sm text-primary w-3.5 h-3.5"
                    />
                    <span>{t["ads.create.dynamic.22"]}</span>
                  </label>
                  <label
                    class="flex items-center gap-1.5 text-xs text-zinc-600 dark:text-zinc-350 cursor-pointer select-none"
                  >
                    <input
                      type="checkbox"
                      name="delivery_type"
                      value="refrigerated"
                      class="rounded-sm text-primary w-3.5 h-3.5"
                    />
                    <span>{t["ads.create.dynamic.23"]}</span>
                  </label>
                  <label
                    class="flex items-center gap-1.5 text-xs text-zinc-600 dark:text-zinc-355 cursor-pointer select-none"
                  >
                    <input
                      type="checkbox"
                      name="delivery_type"
                      value="people"
                      class="rounded-sm text-primary w-3.5 h-3.5"
                    />
                    <span>{t["ads.create.dynamic.24"]}</span>
                  </label>
                  <label
                    class="flex items-center gap-1.5 text-xs text-zinc-600 dark:text-zinc-355 cursor-pointer select-none"
                  >
                    <input
                      type="checkbox"
                      name="delivery_type"
                      value="travel"
                      class="rounded-sm text-primary w-3.5 h-3.5"
                    />
                    <span>{t["ads.create.dynamic.25"]}</span>
                  </label>
                </div>
              </div>

              <div>
                <label
                  class="block text-xs font-bold text-zinc-650 dark:text-zinc-400 mb-1"
                  >{t["ads.create.dynamic.26"]}</label
                >
                <input
                  type="text"
                  name="delivery_coverage_cities"
                  id="delivery-cities-input"
