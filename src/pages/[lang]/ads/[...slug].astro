---
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import Button from '~/components/ui/Button.astro';
import AdSlider from '~/components/ui/AdSlider';
import Schema from '~/components/layout/Schema.astro';
import { siteConfig } from '~/site.config';
import { getCollection } from 'astro:content';
import { languages } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { MapPin, Tag, User, CheckCircle, Instagram, Facebook, Send, Globe, ExternalLink, MessageSquare, QrCode, Eye } from 'lucide-react';
import { categoriesMap } from '~/utils/categories';
import { getCustomFieldsByCategoryKey } from '~/utils/customFields';
import { getCityLabel } from '~/utils/cities';
import { getMeamartSession } from '~/utils/session';
import { generateCustomQRCode } from '~/utils/qrcode';
import { kvPut, kvGet } from '~/utils/kv';
import { erpnext } from '~/lib/erpnext/client';
import { buildAdJsonLd } from '~/utils/schemaGenerator';

export const prerender = false;

const { lang, slug } = Astro.params;
const t = useTranslations(lang);
const isAr = lang === 'ar';


let ad = null;

// Try to find the ad in build-time static collections
try {
  const ads = await getCollection('ads');
  ad = ads.find((a) => a.id === slug);
} catch (e) {
  console.error("Failed to read static ads collection", e);
}

// Fallback 1: Fetch from ERPNext dynamically
if (!ad && slug) {
  try {
    const adRow = await erpnext.getListingDetail(slug);
    
    if (adRow) {
      let sellerInfo: any = {};
      const sellerId = adRow.owner;
      
      const images = Array.isArray(adRow.images) && adRow.images.length > 0 ? adRow.images.map((img: any) => img.image || img.file_url) : ['/logo.svg'];
      
      ad = {
        id: String(adRow.name),
        data: {
          listing_title: adRow.title || 'بدون عنوان',
          listing_description: adRow.description || '',
          listing_price: Number(adRow.price) || 0,
          listing_currency: adRow.currency || 'SAR',
          listing_condition: adRow.condition || 'used',
          listing_city: adRow.city || '',
          listing_district: adRow.district || '',
          listing_address: adRow.address || '',
          contact_name: adRow.owner_name || sellerId || '',
          contact_phone: adRow.owner_phone || '',
          contact_whatsapp: adRow.owner_whatsapp || adRow.owner_phone || '',
          contact_method: 'whatsapp',
          image: images[0],
          images: images,
          custom_fields: {},
          categoryKey: adRow.category || 'used-items',
          pubDate: new Date(adRow.creation || Date.now()),
          user_id: sellerId,
          seller_username: sellerId || null
        }
      };
    }
  } catch (err) {
    console.error('Failed to load ad from ERPNext:', err);
  }
}

if (!ad) {
  return Astro.redirect(`/${lang}/ads`);
}

const session = await getMeamartSession(Astro);
// Ownership: Supabase user_id is primary, email match is fallback, admin always allowed
const isOwner = session && (
  (ad.data.user_id && session.id === ad.data.user_id) ||
  (session.email && ad.data.contact_email && session.email.toLowerCase() === ad.data.contact_email.toLowerCase()) ||
  session.is_admin
);

const title = ad.data.listing_title;
const description = ad.data.listing_description;
const currentLang: 'ar' | 'en' = t['gen.isar.____slug_.1'];

let safeCategoryKey = ad.data.categoryKey;
if (safeCategoryKey === 'Other' || safeCategoryKey === 'other' || !categoriesMap[safeCategoryKey]) {
  safeCategoryKey = 'used-items';
}

const category = categoriesMap[safeCategoryKey]?.[currentLang] || categoriesMap[safeCategoryKey]?.en || safeCategoryKey;
const city = ad.data.listing_city ? getCityLabel(ad.data.listing_city, currentLang) : '';

const specs = {
  [t['ad.spec.currency']]: ad.data.listing_currency,
  [t['ad.spec.condition']]: ad.data.listing_condition === 'new' ? t['ad.spec.condition.new'] : t['ad.spec.condition.used'],
  [t['ad.spec.negotiable']]: ad.data.listing_negotiable ? t['ad.spec.negotiable.yes'] : t['ad.spec.negotiable.no'],
  [t['ad.spec.city']]: city,
  [t['ad.spec.district']]: ad.data.listing_district,
  [t['ad.spec.address']]: ad.data.listing_address || t['ad.spec.address.unknown'],
  [t['ad.spec.contact.method']]: t['ad.spec.contact.whatsapp'] || (isAr ? 'واتساب' : 'WhatsApp'),
  [t['ad.spec.expires']]: ad.data.expires_at || t['ad.spec.expires.unknown']
};

const rawImg = ad.data.image || (Array.isArray(ad.data.images) && ad.data.images[0]) || '/logo.svg';
const mainImageUrl = typeof rawImg === 'string' && rawImg.startsWith('http')
  ? rawImg
  : `${Astro.site || 'https://meamart.com'}/${String(rawImg).replace(/^\//, '')}`;

// Formatted Price
const listingCurrency = ad.data.listing_currency || 'SAR';
const normalizedCurrency = String(listingCurrency).toUpperCase();

const currencySymbolMap: Record<string, string> = {
  SAR: '﷼',
  USD: '$',
  EUR: '€',
};

const currencySymbol = currencySymbolMap[normalizedCurrency] || normalizedCurrency;
const localeTag = isAr ? 'ar-SA' : 'en-US';
const formattedAmount = new Intl.NumberFormat(localeTag, {
  maximumFractionDigits: 0
}).format(Number(ad.data.listing_price) || 0);

const formattedPrice = `${formattedAmount} ${currencySymbol}`;

// WhatsApp url builder targeting MeaMart Bot
const whatsappBotNumber = siteConfig.chatbot.phoneNumber;
const rawIdStr = String(ad.id || '');
const shortAdId = ad.data?.custom_fields?.ad_ref || ad.data?.custom_fields?.short_id || ad.data?.short_id || ad.data?.ad_number || (rawIdStr.includes('-') ? rawIdStr.split('-')[0].toUpperCase() : rawIdStr.slice(0, 8).toUpperCase());
const adIdentifierDisplay = `MM-${shortAdId}`;
const whatsappUrl = `https://wa.me/${whatsappBotNumber}?text=${encodeURIComponent(
  t['ad.whatsapp.msg'].replace('{id}', shortAdId)
)}`;

// JSON-LD structured data
const whatsappMsgText = t['ad.whatsapp.msg'].replace('{id}', shortAdId);

const jsonLd = buildAdJsonLd(ad, {
  url: Astro.url.href,
  title: title,
  description: description,
  imageUrl: mainImageUrl,
  price: ad.data.listing_price,
  currency: ad.data.listing_currency || 'SAR',
  condition: ad.data.listing_condition,
  contactName: ad.data.contact_name,
  contactPhone: ad.data.contact_phone,
  whatsappUrl: whatsappUrl,
  whatsappMsgText: whatsappMsgText,
  whatsappBotNumber: whatsappBotNumber,
  city: city,
  country: ad.data.listing_country || 'Saudi Arabia',
  district: ad.data.listing_district,
  lat: ad.data.custom_fields?.lat || ad.data.custom_fields?.latitude,
  lng: ad.data.custom_fields?.lng || ad.data.custom_fields?.longitude,
  postalCode: ad.data.custom_fields?.postal_code || ad.data.custom_fields?.postcode,
  lang: lang,
  communicateActionName: t['gen.lt.____slug_.1'],
  buyActionName: t['gen.lt.____slug_.2']
});

// Dynamic SEO Title and Description
const conditionStr = ad.data.listing_condition === 'new' ? t['ad.seo.condition.new'] : t['ad.seo.condition.used'];

const seoTitle = t['ad.seo.title']
  .replace('{title}', title)
  .replace('{condition}', conditionStr)
  .replace('{city}', city)
  .replace('{price}', formattedPrice);

const seoDescription = t['ad.seo.desc']
  .replace('{title}', title)
  .replace('{city}', city);

const sellerAvatar = ad.data.seller_avatar || '';
const displaySellerAvatar = sellerAvatar || "/logo.svg";
const sellerAvatarClass = sellerAvatar ? "h-full w-full object-cover" : "h-10 w-10 opacity-40";
const sellerBanner = ad.data.seller_banner || '';
const sellerInstagram = ad.data.seller_instagram || '';
const sellerFacebook = ad.data.seller_facebook || '';
const sellerTelegram = ad.data.seller_telegram || '';
const sellerWebsite = ad.data.seller_website || '';
const sellerGmaps = ad.data.seller_gmaps || '';

// Dynamic customized specs for specific categories
const customFields = getCustomFieldsByCategoryKey(ad.data.categoryKey);
const customFieldsData = ad.data.custom_fields || {};
const customSpecs: Record<string, string> = {};

customFields.forEach(field => {
  const value = customFieldsData[field.meta_key];
  if (value !== undefined && value !== null && value !== '') {
    const label = (isAr ? field.label : field.english_label);
    let displayValue = String(value);
    
    if (field.type === 'select' && field.options) {
      const optIdx = field.options.findIndex((opt: string) => String(opt) === String(value));
      if (optIdx !== -1) {
        displayValue = isAr 
          ? field.options[optIdx] 
          : (field.english_options ? field.english_options[optIdx] : field.options[optIdx]);
      }
    } else if (field.type === 'boolean') {
      const boolVal = value === true || value === 'true' || value === 1 || value === '1';
      displayValue = boolVal
        ? t['gen.lt.____slug_.3']
        : t['gen.lt.____slug_.4'];
    }
    
    customSpecs[label] = displayValue;
  }
});

// Comments list from ERPNext (Stubbed for Phase 1)
let comments: any[] = [];
try {
  // TODO: Fetch from Frappe later
} catch (e) {
  comments = (commentRows || []).map((c: any) => ({
    authorName: c.author_name || 'Guest',
    date: c.created_at ? new Date(c.created_at).toLocaleDateString(isAr ? 'ar-SA' : 'en-US') : '',
    content: c.content || ''
  }));
} catch (e) {
  console.error('Failed to load ad comments from Supabase:', e);
}

// QR Code setup for redirect and tracking
const adQrId = `ad-${ad.id}`;
const adTrackingUrl = `${Astro.url.origin}/r/${adQrId}`;

const sellerUsername = ad.data.seller_username || '';
const sellerPhoneClean = String(ad.data.contact_phone || '').replace(/[^0-9]/g, '');
const sellerQrId = sellerUsername ? `seller-${sellerUsername}` : `seller-${sellerPhoneClean || 'unknown'}`;
const sellerTrackingUrl = `${Astro.url.origin}/r/${sellerQrId}`;

// Generate QR Code SVGs safely
let adQrSvg = '';
let sellerQrSvg = '';
let adQrDataUri = '';
try {
  let customAdQrOptions: any = null;
  let customSellerQrOptions: any = null;

  // Try fetching custom designs from the database
  try {
    // Stubbed for Phase 1, using defaults
  } catch (e) {
    console.warn('Failed to fetch custom QR options, falling back to default:', e);
  }

  adQrSvg = await generateCustomQRCode({
    text: adTrackingUrl,
    qr_options: customAdQrOptions,
    gradient: { start: '#6c47ff', end: '#a855f7' },
    logo: 'whatsapp'
  });
  sellerQrSvg = await generateCustomQRCode({
    text: sellerTrackingUrl,
    qr_options: customSellerQrOptions,
    gradient: { start: '#10b981', end: '#059669' },
    logo: 'whatsapp'
  });

  // Convert Ad SVG to base64 for download
  const adQrBase64 = Buffer.from(adQrSvg).toString('base64');
  adQrDataUri = `data:image/svg+xml;base64,${adQrBase64}`;

} catch (e) {
  console.error('QR generation non-blocking error:', e);
}

// Cache redirection links in KV to ensure fast routing on scan
try {
  await kvPut(Astro, `qr:link:${adQrId}`, Astro.url.pathname);
  await kvPut(Astro, `qr:link:${sellerQrId}`, `/${lang}/seller/${sellerPhoneClean}`);
} catch (e) {
  console.error('Failed to update redirection mapping in KV:', e);
}

// Increment view counter
const viewsKey = `ad:views:${ad.id}`;
let adViews = 0;
try {
  adViews = Number(await kvGet(Astro, viewsKey) || 0);
  adViews++;
  await kvPut(Astro, viewsKey, String(adViews));
} catch (e) {
  console.error('Failed to update view counter in KV:', e);
}

// Calculate Video Embed URL if present
let embedUrl = '';
if (ad.data.video_url && ad.data.video_primary) {
  const rawUrl = ad.data.video_url || '';
  embedUrl = rawUrl;
  const ytMatch = rawUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  if (ytMatch) embedUrl = `https://www.youtube.com/embed/${ytMatch[1]}?rel=0&autoplay=0`;
  const ttMatch = rawUrl.match(/tiktok\.com\/@[^/]+\/video\/(\d+)/);
  if (ttMatch) embedUrl = `https://www.tiktok.com/embed/v2/${ttMatch[1]}`;
  const igMatch = rawUrl.match(/instagram\.com\/(?:reel|p)\/([A-Za-z0-9_-]+)/);
  if (igMatch) embedUrl = `https://www.instagram.com/p/${igMatch[1]}/embed`;
}

// Check if ad has no images
const hasNoImages = !ad.data.image || ad.data.image === '' || ad.data.image === '/' || ad.data.image.includes('undefined') || (Array.isArray(ad.data.images) && ad.data.images.length === 0) || (Array.isArray(ad.data.images) && ad.data.images.length === 1 && (!ad.data.images[0] || ad.data.images[0] === '' || ad.data.images[0] === '/'));

---

<Layout title={seoTitle} description={seoDescription} image={mainImageUrl}>
  <!-- Inject Structured Schema -->
  <Schema item={jsonLd} />

  <Container class="pt-32 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Image Slider & Details -->
      <div class="lg:col-span-7 space-y-12">
        <!-- Interactive Slideshow OR Video (if video_primary) -->
        {hasNoImages && (
          <div 
            id="no-image-fallback-card" 
            data-id={ad.id}
            class="relative aspect-video w-full rounded-3xl border border-zinc-200/50 bg-white/40 p-8 sm:p-10 shadow-md backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40 flex flex-col justify-start items-start text-start overflow-y-auto"
          >
            <button 
              id="btn-download-card" 
              class="absolute top-6 end-6 text-zinc-400 hover:text-primary transition-colors p-2 rounded-full hover:bg-zinc-100/50 dark:hover:bg-zinc-800/50 z-25 cursor-pointer" 
              title={t['gen.lt.____slug_.5']}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" x2="12" y1="15" y2="3"/>
              </svg>
            </button>

            <div class="h-20 w-20 rounded-full border-4 border-white dark:border-zinc-900 overflow-hidden bg-zinc-100 dark:bg-zinc-800 shadow-md shrink-0 mb-4 z-10 flex items-center justify-center">
              <img 
                src={displaySellerAvatar} 
                alt={ad.data.contact_name} 
                class={sellerAvatarClass} 
              />
            </div>
            
            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50 mb-2 z-10">
              {ad.data.contact_name}
            </h3>
            
            <div class="prose prose-zinc dark:prose-invert max-w-none text-zinc-650 dark:text-zinc-300 text-sm leading-relaxed z-10">
              {description}
            </div>
          </div>
        )}

        {!hasNoImages && ad.data.video_url && ad.data.video_primary && (
          <div class="rounded-3xl overflow-hidden border border-zinc-200/50 dark:border-zinc-800/50 bg-black aspect-video">
            <iframe
              src={embedUrl}
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture"
              allowfullscreen
              class="w-full h-full"
              loading="lazy"
            ></iframe>
          </div>
        )}

        {!hasNoImages && !(ad.data.video_url && ad.data.video_primary) && (
          <AdSlider images={ad.data.images} alt={title} client:load />
        )}

        <!-- Description block -->
        <div class="mt-8 rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40">
          <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
            {t['ad.details.description']}
          </h2>
          <div class="prose prose-zinc dark:prose-invert max-w-none text-zinc-600 dark:text-zinc-300">
            {description}
          </div>
        </div>

        <!-- Specs block (if exist) -->
        {specs && Object.keys(specs).length > 0 && (
          <div class="rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40">
            <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
              {t['ad.details.specifications']}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {Object.entries(specs).map(([key, val]) => (
                <div class="flex items-center justify-between border-b border-zinc-100 pb-2 dark:border-zinc-800">
                  <span class="text-sm text-zinc-500 dark:text-zinc-400 font-semibold">{key}</span>
                  <span class="text-sm font-bold text-zinc-800 dark:text-zinc-200">{val}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Category Specific Specs block (if exist) -->
        {customSpecs && Object.keys(customSpecs).length > 0 && (
          <div class="rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40">
            <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-50 mb-4">
              {t['ad.details.categorySpecs']}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {Object.entries(customSpecs).map(([key, val]) => (
                <div class="flex items-center justify-between border-b border-zinc-100 pb-2 dark:border-zinc-800">
                  <span class="text-sm text-zinc-500 dark:text-zinc-400 font-semibold">{key}</span>
                  <span class="text-sm font-bold text-zinc-800 dark:text-zinc-200">{val}</span>
                </div>
              ))}
            </div>
          </div>
        )}
        <!-- Comments Section -->
        <div class="rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40 space-y-6">
          <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50 flex items-center gap-2 pb-3 border-b border-zinc-200/60 dark:border-zinc-800/60">
            <MessageSquare className="h-5 w-5 text-primary" />
            <span>{t['gen.lt.____slug_.8']}</span>
            <span class="text-xs font-semibold bg-primary/10 text-primary px-2.5 py-0.5 rounded-full">{comments.length}</span>
          </h3>

          {comments.length === 0 ? (
            <div class="py-8 text-center text-zinc-500 dark:text-zinc-400">
              <p class="text-sm font-semibold">{t['gen.lt.____slug_.9']}</p>
              <p class="text-[10px] text-zinc-400 mt-1">{t['gen.lt.____slug_.10']}</p>
            </div>
          ) : (
            <div class="space-y-4 max-h-100 overflow-y-auto pr-2">
              {comments.map((c) => (
                <div class="p-4 rounded-full bg-zinc-50/50 border border-zinc-100 dark:bg-zinc-900/30 dark:border-zinc-800/50 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-zinc-800 dark:text-zinc-200">{c.authorName}</span>
                    <span class="text-[9px] text-zinc-400 font-semibold">{c.date}</span>
                  </div>
                  <p class="text-xs text-zinc-650 dark:text-zinc-300 leading-relaxed font-semibold">{c.content}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Pricing & Contact Information -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Pricing card -->
        <div class="rounded-3xl border border-zinc-200/50 bg-white/60 p-6 shadow-md backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-primary">
                <Tag className="h-3.5 w-3.5" />
              </span>
              <span class="text-xs font-semibold text-zinc-500 dark:text-zinc-400">{category}</span>
            </div>
            <!-- Views count badge -->
            <div class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800/80 px-2.5 py-1 rounded-full font-bold">
              <Eye className="h-3.5 w-3.5 text-zinc-400" />
              <span>{adViews.toLocaleString()}</span>
            </div>
          </div>

          <!-- Ad Identifier / Short Reference Box -->
          <div class="flex items-center justify-between bg-zinc-100/80 dark:bg-zinc-800/60 px-3.5 py-2 rounded-xl mb-4 border border-zinc-200/60 dark:border-zinc-700/60">
            <div class="flex items-center gap-2 text-xs font-bold text-zinc-600 dark:text-zinc-300">
              <span class="text-zinc-400 dark:text-zinc-500 font-semibold">{isAr ? 'رقم الإعلان:' : 'Ad ID:'}</span>
              <span class="font-mono text-primary font-extrabold select-all tracking-wider">{adIdentifierDisplay}</span>
            </div>
            <button
              type="button"
              onclick={`navigator.clipboard.writeText('${adIdentifierDisplay}'); this.innerHTML='✓'; setTimeout(()=>this.innerHTML='${isAr ? 'نسخ' : 'Copy'}', 1500);`}
              class="text-[10px] font-bold text-primary bg-primary/10 hover:bg-primary/20 px-2.5 py-1 rounded-lg transition-colors cursor-pointer"
            >
              {isAr ? 'نسخ' : 'Copy'}
            </button>
          </div>

          <h1 class="text-2xl font-bold font-display text-zinc-900 dark:text-zinc-50 mb-4">
            {title}
          </h1>

          <div class="bg-zinc-50 dark:bg-zinc-950 p-4 rounded-full mb-6">

            <span class="text-xs font-semibold text-zinc-500 block mb-1">
              {t['ad.details.listingPrice']}
            </span>
            <span class="text-3xl font-extrabold text-primary">
              {formattedPrice}
            </span>
          </div>

          <!-- Direct WhatsApp button -->
          <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 w-full rounded-full bg-emerald-500 py-3.5 text-sm font-bold text-white shadow-lg transition-all hover:bg-emerald-600 hover:scale-[1.02] active:scale-[0.98]"
            itemscope
            itemtype="https://schema.org/CommunicateAction"
          >
            <meta itemprop="name" content={t['gen.lt.____slug_.6']} />
            <meta itemprop="target" content={whatsappUrl} />
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
