        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-red-100 dark:bg-red-900/30 mx-auto">
          <svg class="h-6 w-6 text-red-600 dark:text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-center text-zinc-900 dark:text-zinc-50 mb-2">
          {t['ad.details.deleteConfirmTitle']}
        </h3>
        <p class="text-sm text-center text-zinc-500 dark:text-zinc-400 mb-6">
          {t['ad.details.deleteConfirmBody']}
        </p>
        
        <!-- Error Message Container -->
        <div id="delete-error" class="hidden mb-4 p-3 rounded-xl bg-red-50 text-red-600 text-xs text-center border border-red-100 dark:bg-red-500/10 dark:border-red-500/20 dark:text-red-400"></div>

        <div class="grid grid-cols-2 gap-3">
          <button id="btn-cancel-delete" class="rounded-full border border-zinc-200 bg-white py-2.5 text-sm font-bold text-zinc-700 hover:bg-zinc-50 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700/80">
            {t['ad.details.cancel']}
          </button>
          <button id="btn-confirm-delete" class="flex items-center justify-center rounded-full bg-red-500 py-2.5 text-sm font-bold text-white hover:bg-red-600 shadow-md">
            {t['ad.details.confirmDelete']}
          </button>
        </div>
      </div>
    </div>
  )}

  <script define:vars={{ adId: ad.id, lang, confirmDeleteText: t['ad.details.confirmDelete'] }}>
    const btnDelete = document.getElementById('btn-delete-ad');
    const modal = document.getElementById('delete-modal');
    const btnCancel = document.getElementById('btn-cancel-delete');
    const btnConfirm = document.getElementById('btn-confirm-delete');
    const errorContainer = document.getElementById('delete-error');
    const modalInner = modal?.querySelector('div.relative');

    function openModal() {
      if(!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        if(modalInner) {
          modalInner.classList.remove('scale-95');
          modalInner.classList.add('scale-100');
        }
      }, 10);
    }

    function closeModal() {
      if(!modal) return;
      modal.classList.add('opacity-0');
      if(modalInner) {
        modalInner.classList.remove('scale-100');
        modalInner.classList.add('scale-95');
      }
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 300);
    }

    if (btnDelete) btnDelete.addEventListener('click', openModal);
    if (btnCancel) btnCancel.addEventListener('click', closeModal);

    if(btnConfirm) {
      btnConfirm.addEventListener('click', async () => {
        btnConfirm.innerHTML = '<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>';
        btnConfirm.disabled = true;
        
        if (errorContainer) errorContainer.classList.add('hidden');
 
        try {
          const res = await fetch('/api/delete-ad', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ postId: adId })
          });
          const data = await res.json();
          if(data.success) {
            window.location.href = `/${lang}/seller/dashboard`;
          } else {
            throw new Error(data.error || 'Failed to delete');
          }
        } catch (err) {
          const message = err instanceof Error ? err.message : 'Error occurred';
          if (errorContainer) {
            errorContainer.textContent = message;
            errorContainer.classList.remove('hidden');
          }
          btnConfirm.innerHTML = confirmDeleteText;
          btnConfirm.disabled = false;
        }
      });
    }
  </script>

  <script>
    // Card download handler using dynamic SVG backend renderer (solves Arabic letter shaper issue)
    const downloadBtn = document.getElementById('btn-download-card');
    downloadBtn?.addEventListener('click', async () => {
      const card = document.getElementById('no-image-fallback-card');
      if (!card) return;
      
      const adId = card.dataset.id;
      const isDark = document.documentElement.classList.contains('dark');
      const theme = isDark ? 'dark' : 'light';
      
      downloadBtn.setAttribute('disabled', 'true');
      
      try {
        const svgUrl = `/api/ads/og/${adId}?theme=${theme}`;
        const res = await fetch(svgUrl);
        if (!res.ok) throw new Error('Failed to fetch card SVG');
        
        const svgText = await res.text();
        const parser = new DOMParser();
        const svgDoc = parser.parseFromString(svgText, 'image/svg+xml');
        const svgElement = svgDoc.documentElement;
        svgElement.setAttribute('width', '1200');
        svgElement.setAttribute('height', '630');
        
        const serializer = new XMLSerializer();
        const serializedSvg = serializer.serializeToString(svgElement);
        
        const svgBlob = new Blob([serializedSvg], { type: 'image/svg+xml;charset=utf-8' });
        const blobUrl = URL.createObjectURL(svgBlob);
        
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.src = blobUrl;
        
        img.onload = () => {
          const canvas = document.createElement('canvas');
          canvas.width = 1200;
          canvas.height = 630;
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.drawImage(img, 0, 0);
            const jpegUrl = canvas.toDataURL('image/jpeg', 0.95);
            const a = document.createElement('a');
            a.href = jpegUrl;
            a.download = `ad-${adId}-${theme}.jpg`;
            a.click();
          }
          URL.revokeObjectURL(blobUrl);
          downloadBtn.removeAttribute('disabled');
        };
        
        img.onerror = (e) => {
          console.error('Image loading error:', e);
          URL.revokeObjectURL(blobUrl);
          downloadBtn.removeAttribute('disabled');
        };
      } catch (err) {
        console.error('Failed to download card:', err);
        downloadBtn.removeAttribute('disabled');
      }
    });
  </script>

  <script define:vars={{ adId: ad.id, adTitle: title, priceStr: formattedPrice, lang, isAr }}>
    // Global functions for inline onclick attributes
    window.shareAdWhatsApp = function() {
      const adUrl = window.location.origin + '/' + lang + '/ads/' + adId;
      const whatsappMsgTemplate = isAr 
        ? "تفضل إعلان ${adTitle} بسعر ${priceStr}:\n${adUrl}" 
        : "Check out this ad: ${adTitle} for ${priceStr}:\n${adUrl}";
      const msg = whatsappMsgTemplate
        .replace('${adTitle}', adTitle)
        .replace('${priceStr}', priceStr)
        .replace('${adUrl}', adUrl);
      window.open('https://wa.me/?text=' + encodeURIComponent(msg), '_blank');
    };

    window.copyAdLink = function(btn) {
      const adUrl = window.location.origin + '/' + lang + '/ads/' + adId;
      navigator.clipboard.writeText(adUrl).then(() => {
        const textSpan = btn.querySelector('.copy-link-text') || btn.querySelector('span');
        const origText = textSpan.textContent;
        textSpan.textContent = isAr ? 'تم النسخ!' : 'Copied!';
        textSpan.style.color = '#10b981';
        setTimeout(() => {
          textSpan.textContent = origText;
          textSpan.style.color = '';
        }, 2000);
      });
    };

    window.downloadAdJpg = async function(theme) {
      const svgUrl = `/api/ads/og/${adId}?theme=${theme}&t=${Date.now()}`;
      try {
        const res = await fetch(svgUrl);
        if (!res.ok) throw new Error('Failed to fetch card SVG');
        const svgText = await res.text();
        
        const parser = new DOMParser();
        const svgDoc = parser.parseFromString(svgText, 'image/svg+xml');
        const svgElement = svgDoc.documentElement;
        svgElement.setAttribute('width', '1200');
        svgElement.setAttribute('height', '630');
        
        const serializer = new XMLSerializer();
        const serializedSvg = serializer.serializeToString(svgElement);
        const svgBlob = new Blob([serializedSvg], { type: 'image/svg+xml;charset=utf-8' });
        const blobUrl = URL.createObjectURL(svgBlob);
        
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.src = blobUrl;
        img.onload = () => {
          const canvas = document.createElement('canvas');
          canvas.width = 1200;
          canvas.height = 630;
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.drawImage(img, 0, 0);
            const jpegUrl = canvas.toDataURL('image/jpeg', 0.95);
            const a = document.createElement('a');
            a.href = jpegUrl;
            a.download = `meamart-ad-${adId}-${theme}.jpg`;
            a.click();
          }
          URL.revokeObjectURL(blobUrl);
        };
        img.onerror = () => {
          URL.revokeObjectURL(blobUrl);
          const a = document.createElement('a');
          a.href = svgUrl;
          a.download = `meamart-ad-${adId}-${theme}.svg`;
          a.click();
        };
      } catch (err) {
        console.error(err);
        const a = document.createElement('a');
        a.href = svgUrl;
        a.download = `meamart-ad-${adId}-${theme}.svg`;
        a.click();
      }
    };

    // Dropdown Toggles
    document.querySelectorAll('.btn-share-dropdown').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const menu = btn.nextElementSibling;
        if (menu) {
          const isHidden = menu.classList.contains('hidden');
          document.querySelectorAll('.share-dropdown-menu').forEach((m) => {
            m.classList.add('hidden');
            m.classList.add('opacity-0');
            m.classList.add('scale-95');
          });
          if (isHidden) {
            menu.classList.remove('hidden');
            setTimeout(() => {
              menu.classList.remove('opacity-0');
              menu.classList.remove('scale-95');
              menu.classList.add('opacity-100');
              menu.classList.add('scale-100');
            }, 10);
          }
        }
      });
    });

    document.addEventListener('click', () => {
      document.querySelectorAll('.share-dropdown-menu').forEach((m) => {
        m.classList.add('opacity-0');
        m.classList.add('scale-95');
        setTimeout(() => {
          m.classList.add('hidden');
        }, 150);
      });
    });
  </script>
</Layout>


