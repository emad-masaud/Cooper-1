---
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import AdFilters from '~/components/ui/AdFilters';
import { languages } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import { categoriesMap } from '~/utils/categories';
import { resolveCity } from '~/utils/cities';
import { erpnext } from '~/lib/erpnext/client';

export const prerender = false;

const { lang } = Astro.params;
const t = useTranslations(lang);

// Fetch ads dynamically from ERPNext
const { data: rawAds, total_count } = await erpnext.getListings({ limit: 200 }).catch(err => {
  console.error('Failed to fetch ads from ERPNext:', err);
  return { data: [], total_count: 0 };
});

const adsData = (rawAds || []).map((ad: any) => {
  // Try mapping the category string, or fallback to the string itself if not in categoryMap
  const categoryKey = ad.category || 'used-items';
  const cat = categoriesMap[categoryKey] || { ar: categoryKey, en: categoryKey };
  
  const city = resolveCity(ad.city || '');
  return {
    id: ad.name,
    title: ad.title || 'Untitled',
    price: Number(ad.price) || 0,
    categoryKey,
    categoryEn: cat.en,
    categoryAr: cat.ar,
    cityKey: ad.city || '',
    cityEn: city.en,
    cityAr: city.ar,
    image: ad.images && ad.images.length > 0 ? ad.images[0].image : '/logo.svg',
    sellerPhone: ad.owner_phone || '',
    descriptionEn: ad.description || '',
    descriptionAr: ad.description || '',
    titleEn: ad.title || 'Untitled',
    titleAr: ad.title || 'Untitled',
    createdAt: ad.creation,
  };
});
---

<Layout 
  title={t['gen.isar.index.1']} 
  description={t['gen.isar.index.2']}
>
  <PageHeader 
    title={t['gen.isar.index.3']}
    description={t['gen.isar.index.4']}
  />

  <Container as="section" class="pb-24">
    <AdFilters ads={adsData} lang={lang} client:load />
  </Container>
</Layout>
