---
import Layout from "~/layouts/Layout.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import Container from "~/components/ui/Container.astro";
import Section from "~/components/layout/Section.astro";
import Button from "~/components/ui/Button.astro";
import {
  Zap,
  Shield,
  Smartphone,
  Globe,
  Users,
  TrendingUp,
} from "lucide-react";
import { languages } from "~/i18n/ui";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import { siteConfig, ACTION_LINKS } from "~/site.config";

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const features = [
  {
    icon: Zap,
    color: "text-amber-500",
    bg: "bg-amber-500/10",
    title: t["about.features.instant.title"],
    desc: t["about.features.instant.desc"],
  },
  {
    icon: Shield,
    color: "text-emerald-500",
    bg: "bg-emerald-500/10",
    title: t["about.features.safe.title"],
    desc: t["about.features.safe.desc"],
  },
  {
    icon: Smartphone,
    color: "text-blue-500",
    bg: "bg-blue-500/10",
    title: t["about.features.whatsapp.title"],
    desc: t["about.features.whatsapp.desc"],
  },
  {
    icon: Globe,
    color: "text-purple-500",
    bg: "bg-purple-500/10",
    title: t["about.features.gulf.title"],
    desc: t["about.features.gulf.desc"],
  },
  {
    icon: TrendingUp,
    color: "text-rose-500",
    bg: "bg-rose-500/10",
    title: t["about.features.featured.title"],
    desc: t["about.features.featured.desc"],
  },
  {
    icon: Users,
    color: "text-sky-500",
    bg: "bg-sky-500/10",
    title: t["about.features.community.title"],
    desc: t["about.features.community.desc"],
  },
];
---

<Layout title={t["about.seo.title"]} description={t["about.seo.description"]}>
  <PageHeader
    title={t["about.header.title"]}
    description={t["about.header.description"]}
  />

  <!-- Mission Section -->
  <Section>
    <Container class="pb-16">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
        <div class="space-y-6">
          <h2 class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-50">
            {t["about.mission.title"]}
          </h2>
          <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {t["about.mission.body1"]}
          </p>
          <p class="text-base text-zinc-500 dark:text-zinc-500 leading-relaxed">
            {t["about.mission.body2"]}
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <Button href={`/${lang}/ads/create`}>
              {t["about.cta.postNow"]}
            </Button>
            <Button href={`/${lang}/ads`} variant="outline">
              {t["about.cta.browseAds"]}
            </Button>
          </div>
        </div>

        <!-- Stats Card -->
        <div class="grid grid-cols-2 gap-4">
          {
            [
              {
                value: t["about.stats.free.value"],
                label: t["about.stats.free.label"],
              },
              {
                value: t["about.stats.always.value"],
                label: t["about.stats.always.label"],
              },
              {
                value: t["about.stats.gulf.value"],
                label: t["about.stats.gulf.label"],
              },
              {
                value: t["about.stats.secure.value"],
                label: t["about.stats.secure.label"],
              },
            ].map((stat) => (
              <div class="rounded-3xl border border-zinc-200/50 bg-white/60 p-6 text-center shadow-sm backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60">
                <div class="text-3xl font-extrabold text-primary mb-1">
                  {stat.value}
                </div>
                <div class="text-xs text-zinc-500 dark:text-zinc-400 font-medium">
                  {stat.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <!-- Features Grid -->
  <Section>
    <Container class="pb-24">
      <div class="text-center mb-12">
        <h2
          class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-50 mb-3"
        >
          {t["about.why.title"]}
        </h2>
        <p class="text-zinc-500 dark:text-zinc-400 max-w-xl mx-auto">
          {t["about.why.subtitle"]}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => {
            const IconComponent = f.icon;
            return (
              <div class="group rounded-3xl border border-zinc-200/50 bg-white/60 p-6 shadow-sm backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/60">
                <div
                  class={`mb-4 flex h-12 w-12 items-center justify-center rounded-full ${f.bg} ${f.color}`}
                >
                  <IconComponent className="h-6 w-6" />
                </div>
                <h3 class="mb-2 text-lg font-bold text-zinc-900 dark:text-zinc-50">
                  {f.title}
                </h3>
                <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
                  {f.desc}
                </p>
              </div>
            );
          })
        }
      </div>
    </Container>
  </Section>

  <!-- Contact CTA -->
  <Section>
    <Container class="pb-24">
      <div
        class="rounded-3xl border border-primary/20 bg-primary/5 p-10 text-center dark:bg-primary/10"
      >
        <h2
          class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-50 mb-3"
        >
          {t["about.contact.title"]}
        </h2>
        <p class="text-zinc-500 dark:text-zinc-400 mb-6 max-w-lg mx-auto">
          {t["about.contact.description"]}
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <Button href={`/${lang}/contact`}>
            {t["about.contact.button"]}
          </Button>
          <a
            href={ACTION_LINKS.social.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-emerald-500 bg-emerald-500/10 px-6 py-2.5 text-sm font-bold text-emerald-600 transition hover:bg-emerald-500 hover:text-white dark:text-emerald-400"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-4 w-4"
              fill="currentColor"
              style="margin:0"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
              ></path>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>
    </Container>
  </Section>
</Layout>
