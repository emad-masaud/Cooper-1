---
import Layout from '@/layouts/Layout.astro';
import ListingCard from '@/components/ui/ListingCard.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { erpnext } from '@/lib/erpnext/client';
import { MapPin, Clock, Share2, MessageCircle, Phone, Info } from 'lucide-react';

const { id } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

if (!id) return Astro.redirect(`/${lang}/404`);

let listing: any = null;
let relatedListings: any[] = [];
try {
  listing = await erpnext.getListingDetail(id as string);
  
  if (listing && listing.category) {
    const res = await erpnext.getListings({ category_slug: listing.category_summary?.slug, limit: 4 });
    relatedListings = res.data.filter((l: any) => l.name !== listing.name).slice(0, 4);
  }
} catch (e) {
  return Astro.redirect(`/${lang}/404`);
}

if (!listing) return Astro.redirect(`/${lang}/404`);

const timeAgo = listing.creation ? new Date(listing.creation).toLocaleDateString(lang === 'ar' ? 'ar-SA' : 'en-US', { 
  year: 'numeric', month: 'short', day: 'numeric' 
}) : '';
---

<Layout title={`${listing.title} - ميمارت`}>
  <div class="bg-slate-50 dark:bg-slate-900 min-h-screen py-8">
    <div class="max-w-7xl mx-auto px-6">
      
      <!-- Breadcrumb -->
      <nav class="flex text-sm text-slate-500 mb-6 gap-2">
        <a href={`/${lang}`} class="hover:text-primary-600">الرئيسية</a>
        <span>/</span>
        {listing.category_summary && (
          <>
            <a href={`/${lang}/listings?category_slug=${listing.category_summary.slug}`} class="hover:text-primary-600">
              {listing.category_summary.category_name}
            </a>
            <span>/</span>
          </>
        )}
        <span class="text-slate-900 dark:text-white truncate">{listing.title}</span>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8">
        
        <!-- Left: Main Content (2/3) -->
        <div class="w-full lg:w-2/3">
          <!-- Gallery -->
          <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden mb-8">
            <div class="aspect-[4/3] sm:aspect-video bg-slate-100 dark:bg-slate-900 relative">
              {listing.images && listing.images.length > 0 ? (
                <img 
                  src={listing.images[0].image} 
                  alt={listing.title} 
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-slate-400">لا توجد صورة</div>
              )}
            </div>
            {listing.images && listing.images.length > 1 && (
              <div class="p-4 flex gap-4 overflow-x-auto hide-scrollbar border-t border-slate-100 dark:border-slate-700">
                {listing.images.map((img: any) => (
                  <img src={img.image} class="w-20 h-20 object-cover rounded-lg cursor-pointer hover:ring-2 ring-primary-500 transition-all shrink-0" />
                ))}
              </div>
            )}
          </div>

          <!-- Info -->
          <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 md:p-8 mb-8">
            <div class="flex items-start justify-between gap-4 mb-6">
              <h1 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white leading-tight">
                {listing.title}
              </h1>
            </div>
            
            <div class="flex flex-wrap items-center gap-6 text-sm text-slate-500 mb-8 pb-8 border-b border-slate-100 dark:border-slate-700">
              <div class="flex items-center gap-2">
                <MapPin size={16} />
                <span>{listing.city}</span>
              </div>
              <div class="flex items-center gap-2">
                <Clock size={16} />
                <span>{timeAgo}</span>
              </div>
              <div class="flex items-center gap-2">
                <Info size={16} />
                <span>{listing.views_count || 0} مشاهدة</span>
              </div>
            </div>

            <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">التفاصيل</h2>
            <div class="prose dark:prose-invert max-w-none text-slate-600 dark:text-slate-300 mb-8" set:html={listing.description} />
          </div>
        </div>

        <!-- Right: Sticky Sidebar (1/3) -->
        <div class="w-full lg:w-1/3">
          <div class="sticky top-24 space-y-6">
            
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6">
              <div class="text-3xl font-bold text-emerald-600 dark:text-emerald-400 mb-6">
                {listing.price ? `${listing.price} ريال` : 'غير محدد'}
              </div>
              
              <div class="flex items-center gap-4 p-4 bg-slate-50 dark:bg-slate-900/50 rounded-xl mb-6">
                <div class="w-12 h-12 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center font-bold text-xl shrink-0">
                  {(listing.owner_name || 'U').charAt(0).toUpperCase()}
                </div>
                <div>
                  <div class="font-bold text-slate-900 dark:text-white">{listing.owner_name || 'مستخدم مجهول'}</div>
                  <div class="text-xs text-slate-500">معلن نشط</div>
                </div>
              </div>

              <div class="space-y-3">
                <button class="w-full bg-primary-600 hover:bg-primary-700 text-white rounded-xl py-4 font-bold flex items-center justify-center gap-2 transition-colors shadow-lg shadow-primary-600/20">
                  <MessageCircle size={20} />
                  تواصل عبر الشات
                </button>
                {listing.owner_whatsapp && (
                  <a href={`https://wa.me/${listing.owner_whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" class="w-full bg-[#25D366] hover:bg-[#1ebd5a] text-white rounded-xl py-4 font-bold flex items-center justify-center gap-2 transition-colors shadow-lg shadow-[#25D366]/20">
                    <Phone size={20} />
                    واتساب
                  </a>
                )}
              </div>
              
              <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-700 flex justify-center">
                <button class="text-slate-500 hover:text-primary-600 flex items-center gap-2 font-medium transition-colors">
                  <Share2 size={18} />
                  مشاركة الإعلان
                </button>
              </div>
            </div>
            
            <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 p-6 text-center text-sm text-slate-500">
              <p>يرجى الحذر عند التعامل وعدم تحويل الأموال قبل استلام السلعة.</p>
            </div>
            
          </div>
        </div>

      </div>

      <!-- Related Listings -->
      {relatedListings.length > 0 && (
        <div class="mt-16">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-8">إعلانات مشابهة</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {relatedListings.map((l: any) => (
              <ListingCard listing={l} />
            ))}
          </div>
        </div>
      )}
      
    </div>
  </div>
</Layout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
