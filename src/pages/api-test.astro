---
import { getListings } from '../lib/erpnext';
import Layout from '../layouts/Layout.astro';

let data: any = null;
let error: any = null;

try {
  // Try to fetch listings from ERPNext
  const listings = await getListings({}, 1);
  data = listings;
} catch (e) {
  error = e;
}
---

<Layout title="API Test - MeaMart">
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">ERPNext API Connection Test</h1>
    
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-8 border border-gray-200 dark:border-gray-700">
      <h2 class="text-xl font-semibold mb-4">Environment Setup</h2>
      <ul class="list-disc pl-5 mb-4 text-gray-700 dark:text-gray-300">
        <li>URL: <code class="bg-gray-100 dark:bg-gray-900 px-2 py-1 rounded">{import.meta.env.PUBLIC_ERPNEXT_URL || 'Not Set (using default)'}</code></li>
        <li>API Key configured: <strong>{import.meta.env.PUBLIC_ERPNEXT_API_KEY ? 'Yes' : 'No'}</strong></li>
      </ul>
      
      <p class="text-sm text-gray-500 mb-4">
        Note: If API Key is not set, you must configure it in the <code>.env</code> file.
      </p>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 border border-gray-200 dark:border-gray-700">
      <h2 class="text-xl font-semibold mb-4">Connection Result</h2>
      
      {error ? (
        <div class="bg-red-50 dark:bg-red-900/30 border-l-4 border-red-500 p-4 mb-4">
          <h3 class="text-red-800 dark:text-red-200 font-medium">Connection Error</h3>
          <p class="text-red-700 dark:text-red-300 mt-1">{error.message || 'Unknown error occurred'}</p>
          <p class="text-sm mt-2 text-red-600 dark:text-red-400">Check CORS settings, API keys, and network connectivity.</p>
        </div>
      ) : (
        <div>
          <div class="bg-green-50 dark:bg-green-900/30 border-l-4 border-green-500 p-4 mb-4">
            <h3 class="text-green-800 dark:text-green-200 font-medium">Connection Successful</h3>
            <p class="text-green-700 dark:text-green-300 mt-1">Successfully connected to ERPNext API.</p>
          </div>
          
          <h3 class="font-medium mb-2">Raw Data (First Listing):</h3>
          <pre class="bg-gray-100 dark:bg-gray-900 p-4 rounded overflow-x-auto text-sm">{JSON.stringify(data, null, 2)}</pre>
        </div>
      )}
    </div>
  </main>
</Layout>
