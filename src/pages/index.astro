---
import Layout from '@/layouts/Layout.astro';
import HeroSearch from '@/components/sections/hero/HeroSearch.astro';
import CategoryPill from '@/components/ui/CategoryPill.astro';
import ListingCard from '@/components/ui/ListingCard.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { erpnext } from '@/lib/erpnext/client';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Fetch Data
const categories = await erpnext.getCategories();
const listingsResponse = await erpnext.getListings({ limit: 12 });
const recentListings = listingsResponse.data || [];
---

<Layout>
  <!-- Hero Section with Search -->
  <HeroSearch />

  <!-- Categories Section -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-8">
        {t['categories.title'] || 'تصفح حسب الفئة'}
      </h2>
      
      <!-- Horizontal Scrollable Container -->
      <div class="flex overflow-x-auto pb-6 -mx-6 px-6 gap-4 snap-x hide-scrollbar">
        {categories.map((category) => (
          <div class="snap-start shrink-0">
            <CategoryPill category={category} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Listings -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">
          {t['listings.recent'] || 'أحدث الإعلانات'}
        </h2>
        <a href={`/${lang}/listings`} class="text-primary-600 dark:text-primary-400 font-medium hover:underline flex items-center gap-2">
          عرض الكل
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {recentListings.map((listing) => (
          <ListingCard listing={listing} />
        ))}
        {recentListings.length === 0 && (
          <div class="col-span-full text-center py-12 text-slate-500">
            لا توجد إعلانات حالياً
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-primary-900 text-center px-6">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        عندك غرض ما تحتاجه؟
      </h2>
      <p class="text-xl text-primary-100 mb-10">
        أضف إعلانك الآن مجاناً ووصل لملايين المشترين في منطقتك
      </p>
      <a href={`/${lang}/post`} class="inline-flex items-center justify-center bg-white text-primary-900 px-8 py-4 rounded-xl font-bold text-lg hover:bg-slate-50 transition-colors shadow-xl">
        أضف إعلانك الآن
      </a>
    </div>
  </section>
</Layout>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
