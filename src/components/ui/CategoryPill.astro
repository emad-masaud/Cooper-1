---
import * as IconList from "lucide-react";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  category: {
    category_name: string;
    slug: string;
    icon?: string;
    count?: number;
  };
}

const { category } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Get the icon component from lucide-react dynamically
const IconComponent = category.icon && (IconList as any)[category.icon] 
  ? (IconList as any)[category.icon] 
  : IconList.LayoutGrid;

const url = `/${lang}/listings?category_slug=${category.slug}`;
---

<a href={url} class="group flex flex-col items-center justify-center p-6 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-primary-500 hover:shadow-lg transition-all duration-300 min-w-[140px]">
  <div class="p-3 bg-slate-50 dark:bg-slate-900 rounded-xl mb-3 group-hover:bg-primary-50 dark:group-hover:bg-primary-900/30 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
    <IconComponent size={32} strokeWidth={1.5} />
  </div>
  <h3 class="font-medium text-slate-900 dark:text-white text-center">{category.category_name}</h3>
  {category.count !== undefined && (
    <span class="text-sm text-slate-500 mt-1">{category.count}</span>
  )}
</a>
