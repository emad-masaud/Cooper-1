---

---

<div
  class="group relative overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/60 p-4 shadow-xs backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60 flex flex-col h-full justify-between animate-pulse"
>
  <!-- Image Container Skeleton -->
  <div
    class="relative aspect-video w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-800"
  >
    <div
      class="absolute top-3 left-3 rounded-full bg-zinc-300 dark:bg-zinc-700 h-6 w-16"
    >
    </div>
    <div
      class="absolute bottom-3 right-3 rounded-full bg-zinc-300 dark:bg-zinc-700 h-7 w-20"
    >
    </div>
  </div>

  <!-- Details Content Skeleton -->
  <div class="mt-4 flex flex-col justify-between flex-1 space-y-4">
    <div class="space-y-2">
      <!-- Title -->
      <div class="h-6 bg-zinc-300 dark:bg-zinc-700 rounded-lg w-3/4"></div>
      <!-- Description lines -->
      <div class="space-y-1">
        <div class="h-4 bg-zinc-200 dark:bg-zinc-800 rounded-md w-full"></div>
        <div class="h-4 bg-zinc-200 dark:bg-zinc-800 rounded-md w-5/6"></div>
        <div class="h-4 bg-zinc-200 dark:bg-zinc-800 rounded-md w-2/3"></div>
      </div>
      <!-- City -->
      <div class="h-3 bg-zinc-200 dark:bg-zinc-800 rounded-md w-1/4 mt-2"></div>
    </div>

    <!-- Actions Skeleton -->
    <div class="mt-4 flex items-center gap-2">
      <div class="flex-1 h-9 bg-zinc-300 dark:bg-zinc-700 rounded-full"></div>
      <div
        class="flex-shrink-0 h-10 w-10 bg-zinc-300 dark:bg-zinc-700 rounded-full"
      >
      </div>
    </div>
  </div>
</div>
