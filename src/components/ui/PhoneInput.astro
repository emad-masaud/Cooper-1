---
export interface Props {
  name: string;
  label?: string;
  required?: boolean;
  value?: string;
  placeholder?: string;
}

const {
  name,
  label,
  required = false,
  value = "",
  placeholder = "500000000",
} = Astro.props;

// Extract existing code and number if value is provided (e.g. +966500000000)
let defaultCode = "+966";
let defaultNumber = value;

if (value.startsWith("+")) {
  // Simple heuristic to split code and number (assuming codes are 1-4 digits)
  const match = value.match(/^(\+\d{1,4})(.*)$/);
  if (match) {
    defaultCode = match[1];
    defaultNumber = match[2];
  }
}

const allDialCodes = [
  { c: "SA", code: "+966", name: "Saudi Arabia" },
  { c: "AE", code: "+971", name: "United Arab Emirates" },
  { c: "KW", code: "+965", name: "Kuwait" },
  { c: "BH", code: "+973", name: "Bahrain" },
  { c: "QA", code: "+974", name: "Qatar" },
  { c: "OM", code: "+968", name: "Oman" },
  { c: "EG", code: "+20", name: "Egypt" },
  { c: "JO", code: "+962", name: "Jordan" },
  { c: "LB", code: "+961", name: "Lebanon" },
  { c: "SY", code: "+963", name: "Syria" },
  { c: "IQ", code: "+964", name: "Iraq" },
  { c: "YE", code: "+967", name: "Yemen" },
  { c: "MA", code: "+212", name: "Morocco" },
  { c: "DZ", code: "+213", name: "Algeria" },
  { c: "TN", code: "+216", name: "Tunisia" },
  { c: "LY", code: "+218", name: "Libya" },
  { c: "SD", code: "+249", name: "Sudan" },
  { c: "PS", code: "+970", name: "Palestine" },
  { c: "TR", code: "+90", name: "Turkey" },
  { c: "US", code: "+1", name: "USA / Canada" },
  { c: "GB", code: "+44", name: "UK" },
  { c: "IN", code: "+91", name: "India" },
  { c: "PK", code: "+92", name: "Pakistan" },
  { c: "BD", code: "+880", name: "Bangladesh" },
  { c: "PH", code: "+63", name: "Philippines" },
  { c: "ID", code: "+62", name: "Indonesia" },
  { c: "MY", code: "+60", name: "Malaysia" },
  { c: "SG", code: "+65", name: "Singapore" },
  { c: "CN", code: "+86", name: "China" },
  { c: "JP", code: "+81", name: "Japan" },
  { c: "KR", code: "+82", name: "South Korea" },
  { c: "DE", code: "+49", name: "Germany" },
  { c: "FR", code: "+33", name: "France" },
  { c: "IT", code: "+39", name: "Italy" },
  { c: "ES", code: "+34", name: "Spain" },
  { c: "RU", code: "+7", name: "Russia" },
  { c: "BR", code: "+55", name: "Brazil" },
  { c: "ZA", code: "+27", name: "South Africa" },
  { c: "NG", code: "+234", name: "Nigeria" },
  { c: "AU", code: "+61", name: "Australia" },
  { c: "NZ", code: "+64", name: "New Zealand" },
];
---

<div>
  {
    label && (
      <label class="flex items-center gap-2 text-xs font-bold text-zinc-600 dark:text-zinc-400 mb-2">
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4 text-emerald-500 shrink-0"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
        </svg>
        {label} {required && <span class="text-red-500">*</span>}
      </label>
    )
  }
  <div class="flex flex-row shadow-sm rounded-full" dir="ltr" style="direction: ltr;">
    <select
      name={`${name}_code`}
      data-no-tomselect="true"
      style="direction: ltr; text-align: left;" class="form-select !rounded-r-none !rounded-l-full !w-[115px] ps-4 pe-8 text-sm font-medium border-r-0 bg-zinc-50 dark:bg-zinc-900/50 border-zinc-300 dark:border-zinc-700 text-zinc-800 dark:text-zinc-200 focus:ring-primary focus:border-primary transition-colors"
    >
      {
        allDialCodes.map((country) => (
          <option value={country.code} selected={country.code === defaultCode}>
            {country.c} {country.code}
          </option>
        ))
      }
      <option value="">Other</option>
    </select>
    <input
      type="tel"
      name={`${name}_number`}
      required={required}
      value={defaultNumber}
      placeholder={placeholder}
      class="form-input !rounded-l-none !rounded-r-full flex-1 border-l-0 bg-white dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 text-zinc-900 dark:text-white focus:ring-primary focus:border-primary transition-colors"
      dir="ltr"
    />
  </div>
</div>
