---
import Button from "./Button.astro";
import { useTranslations } from "~/i18n/utils";
import { siteConfig } from "~/site.config";

interface Props {
  title: string;
  price: number;
  category: string;
  city: string;
  image: string;
  sellerPhone: string;
  slug: string;
  lang: string;
  currency?: string;
  description?: string;
}

const {
  title,
  price,
  category,
  city,
  image,
  sellerPhone,
  slug,
  lang,
  currency = "SAR",
  description = "",
} = Astro.props;
const t = useTranslations(lang);

const currencySymbolMap: Record<string, string> = {
  SAR: "﷼",
  USD: "$",
  EUR: "€",
};
const normalizedCurrency = String(currency).toUpperCase();
const currencySymbol =
  currencySymbolMap[normalizedCurrency] || normalizedCurrency;
const formattedAmount = new Intl.NumberFormat(lang, {
  maximumFractionDigits: 0,
}).format(price);

const formattedPrice = t["ads.card.price.format"]
  .replace("{price}", formattedAmount)
  .replace("{symbol}", currencySymbol);

// Helper for whatsapp link targeting Chatbot
const adIdMatch = slug.match(/-(\d+)$/);
const rawId = adIdMatch ? adIdMatch[1] : slug;
const shortId = (typeof rawId === 'string' && rawId.includes('-')) ? rawId.split('-')[0].toUpperCase() : String(rawId).slice(0, 8).toUpperCase();
const whatsappBotNumber = siteConfig.chatbot.phoneNumber;
const whatsappText = t["ad.whatsapp.msg"].replace("{id}", shortId);
const whatsappUrl = `https://wa.me/${whatsappBotNumber}?text=${encodeURIComponent(whatsappText)}`;

const hasValidImage =
  image &&
  image.trim() !== "" &&
  image !== "/" &&
  image !== "undefined" &&
  image !== "null";
const displayImage = hasValidImage
  ? image.startsWith("http")
    ? image
    : image.startsWith("/")
      ? image
      : `/${image}`
  : "/og-image.webp";
---

<div
  class="group relative overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/60 p-4 shadow-xs backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-zinc-300/80 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/60 dark:hover:border-zinc-700/80 dark:hover:shadow-2xl flex flex-col h-full justify-between"
>
  <!-- Image Container -->
  <div
    class="relative aspect-video w-full overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800"
  >
    <img
      src={displayImage}
      alt={title}
      class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      onerror="this.src='/og-image.webp'; this.onerror=null;"
    />
    <div
      class="absolute top-3 left-3 rounded-full bg-black/60 px-3 py-1 text-xs font-semibold text-white backdrop-blur-xs"
    >
      {category}
    </div>
    <div
      class="absolute bottom-3 right-3 rounded-full bg-primary/95 px-3.5 py-1 text-sm font-bold text-white shadow-md backdrop-blur-xs"
    >
      {formattedPrice}
    </div>
  </div>

  <!-- Details Content -->
  <div class="mt-4 flex flex-col justify-between flex-1">
    <div class="space-y-1.5 mb-4">
      <span
        class="text-[10px] font-extrabold uppercase tracking-wider text-primary/80 dark:text-primary/95 block"
      >
        {category}
      </span>
      <h3
        class="line-clamp-1 font-display text-lg font-bold text-zinc-900 transition-colors group-hover:text-primary dark:text-zinc-50"
      >
        <a href={slug}>
          {title}
        </a>
      </h3>
      {
        description && (
          <p class="line-clamp-3 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
            {description}
          </p>
        )
      }
      <p class="text-[10px] font-semibold text-zinc-400 dark:text-zinc-500">
        {city}
      </p>
    </div>

    <!-- Actions -->
    <div class="mt-4 flex items-center gap-2">
      <Button
        href={slug}
        variant="outline"
        class="flex-1 rounded-full py-2.5 text-xs font-semibold border-zinc-200/60 hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-800"
      >
        {t["ads.card.details"]}
      </Button>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-shrink-0 flex h-10 w-10 items-center justify-center rounded-full bg-emerald-500 text-white shadow-md transition-all hover:bg-emerald-600 hover:scale-105 active:scale-95"
        title={t["ads.card.whatsapp.title"]}
      >
        <!-- WhatsApp official icon -->
        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5 flex-shrink-0"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</div>
