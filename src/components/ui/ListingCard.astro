---
import { getLangFromUrl } from "~/i18n/utils";
import { MapPin, Clock } from "lucide-react";

interface Props {
  listing: {
    name: string;
    title: string;
    price?: number;
    city?: string;
    cover_image?: string;
    creation?: string;
  };
}

const { listing } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const url = `/${lang}/listings/${listing.name}`;

// Format date relative (e.g. 2 days ago)
const timeAgo = listing.creation ? new Date(listing.creation).toLocaleDateString(lang === 'ar' ? 'ar-SA' : 'en-US', { 
  year: 'numeric', month: 'short', day: 'numeric' 
}) : '';
---

<a href={url} class="group flex flex-col bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:border-primary-500 hover:shadow-xl transition-all duration-300">
  <div class="relative aspect-[4/3] bg-slate-100 dark:bg-slate-900 overflow-hidden">
    {listing.cover_image ? (
      <img 
        src={listing.cover_image} 
        alt={listing.title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-slate-400">
        لا توجد صورة
      </div>
    )}
  </div>
  
  <div class="p-5 flex flex-col flex-grow">
    <h3 class="font-bold text-lg text-slate-900 dark:text-white line-clamp-2 mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
      {listing.title}
    </h3>
    
    <div class="mt-auto pt-4 flex items-center justify-between border-t border-slate-100 dark:border-slate-700/50">
      <div class="font-bold text-lg text-emerald-600 dark:text-emerald-400">
        {listing.price ? `${listing.price} ريال` : 'غير محدد'}
      </div>
    </div>
    
    <div class="mt-3 flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
      {listing.city && (
        <div class="flex items-center gap-1.5">
          <MapPin size={14} />
          <span>{listing.city}</span>
        </div>
      )}
      {timeAgo && (
        <div class="flex items-center gap-1.5">
          <Clock size={14} />
          <span>{timeAgo}</span>
        </div>
      )}
    </div>
  </div>
</a>
