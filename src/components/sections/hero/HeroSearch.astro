---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { Search, MapPin } from "lucide-react";

interface Props {
  title?: string;
  subtitle?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { 
  title = t['hero.title'] || "اعثر على ما تبحث عنه", 
  subtitle = t['hero.subtitle'] || "تصفح آلاف الإعلانات المبوبة في منطقتك"
} = Astro.props;

const suggestedSearches = [
  "ايفون 15", "سيارات تويوتا", "شقق للايجار", "لابتوب", "وظائف"
];
---

<section class="relative bg-gradient-to-br from-primary-900 to-slate-900 overflow-hidden py-24 sm:py-32">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
      <defs>
        <pattern id="grid" width="8" height="8" patternUnits="userSpaceOnUse">
          <path d="M 8 0 L 0 0 0 8" fill="none" stroke="currentColor" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100" height="100" fill="url(#grid)"/>
    </svg>
  </div>

  <div class="relative max-w-5xl mx-auto px-6 text-center z-10">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight mb-6 leading-tight">
      {title}
    </h1>
    <p class="text-lg md:text-xl text-primary-100 mb-10 max-w-2xl mx-auto font-medium">
      {subtitle}
    </p>

    <!-- Search Form -->
    <form action={`/${lang}/listings`} method="GET" class="max-w-3xl mx-auto bg-white rounded-2xl p-2 shadow-2xl flex flex-col md:flex-row gap-2">
      <div class="flex-1 flex items-center bg-slate-50 rounded-xl px-4 py-3 md:py-4 border border-transparent focus-within:border-primary-500 focus-within:bg-white transition-all">
        <Search className="w-5 h-5 text-slate-400 shrink-0 me-3" />
        <input 
          type="text" 
          name="q"
          placeholder={t['search.placeholder'] || "عن ماذا تبحث؟"} 
          class="bg-transparent border-none outline-none w-full text-slate-900 placeholder:text-slate-400 font-medium"
        />
      </div>
      
      <div class="flex-1 md:max-w-[200px] flex items-center bg-slate-50 rounded-xl px-4 py-3 md:py-4 border border-transparent focus-within:border-primary-500 focus-within:bg-white transition-all">
        <MapPin className="w-5 h-5 text-slate-400 shrink-0 me-3" />
        <select name="city" class="bg-transparent border-none outline-none w-full text-slate-900 font-medium appearance-none cursor-pointer">
          <option value="">كل المدن</option>
          <option value="الرياض">الرياض</option>
          <option value="جدة">جدة</option>
          <option value="الدمام">الدمام</option>
        </select>
      </div>

      <button type="submit" class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-3 md:py-4 rounded-xl font-bold transition-colors shadow-lg shadow-primary-600/30 whitespace-nowrap">
        {t['search.button'] || "بحث"}
      </button>
    </form>

    <!-- Suggested Searches -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <span class="text-primary-100/80 text-sm font-medium me-2">اقتراحات:</span>
      {suggestedSearches.map(term => (
        <a href={`/${lang}/listings?q=${encodeURIComponent(term)}`} class="px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white text-sm font-medium backdrop-blur-sm border border-white/10 transition-all">
          {term}
        </a>
      ))}
    </div>
  </div>
</section>
