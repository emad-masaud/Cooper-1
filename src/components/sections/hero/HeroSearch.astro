---
import { getLangFromUrl, useTranslations } from '~/i18n/utils';
import Button from '~/components/ui/Button.astro';
import Badge from '~/components/ui/Badge.astro';
import { Search, MapPin } from 'lucide-react';
import type { HeroCta } from './types';

interface Props {
  badge?: string;
  title?: string;
  highlight?: string;
  description?: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { badge, title, highlight, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
  <div class="absolute inset-0 bg-grid-white/[0.02] bg-[size:3rem_3rem]"></div>
  
  <div class="container relative z-10 px-4 mx-auto max-w-5xl text-center">
    {badge && (
      <Badge variant="outline" class="mb-8 animate-fade-in inline-flex">
        {badge}
      </Badge>
    )}
    
    <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-8 animate-fade-up">
      {title} <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-foreground/50">{highlight}</span>
    </h1>
    
    <p class="text-lg md:text-xl text-muted-foreground mb-12 max-w-2xl mx-auto animate-fade-up [animation-delay:200ms]">
      {description}
    </p>
    
    <div class="max-w-3xl mx-auto bg-background/50 backdrop-blur-xl border border-white/10 rounded-2xl p-4 shadow-2xl animate-fade-up [animation-delay:400ms]">
      <form class="flex flex-col md:flex-row gap-4" action={`/${lang}/listings`} method="get">
        <div class="flex-1 relative">
          <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none text-muted-foreground">
            <Search className="w-5 h-5" />
          </div>
          <input type="text" name="q" class="block w-full p-4 ps-12 text-sm text-foreground bg-background border border-white/10 rounded-xl focus:ring-primary focus:border-primary focus:outline-none" placeholder={t['search.placeholder']} required />
        </div>
        
        <div class="md:w-1/3 relative">
          <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none text-muted-foreground">
            <MapPin className="w-5 h-5" />
          </div>
          <select name="city" class="block w-full p-4 ps-12 text-sm text-foreground bg-background border border-white/10 rounded-xl focus:ring-primary focus:border-primary focus:outline-none appearance-none cursor-pointer">
            <option value="">All Cities</option>
            <option value="Riyadh">Riyadh</option>
            <option value="Jeddah">Jeddah</option>
            <option value="Dammam">Dammam</option>
            <option value="Dubai">Dubai</option>
          </select>
        </div>
        
        <Button type="submit" size="lg" class="w-full md:w-auto h-[54px] rounded-xl text-base px-8">
          {primaryCta?.text || 'Search'}
        </Button>
      </form>
    </div>
    
    {secondaryCta && (
      <div class="mt-8 animate-fade-up [animation-delay:600ms]">
        <Button variant="outline" href={secondaryCta.href}>
          {secondaryCta.text}
        </Button>
      </div>
    )}
  </div>
</section>
