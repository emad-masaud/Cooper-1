---
import { useTranslations } from '~/i18n/utils';
import { defaultLang } from '~/i18n/ui';
import AdCard from '~/components/ui/AdCard.astro';

interface Props {
  ads: any[];
  lang?: string;
}

const { ads = [], lang = defaultLang } = Astro.props as Props;
const t = useTranslations(lang);
---

{ads.length > 0 && (
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold">{t['latest.title']}</h2>
        </div>
        <a href={`/${lang}/ads`} class="text-sm text-primary hover:underline">
          {t['latest.view_all']}
        </a>
      </div>
      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 pt-2 pb-2 px-1">
        {ads.slice(0, 8).map((ad) => (
          <AdCard
            title={ad.title?.rendered ?? ''}
            price={ad.meta?.price ?? 0}
            currency={ad.meta?.currency || 'SAR'}
            category={ad.meta?.category ?? ''}
            city={ad.meta?.city ?? ''}
            image={ad.featured_image_url ?? ''}
            sellerPhone={ad.meta?.phone ?? ''}
            slug={ad.slug}
            lang={lang}
          />
        ))}
      </div>
    </div>
  </section>
)}