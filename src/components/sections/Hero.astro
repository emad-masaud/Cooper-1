---
import { defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';

import HeroChatAssistant from '~/components/react/HeroChatAssistant';
import { getPopularLinks } from '~/utils/popularLinks';

interface Props {
  badge?: string;
  title?: string;
  highlight?: string;
  description?: string;
  primaryCta?: { text: string; href: string };
  secondaryCta?: { text: string; href: string };
  lang?: string;
}

const { lang = defaultLang } = Astro.props as Props;
const t = useTranslations(lang);
const popularLinks = await getPopularLinks(lang);

const {
  badge = t['hero.badge'],
  title = t['hero.title'],
  highlight = t['hero.highlight'],
  description = t['hero.subtitle'],
  primaryCta = { text: t['hero.getStarted'], href: "/docs/knowledge-center/overview" },
  secondaryCta = { text: t['hero.learnMore'], href: "/docs/knowledge-center/overview" }
} = Astro.props;
---

<section class="min-h-[90vh] flex items-center justify-center relative overflow-hidden pt-20 bg-background">
  <div class="absolute inset-0 z-0 opacity-40">
     <div class="absolute top-[20%] left-[20%] w-[500px] h-[500px] bg-blue-900/40 rounded-full blur-[128px] animate-pulse"></div>
     <div class="absolute bottom-[20%] right-[20%] w-[500px] h-[500px] bg-indigo-900/40 rounded-full blur-[128px] animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 text-center">
    <div class="hero-content opacity-0 translate-y-5">

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-medium tracking-tight mb-8 text-foreground">
        {lang === 'ar' ? 'كيف أقدر أساعدك اليوم؟' : "What's the vibe today?"}
      </h1>

      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <HeroChatAssistant client:idle lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-content {
    animation: fadeUp 0.8s ease-out forwards;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
