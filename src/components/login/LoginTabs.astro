---
const { t } = Astro.props;
---
<div class="rounded-3xl border border-zinc-200/50 bg-white/60 p-8 shadow-xl backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/60 overflow-hidden shadow-zinc-200/50 dark:shadow-none">
  <div class="flex border-b border-zinc-100 dark:border-zinc-800/80 -mx-8 -mt-8 mb-6" role="tablist" aria-label="Login tabs">
    <button
      type="button"
      id="login-tab-btn"
      class="flex-1 py-4 text-center font-bold text-sm transition-all border-b-2 border-primary text-primary dark:text-white"
      data-tab="login"
      role="tab"
      aria-controls="login-panel"
      aria-selected="true"
    >
      {t['login.tab.signin']}
    </button>
    <button
      type="button"
      id="register-tab-btn"
      class="flex-1 py-4 text-center font-bold text-sm transition-all border-b-2 border-transparent text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300"
      data-tab="register"
      role="tab"
      aria-controls="register-panel"
      aria-selected="false"
    >
      {t['login.tab.register']}
    </button>
  </div>

  <div id="login-panel" class="space-y-6 text-center" role="tabpanel" aria-labelledby="login-tab-btn">
    <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">{t['login.signin.desc']}</p>
    <a
      href="/api/auth/google"
      class="flex items-center justify-center gap-3 w-full rounded-full border border-zinc-200 bg-white hover:bg-zinc-50 py-3.5 text-sm font-bold text-zinc-700 shadow-sm transition hover:scale-[1.01] active:scale-[0.99] dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-200 dark:hover:bg-zinc-900"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5 flex-shrink-0" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
      </svg>
      <span>{t['login.google.btn']}</span>
    </a>
  </div>

  <div id="register-panel" class="space-y-6 text-center hidden" role="tabpanel" aria-labelledby="register-tab-btn" hidden>
    <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">{t['login.register.desc']}</p>
    <a
      href="/api/auth/google"
      class="flex items-center justify-center gap-3 w-full rounded-full border border-zinc-200 bg-white hover:bg-zinc-50 py-3.5 text-sm font-bold text-zinc-700 shadow-sm transition hover:scale-[1.01] active:scale-[0.99] dark:border-zinc-800 dark:bg-zinc-950 dark:text-zinc-200 dark:hover:bg-zinc-900"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5 flex-shrink-0" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
      </svg>
      <span>{t['login.google.register']}</span>
    </a>
  </div>
</div>

<script is:inline>
  function initLoginTabs() {
    const loginTabBtn = document.getElementById('login-tab-btn');
    const registerTabBtn = document.getElementById('register-tab-btn');
    const loginPanel = document.getElementById('login-panel');
    const registerPanel = document.getElementById('register-panel');

    if (!loginTabBtn || !registerTabBtn || !loginPanel || !registerPanel) return;

    function switchTab(activeTab) {
      const isLogin = activeTab === 'login';

      loginTabBtn.classList.toggle('border-primary', isLogin);
      loginTabBtn.classList.toggle('text-primary', isLogin);
      loginTabBtn.classList.toggle('dark:text-white', isLogin);
      loginTabBtn.classList.toggle('border-transparent', !isLogin);
      loginTabBtn.classList.toggle('text-zinc-400', !isLogin);

      registerTabBtn.classList.toggle('border-primary', !isLogin);
      registerTabBtn.classList.toggle('text-primary', !isLogin);
      registerTabBtn.classList.toggle('dark:text-white', !isLogin);
      registerTabBtn.classList.toggle('border-transparent', isLogin);
      registerTabBtn.classList.toggle('text-zinc-400', isLogin);

      loginPanel.classList.toggle('hidden', !isLogin);
      loginPanel.removeAttribute('hidden');
      registerPanel.classList.toggle('hidden', isLogin);
      registerPanel.toggleAttribute('hidden', isLogin);

      loginTabBtn.setAttribute('aria-selected', String(isLogin));
      registerTabBtn.setAttribute('aria-selected', String(!isLogin));
    }

    loginTabBtn.addEventListener('click', () => switchTab('login'));
    registerTabBtn.addEventListener('click', () => switchTab('register'));

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('mode') === 'register' || window.location.hash === '#register') {
      switchTab('register');
    }

    const redirectParam = urlParams.get('redirect');
    if (redirectParam) {
      document.querySelectorAll('a[href="/api/auth/google"]').forEach((link) => {
        link.setAttribute('href', `/api/auth/google?redirect=${encodeURIComponent(redirectParam)}`);
      });
    }
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', initLoginTabs);
    } else {
      initLoginTabs();
    }
  }
</script>
