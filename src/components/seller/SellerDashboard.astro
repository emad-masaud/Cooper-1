---
import Container from "~/components/ui/Container.astro";
import PageHeader from "~/components/layout/PageHeader.astro";
import Button from "~/components/ui/Button.astro";
import {
  LogOut,
  LayoutGrid,
  Edit,
  Trash2,
  ShieldCheck,
  Clock,
  CheckCircle,
  Award,
  Sparkles,
  Bot,
  Copy,
  Check,
} from "lucide-react";
import { useTranslations } from "~/i18n/utils";
import SellerProducts from "./SellerProducts.astro";
import SellerSubNav from "./SellerSubNav.astro";
import { getMeamartSession } from "~/utils/session";
import { kvGet } from "~/utils/kv";
import { createSupabaseAdminServerClient } from "~/utils/supabase";

interface Props {
  lang: string;
  rtl: boolean;
  sellerName?: string;
  sellerEmail?: string;
  sellerPhone?: string;
  needsPhoneVerification?: boolean;
  sellerAds?: any[];
  sellerProducts?: any[];
  sellerAddresses?: any[];
}

let {
  lang,
  rtl,
  sellerName = "",
  sellerEmail = "",
  sellerPhone = "",
  needsPhoneVerification = false,
  sellerAds,
  sellerProducts = [],
  sellerAddresses = [],
} = Astro.props;

const session = await getMeamartSession(Astro);

// If data is not provided, fetch it internally (Astro Server Island execution)
if (!sellerAds) {
  if (session) {
    sellerName = session.name || "";
    sellerEmail = session.email || "";
    sellerPhone = session.phone || "";
    needsPhoneVerification = !sellerPhone;
    const cleanSellerPhone = sellerPhone.replace(/[^0-9]/g, "");

    const supabase = createSupabaseAdminServerClient(Astro);

    // 1. Fetch Ads
    try {
      const { data: adsData } = await supabase
        .from("ads")
        .select("*")
        .eq("user_id", session.id)
        .order("created_at", { ascending: false });
      sellerAds = (adsData || []).map((ad) => ({
        ...ad,
        image:
          ad.image ||
          (Array.isArray(ad.images) && ad.images.length > 0
            ? ad.images[0]
            : null),
        computedStatus: ad.status || "active",
      }));
    } catch (e) {
      console.error("[SellerDashboard Island] Error fetching ads:", e);
      sellerAds = [];
    }

    // 2. Fetch Products
    try {
      const { data: prodsData } = await supabase
        .from("products")
        .select("*")
        .eq("seller_id", session.id)
        .order("created_at", { ascending: false });
      sellerProducts = prodsData || [];
    } catch (e) {
      console.error("[SellerDashboard Island] Error fetching products:", e);
      sellerProducts = [];
    }

    // 3. Fetch Saved Addresses from KV
    try {
      const userId = session.id || session.email;
      const kvKey = `seller_addresses_${userId}`;
      const dataStr = await kvGet(Astro, kvKey);
      if (dataStr) {
        sellerAddresses = JSON.parse(dataStr);
      }
    } catch (e) {
      console.error("[SellerDashboard Island] Error fetching addresses:", e);
      sellerAddresses = [];
    }
  } else {
    sellerAds = [];
    sellerProducts = [];
    sellerAddresses = [];
  }
}

const t = useTranslations(lang);
const deleteConfirm = String(t["seller.dashboard.deleteConfirm"] || "");
const deleteLoading = String(t["seller.dashboard.deleteLoading"] || "");
const deleteFailed = String(t["seller.dashboard.deleteFailed"] || "");
const pageTitle = String(t["seller.dashboard.page.title"] || "");
const pageDesc = String(t["seller.dashboard.page.desc"] || "");
const headerTitle = String(t["seller.dashboard.header.title"] || "");
const headerSubtitleTemplate = String(
  t["seller.dashboard.header.subtitle"] || "",
);
const headerSubtitle = headerSubtitleTemplate.replace(
  "{name}",
  sellerName || "",
);

const activeAdsCount = sellerAds.filter(
  (ad: any) => ad.computedStatus === "active",
).length;
const expiredAdsCount = sellerAds.filter(
  (ad: any) => ad.computedStatus === "expired",
).length;
const featuredAdsCount = sellerAds.filter((ad: any) => ad.featured).length;

const formatPrice = (price: number, currency: string = "SAR") => {
  const normalizedCurrency = String(currency).toUpperCase();
  const currencySymbolMap: Record<string, string> = {
    SAR: "﷼",
    USD: "$",
    EUR: "€",
  };
  const currencySymbol =
    currencySymbolMap[normalizedCurrency] || normalizedCurrency;
  const formattedAmount = new Intl.NumberFormat(
    lang === "ar" ? "ar-SA" : "en-US",
    {
      maximumFractionDigits: 0,
    },
  ).format(price);
  return lang === "ar"
    ? `${formattedAmount} ${currencySymbol}`
    : `${currencySymbol} ${formattedAmount}`;
};
---

<PageHeader title={headerTitle} description={headerSubtitle} />

{
  needsPhoneVerification ? (
    <div class="max-w-7xl mx-auto mb-6">
      <div class="rounded-2x1 border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/30 dark:bg-amber-900/10">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="font-semibold">{t["seller.dashboard.header.verified"]}</p>
            <p class="text-xs text-amber-700/80 mt-1">
              {t["seller.dashboard.phoneWarning.body"]}
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <a
              href="/api/auth/logout"
              class="px-3 py-2 rounded-md text-sm font-semibold text-amber-800 bg-amber-100 hover:bg-amber-200"
            >
              {t["seller.dashboard.actions.logout"]}
            </a>
            <a
              href={`/${lang}/ads/create`}
              class="px-3 py-2 rounded-md text-sm font-semibold bg-primary text-white hover:bg-primary/90"
            >
              {t["seller.dashboard.actions.create"]}
            </a>
          </div>
        </div>
      </div>
    </div>
  ) : null
}

<Container class="pb-20">
  <div
    class="mb-8 flex flex-col items-center justify-between gap-6 rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40 md:flex-row"
  >
    <div class="flex items-center gap-4">
      <div
        class="h-16 w-16 rounded-full overflow-hidden bg-primary/10 shadow-md shrink-0 flex items-center justify-center"
        id="dashboard-avatar-container"
      >
        <div
          class="text-2xl font-bold text-primary"
          id="dashboard-avatar-initials"
        >
          {sellerName.charAt(0).toUpperCase()}
        </div>
      </div>

      <div
        class={`space-y-1 ${rtl ? "text-center md:text-end" : "text-center md:text-start"}`}
      >
        <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">
          {sellerName}
        </h3>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          {t["seller.dashboard.header.verified"]}
          {sellerPhone}
        </p>
        {
          sellerEmail && (
            <p class="text-xs text-zinc-400 dark:text-zinc-500">
              {sellerEmail}
            </p>
          )
        }
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-end">
      <Button
        href={session?.username
          ? `/${lang}/@${session.username}`
          : `/${lang}/seller/${session?.id || "profile"}`}
        variant="outline"
        class="flex-1 sm:flex-initial rounded-full px-4 py-2.5 text-xs font-bold border-zinc-200 dark:border-zinc-800 text-emerald-600 border-emerald-500/30 hover:bg-emerald-50 dark:hover:bg-emerald-900/20"
      >
        {t["seller.dashboard.nav.storePage"] || "Store Page"}
      </Button>
      <Button
        href={`/${lang}/seller/qr-manager`}
        variant="outline"
        class="flex-1 sm:flex-initial rounded-full px-4 py-2.5 text-xs font-bold border-zinc-200 dark:border-zinc-800 text-primary border-primary/30 hover:bg-primary/5"
      >
        {t["seller.subnav.qr"]}
      </Button>
      <Button
        href={`/${lang}/seller/profile`}
        variant="outline"
        class="flex-1 sm:flex-initial rounded-full px-4 py-2.5 text-xs font-bold border-zinc-200 dark:border-zinc-800 text-violet-600 border-violet-500/30 hover:bg-violet-50 dark:hover:bg-violet-900/20"
      >
        {t["seller.dashboard.nav.storeSettings"] || "Store Settings"}
      </Button>

      <Button
        href={`/${lang}/ads/create`}
        class="flex-1 sm:flex-initial rounded-full px-5 py-2.5 text-xs font-bold shadow-md shadow-primary/10"
      >
        {t["seller.dashboard.actions.create"]}
      </Button>

      <a
        href="/api/auth/logout"
        class="flex items-center justify-center gap-1.5 rounded-full border border-red-200 px-4 py-2.5 text-xs font-bold text-red-600 transition hover:bg-red-50 dark:border-red-900/30 dark:hover:bg-red-950/20 shrink-0"
      >
        <LogOut class="h-4 w-4" />
        <span>{t["seller.dashboard.actions.logout"]}</span>
      </a>
    </div>
  </div>
</Container>
<div class="max-w-7xl mx-auto grid grid-cols-1 gap-4 sm:grid-cols-3 mb-8">
  <div
    class="group relative overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md transition-all duration-300 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/40"
  >
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    >
    </div>
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
          {t["seller.dashboard.stats.active"]}
        </p>
        <h4
          class="mt-2 text-3xl font-extrabold text-zinc-900 dark:text-zinc-50"
        >
          {activeAdsCount}
        </h4>
      </div>
      <div
        class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
      >
        <CheckCircle class="h-6 w-6" />
      </div>
    </div>
  </div>

  <div
    class="group relative overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md transition-all duration-300 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/40"
  >
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-zinc-500/5 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    >
    </div>
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
          {t["seller.dashboard.stats.expired"]}
        </p>
        <h4
          class="mt-2 text-3xl font-extrabold text-zinc-900 dark:text-zinc-50"
        >
          {expiredAdsCount}
        </h4>
      </div>
      <div
        class="flex h-12 w-12 items-center justify-center rounded-full bg-zinc-500/10 text-zinc-600 dark:text-zinc-400"
      >
        <Clock class="h-6 w-6" />
      </div>
    </div>
  </div>

  <div
    class="group relative overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/40 p-6 backdrop-blur-md transition-all duration-300 hover:shadow-lg dark:border-zinc-800/50 dark:bg-zinc-900/40"
  >
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-amber-500/5 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    >
    </div>
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-400">
          {t["seller.dashboard.stats.featured"]}
        </p>
        <h4
          class="mt-2 text-3xl font-extrabold text-zinc-900 dark:text-zinc-50"
        >
          {featuredAdsCount}
        </h4>
      </div>
      <div
        class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400"
      >
        <Award class="h-6 w-6" />
      </div>
    </div>
  </div>
</div>

<SellerSubNav
  lang={lang}
  activeTab="ads"
  adsCount={sellerAds.length}
  productsCount={sellerProducts.length}
  addressesCount={sellerAddresses.length}
/>

<div id="section-ads" class="max-w-7xl mx-auto mt-32 space-y-6">
  <div
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-zinc-200/60 pb-4 dark:border-zinc-800/60"
  >
    <h2
      class="flex items-center gap-2 text-xl font-bold text-zinc-900 dark:text-zinc-50"
    >
      <LayoutGrid class="h-5 w-5 text-primary" />
      <span>{t["seller.dashboard.grid.title"]}</span>
    </h2>

    <div class="flex flex-wrap gap-2">
      <button
        type="button"
        data-filter="all"
        class="tab-btn active-tab flex items-center gap-1.5 rounded-full bg-primary text-white shadow-sm px-4 py-2 text-xs font-bold transition-all duration-200"
      >
        <span>{t["seller.dashboard.tabs.all"]}</span>
        <span
          class="inline-flex h-5 items-center justify-center rounded-full bg-white/20 px-2 text-[10px] text-white"
          >{sellerAds.length}</span
        >
      </button>

      <button
        type="button"
        data-filter="active"
        class="tab-btn inactive-tab flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white/40 text-zinc-600 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40 dark:text-zinc-400 dark:hover:bg-zinc-800/60 px-4 py-2 text-xs font-bold transition-all duration-200"
      >
        <span>{t["seller.dashboard.tabs.active"]}</span>
        <span
          class="inline-flex h-5 items-center justify-center rounded-full bg-zinc-100 px-2 text-[10px] text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"
          >{activeAdsCount}</span
        >
      </button>

      <button
        type="button"
        data-filter="expired"
        class="tab-btn inactive-tab flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white/40 text-zinc-600 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40 dark:text-zinc-400 dark:hover:bg-zinc-800/60 px-4 py-2 text-xs font-bold transition-all duration-200"
      >
        <span>{t["seller.dashboard.tabs.expired"]}</span>
        <span
          class="inline-flex h-5 items-center justify-center rounded-full bg-zinc-100 px-2 text-[10px] text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"
          >{expiredAdsCount}</span
        >
      </button>

      <button
        type="button"
        data-filter="featured"
        class="tab-btn inactive-tab flex items-center gap-1.5 rounded-full border border-zinc-200 bg-white/40 text-zinc-600 hover:bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-900/40 dark:text-zinc-400 dark:hover:bg-zinc-800/60 px-4 py-2 text-xs font-bold transition-all duration-200"
      >
        <span>{t["seller.dashboard.tabs.featured"]}</span>
        <span
          class="inline-flex h-5 items-center justify-center rounded-full bg-zinc-100 px-2 text-[10px] text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"
          >{featuredAdsCount}</span
        >
      </button>
    </div>
  </div>

  {
    sellerAds.length === 0 ? (
      <div
        id="empty-state-container"
        class="rounded-3xl border border-dashed border-zinc-200 bg-zinc-50 py-20 text-center dark:border-zinc-800 dark:bg-zinc-900/20 mb-8"
      >
        <div class="flex justify-center mb-4">
          <LayoutGrid class="h-12 w-12 text-zinc-400" />
        </div>
        <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">
          {t["seller.dashboard.grid.empty.title"]}
        </h3>
        <p class="mt-2 text-sm text-zinc-500">
          {t["seller.dashboard.grid.empty.desc"]}
        </p>
        <Button
          href={`/${lang}/ads/create`}
          class="mt-6 rounded-full px-6 py-2.5 text-xs font-bold text-white hover:text-white dark:text-white dark:hover:text-white"
        >
          {t["seller.dashboard.grid.empty.cta"]}
        </Button>
      </div>
    ) : (
      <div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          {sellerAds.map((ad) => (
            <div
              class="ad-card relative flex flex-col gap-4 overflow-hidden rounded-3xl border border-zinc-200/50 bg-white/40 p-4 backdrop-blur-md dark:border-zinc-800/50 dark:bg-zinc-900/40 sm:flex-row mb-6"
              id={`ad-card-${ad.id}`}
              data-status={ad.computedStatus}
              data-featured={String(ad.featured)}
            >
              <div class="Verifyh-24 w-full shrink-0 overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800 sm:w-32">
                {ad.image ||
                (Array.isArray(ad.images) && ad.images.length > 0
                  ? ad.images[0]
                  : null) ? (
                  <img
                    src={
                      (
                        ad.image ||
                        (Array.isArray(ad.images) ? ad.images[0] : "")
                      ).startsWith("http")
                        ? ad.image ||
                          (Array.isArray(ad.images) ? ad.images[0] : "")
                        : `/${ad.image || (Array.isArray(ad.images) ? ad.images[0] : "")}`
                    }
                    alt={ad.title}
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-zinc-200 dark:bg-zinc-700">
                    <LayoutGrid class="h-8 w-8 text-zinc-400" />
                  </div>
                )}
              </div>

              <div class="flex flex-1 flex-col justify-between space-y-3 py-1">
                <div class="space-y-1">
                  <div class="flex flex-wrap items-center gap-2">
                    {ad.featured && (
                      <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-bold text-amber-600 dark:bg-amber-900/30 dark:text-amber-400">
                        <ShieldCheck class="h-3 w-3" />
                        {t["seller.dashboard.badge.featured"]}
                      </span>
                    )}

                    {ad.computedStatus === "active" ? (
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-400">
                        <CheckCircle class="h-3 w-3" />
                        {t["seller.dashboard.badge.active"]}
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 rounded-full bg-zinc-50 px-2 py-0.5 text-[10px] font-bold text-zinc-500 dark:bg-zinc-800/50 dark:text-zinc-400">
                        <Clock class="h-3 w-3" />
                        {t["seller.dashboard.badge.expired"]}
                      </span>
                    )}
                  </div>

                  <h3 class="line-clamp-1 text-base font-bold text-zinc-900 dark:text-zinc-50">
                    <a
                      href={`/${lang}/ads/${ad.id}`}
                      class="transition hover:text-primary"
                    >
                      {ad.title}
                    </a>
                  </h3>

                  <p class="text-sm font-extrabold text-primary">
                    {formatPrice(ad.price, ad.currency)}
                  </p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                  {/* Edit Icon Button */}
                  <a
                    href={`/${lang}/ads/edit/${ad.id}`}
                    title={t["seller.dashboard.actions.edit"]}
                    class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-200 bg-zinc-50 text-zinc-600 hover:border-primary hover:text-primary dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-300 dark:hover:border-primary dark:hover:text-primary transition duration-200 cursor-pointer"
                  >
                    <Edit class="h-4 w-4" />
                  </a>

                  {/* Share Icon Button */}
                  <a
                    href={`/${lang}/ads/${ad.id}`}
                    title={t["seller.dashboard.action.share"] || "Share"}
                    class="flex h-9 w-9 items-center justify-center rounded-full border border-emerald-200/60 bg-emerald-50/50 text-emerald-600 hover:bg-emerald-100 hover:text-emerald-700 dark:border-emerald-900/40 dark:bg-emerald-950/30 dark:text-emerald-400 dark:hover:bg-emerald-900/40 transition duration-200 cursor-pointer"
                  >
                    <svg
                      class="h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                      />
                    </svg>
                  </a>

                  {/* Delete Icon Button */}
                  <button
                    type="button"
                    data-id={ad.id}
                    data-title={ad.title}
                    title={t["seller.dashboard.actions.delete"]}
                    class="delete-btn flex h-9 w-9 items-center justify-center rounded-full border border-red-100 bg-red-50/20 text-red-500 hover:bg-red-50 hover:text-red-600 dark:border-red-950/20 dark:text-red-400 dark:hover:bg-red-950/30 transition duration-200 cursor-pointer"
                  >
                    <Trash2 class="h-4 w-4" />
                  </button>

                  {ad.computedStatus === "active" && !ad.featured && (
                    <Button
                      href={`/${lang}/pricing`}
                      variant="outline"
                      class="flex items-center gap-1 border-amber-200 bg-amber-50/50 px-3 py-1.5 text-xs font-bold text-amber-700 hover:bg-amber-100 dark:border-amber-900/30 dark:bg-amber-950/20 dark:text-amber-400 dark:hover:bg-amber-900/30"
                    >
                      <Sparkles class="h-3.5 w-3.5 text-amber-500 animate-pulse" />
                      <span>{t["seller.dashboard.actions.promote"]}</span>
                    </Button>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
        <div
          id="empty-state-container"
          style="display: none;"
          class="mt-6 rounded-3xl border border-dashed border-zinc-200 bg-zinc-50 py-20 text-center dark:border-zinc-800 dark:bg-zinc-900/20 mb-8"
        >
          <div class="flex justify-center mb-4">
            <LayoutGrid class="h-12 w-12 text-zinc-400" />
          </div>
          <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-50">
            {t["seller.dashboard.grid.empty.title"]}
          </h3>
          <p class="mt-2 text-sm text-zinc-500">
            {t["seller.dashboard.grid.empty.desc"]}
          </p>
        </div>
      </div>
    )
  }
</div>

<!-- Custom Delete Confirm Modal -->
<div
  id="delete-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4 opacity-0 pointer-events-none transition-opacity duration-200"
>
  <div
    class="bg-white dark:bg-zinc-900 rounded-3xl p-6 w-full max-w-sm shadow-xl border border-zinc-200 dark:border-zinc-800 scale-95 transition-transform duration-200"
    id="delete-modal-content"
  >
    <div class="flex justify-center mb-4 text-red-500">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="lucide lucide-trash-2"
        ><path d="M3 6h18"></path><path
          d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path
          d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line
          x1="10"
          x2="10"
          y1="11"
          y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg
      >
    </div>
    <h3
      class="text-lg font-bold text-center text-zinc-900 dark:text-white mb-2"
    >
      {t["seller.dashboard.actions.delete"]}
    </h3>
    <p
      class="text-sm text-center text-zinc-500 dark:text-zinc-400 mb-6"
      id="delete-modal-text"
    >
    </p>
    <div class="flex gap-3">
      <button
        id="delete-modal-cancel"
        class="flex-1 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-300 font-bold hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
      >
        {t["common.cancel"] || "Cancel"}
      </button>
      <button
        id="delete-modal-confirm"
        class="flex-1 py-2.5 rounded-xl bg-red-500 text-white font-bold hover:bg-red-600 transition-colors flex justify-center items-center"
      >
        <span id="delete-confirm-text"
          >{t["seller.dashboard.action.deleteAd"] || "Delete Ad"}</span
        >
        <span
          id="delete-confirm-loader"
          class="hidden w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"
        ></span>
      </button>
    </div>
  </div>
</div>

<!-- Custom Alert Modal -->
<div
  id="alert-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4 opacity-0 pointer-events-none transition-opacity duration-200"
>
  <div
    class="bg-white dark:bg-zinc-900 rounded-3xl p-6 w-full max-w-sm shadow-xl border border-zinc-200 dark:border-zinc-800 scale-95 transition-transform duration-200"
    id="alert-modal-content"
  >
    <h3
      class="text-lg font-bold text-center text-zinc-900 dark:text-white mb-2"
      id="alert-modal-title"
    >
      {t["common.alert"] || "Alert"}
    </h3>
    <p
      class="text-sm text-center text-zinc-500 dark:text-zinc-400 mb-6"
      id="alert-modal-text"
    >
    </p>
    <button
      id="alert-modal-ok"
      class="w-full py-2.5 rounded-xl bg-primary text-white font-bold hover:bg-primary/90 transition-colors"
    >
      {t["common.ok"] || "OK"}
    </button>
  </div>
</div>

<script is:inline>
  // إذا كانت الـ session في URL param، احفظها كـ cookie ونظف الرابط
  (function () {
    const urlParams = new URLSearchParams(window.location.search);
    const sessionParam = urlParams.get("session");
    if (sessionParam) {
      try {
        const sessionData = JSON.parse(decodeURIComponent(sessionParam));
        const isSecure = location.protocol === "https:";
        const maxAge = 30 * 24 * 60 * 60; // 30 days
        const cookieStr = `meamart_session=${encodeURIComponent(JSON.stringify(sessionData))}; path=/; max-age=${maxAge}; SameSite=Lax${isSecure ? "; Secure" : ""}`;
        document.cookie = cookieStr;
        // نظف الرابط بدون reload
        const cleanUrl = window.location.pathname;
        window.history.replaceState({}, "", cleanUrl);
      } catch (e) {
        console.error("[Dashboard] Failed to save session cookie from URL:", e);
      }
    }
  })();
</script>

<script
  is:inline
  define:vars={{ lang, deleteConfirm, deleteLoading, deleteFailed }}
>
  function showAlert(message, title) {
    const modal = document.getElementById("alert-modal");
    const content = document.getElementById("alert-modal-content");
    document.getElementById("alert-modal-text").innerText = message;
    document.getElementById("alert-modal-title").innerText = title;

    modal.classList.remove("opacity-0", "pointer-events-none");
    content.classList.remove("scale-95");
    content.classList.add("scale-100");

    return new Promise((resolve) => {
      document.getElementById("alert-modal-ok").onclick = () => {
        modal.classList.add("opacity-0", "pointer-events-none");
        content.classList.remove("scale-100");
        content.classList.add("scale-95");
        resolve();
      };
    });
  }

  function showDeleteConfirm(title) {
    const modal = document.getElementById("delete-modal");
    const content = document.getElementById("delete-modal-content");
    document.getElementById("delete-modal-text").innerText =
      `${deleteConfirm}\n\n${title}`;

    modal.classList.remove("opacity-0", "pointer-events-none");
    content.classList.remove("scale-95");
    content.classList.add("scale-100");

    return new Promise((resolve) => {
      document.getElementById("delete-modal-cancel").onclick = () => {
        modal.classList.add("opacity-0", "pointer-events-none");
        content.classList.remove("scale-100");
        content.classList.add("scale-95");
        resolve(false);
      };
      document.getElementById("delete-modal-confirm").onclick = () => {
        // Do not close immediately, wait for processing
        resolve(true);
      };
    });
  }

  function closeDeleteConfirm() {
    const modal = document.getElementById("delete-modal");
    const content = document.getElementById("delete-modal-content");
    modal.classList.add("opacity-0", "pointer-events-none");
    content.classList.remove("scale-100");
    content.classList.add("scale-95");
  }

  async function deleteAd(wpId, title) {
    try {
      const res = await fetch("/api/delete-ad", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ postId: wpId }),
      });

      if (!res.ok) {
        let message = deleteFailed;
        try {
          const data = await res.json();
          if (data?.error) message = data.error;
        } catch {}
        throw new Error(message);
      }

      window.location.reload();
    } catch (err) {
      closeDeleteConfirm();
      showAlert(
        err instanceof Error ? err.message : deleteFailed,
        t["seller.dashboard.deleteFailed"] || "Deletion Failed",
      );
    }
  }

  function bindDeleteButtons() {
    document.querySelectorAll(".delete-btn").forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";

      btn.addEventListener("click", async () => {
        const wpId = Number(btn.dataset.wpid);
        const title = btn.dataset.title || "";
        if (!wpId) return;

        const confirmed = await showDeleteConfirm(title);
        if (!confirmed) return;

        const originalHtml = btn.innerHTML;
        btn.setAttribute("disabled", "disabled");
        btn.style.opacity = "0.7";
        btn.innerHTML = `<span>${deleteLoading}</span>`;

        const confirmBtn = document.getElementById("delete-modal-confirm");
        const confirmText = document.getElementById("delete-confirm-text");
        const confirmLoader = document.getElementById("delete-confirm-loader");

        confirmBtn.setAttribute("disabled", "disabled");
        confirmBtn.classList.add("opacity-70");
        confirmText.classList.add("hidden");
        confirmLoader.classList.remove("hidden");

        try {
          await deleteAd(wpId, title);
        } finally {
          btn.removeAttribute("disabled");
          btn.style.opacity = "1";
          btn.innerHTML = originalHtml;

          confirmBtn.removeAttribute("disabled");
          confirmBtn.classList.remove("opacity-70");
          confirmText.classList.remove("hidden");
          confirmLoader.classList.add("hidden");
        }
      });
    });
  }

  function initFilters() {
    const tabs = document.querySelectorAll(".tab-btn");
    const cards = document.querySelectorAll(".ad-card");
    const emptyState = document.getElementById("empty-state-container");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const filter = tab.dataset.filter;

        tabs.forEach((t) => {
          t.classList.remove(
            "active-tab",
            "bg-primary",
            "text-white",
            "shadow-sm",
          );
          t.classList.add(
            "inactive-tab",
            "border",
            "border-zinc-200",
            "bg-white/40",
            "text-zinc-600",
            "dark:border-zinc-800",
            "dark:bg-zinc-900/40",
            "dark:text-zinc-400",
            "dark:hover:bg-zinc-800/60",
          );
          const badge = t.querySelector(".inline-flex");
          if (badge) {
            badge.className =
              "inline-flex h-5 items-center justify-center rounded-full bg-zinc-100 px-2 text-[10px] text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400";
          }
        });

        tab.classList.remove(
          "inactive-tab",
          "border",
          "border-zinc-200",
          "bg-white/40",
          "text-zinc-600",
          "dark:border-zinc-800",
          "dark:bg-zinc-900/40",
          "dark:text-zinc-400",
          "dark:hover:bg-zinc-800/60",
        );
        tab.classList.add(
          "active-tab",
          "bg-primary",
          "text-white",
          "shadow-sm",
        );
        const activeBadge = tab.querySelector(".inline-flex");
        if (activeBadge) {
          activeBadge.className =
            "inline-flex h-5 items-center justify-center rounded-full bg-white/20 px-2 text-[10px] text-white";
        }

        let visibleCount = 0;
        cards.forEach((card) => {
          const status = card.dataset.status;
          const isFeatured = card.dataset.featured === "true";

          let show = false;
          if (filter === "all") {
            show = true;
          } else if (filter === "active") {
            show = status === "active";
          } else if (filter === "expired") {
            show = status === "expired";
          } else if (filter === "featured") {
            show = isFeatured;
          }

          if (show) {
            card.style.display = "";
            visibleCount++;
          } else {
            card.style.display = "none";
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.style.display = "";
          } else {
            emptyState.style.display = "none";
          }
        }
      });
    });
  }

  function loadDashboardAvatar() {
    try {
      const profileDataStr = localStorage.getItem("meamart_profile_data");
      if (profileDataStr) {
        const profile = JSON.parse(profileDataStr);
        if (profile.seller_avatar) {
          const container = document.getElementById(
            "dashboard-avatar-container",
          );
          if (container) {
            container.innerHTML = `<img src="${profile.seller_avatar}" alt="Avatar" class="h-full w-full object-cover" />`;
          }
        }
      }
    } catch (e) {
      console.error("Failed to load dynamic avatar:", e);
    }
  }

  bindDeleteButtons();
  initFilters();
  loadDashboardAvatar();

  document.addEventListener("astro:page-load", () => {
    bindDeleteButtons();
    initFilters();
    loadDashboardAvatar();
  });
</script>
